      "children": [
        "leftSidebarSlot",
        "rightWrapperFrame"
      ]
    },
    {
      "id": "leftSidebarSlot",
      "component": "div",
      "props": {
        "className": "w-60 h-screen flex flex-col bg-surface-container-highest shadow-sm overflow-hidden"
      },
      "children": [
        "sNavBrandHeader",
        "sNavHeaderDivider",
        "sNavMenuWrap"
      ]
    },
    {
      "id": "rightWrapperFrame",
      "component": "div",
      "props": {
        "className": "flex-1 flex flex-col h-screen overflow-hidden"
      },
      "children": [
        "topHeaderSlot",
        "mainContentSlot"
      ]
    },
    {
      "id": "topHeaderSlot",
      "component": "div",
      "props": {
        "className": "h-12 flex items-center justify-end px-page bg-surface-container-highest shadow-sm z-10"
      },
      "children": [
        "gHeadLangText",
        "gHeadDivider1",
        "gHeadBotIcon",
        "gHeadNotifBadge",
        "gHeadDivider2",
        "gHeadUserProfile"
      ]
    },
    {
      "id": "mainContentSlot",
      "component": "div",
      "props": {
        "className": "flex-1 overflow-y-auto p-page"
      },
      "children": [
        "mContInner"
      ]
    },
    {
      "id": "sNavBrandHeader",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between px-4 h-12 shrink-0"
      },
      "children": [
        "sNavBrandLogo",
        "sNavCollapseIcon"
      ]
    },
    {
      "id": "sNavBrandLogo",
      "component": "span",
      "props": {
        "className": "text-lg font-bold text-primary tracking-tight",
        "value": {
          "path": "/brandName"
        }
      }
    },
    {
      "id": "sNavCollapseIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/collapseIcon"
        },
        "color": "default",
        "shape": "outline",
        "className": "w-5 h-5 cursor-pointer"
      }
    },
    {
      "id": "sNavHeaderDivider",
      "component": "Divider",
      "props": {
        "className": "mx-0 my-0"
      }
    },
    {
      "id": "sNavMenuWrap",
      "component": "div",
      "props": {
        "className": "flex-1 overflow-y-auto"
      },
      "children": [
        "sNavMenu"
      ]
    },
    {
      "id": "sNavMenu",
      "component": "Menu",
      "props": {
        "mode": "vertical",
        "inlineCollapsed": false,
        "selectedKeys": {
          "path": "/selectedKeys"
        },
        "openKeys": {
          "path": "/openKeys"
        },
        "items": {
          "path": "/menuItems"
        },
        "className": "w-full border-none bg-transparent"
      }
    },
    {
      "id": "gHeadLangText",
      "component": "span",
      "props": {
        "className": "text-md font-medium text-on-surface-variant cursor-pointer hover:text-on-surface transition-colors px-2",
        "value": {
          "path": "/languageText"
        }
      }
    },
    {
      "id": "gHeadDivider1",
      "component": "div",
      "props": {
        "className": "w-px h-5 bg-divider mx-2"
      }
    },
    {
      "id": "gHeadBotIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/assistantIcon"
        },
        "color": "primary",
        "shape": "outline",
        "className": "w-5 h-5 cursor-pointer"
      }
    },
    {
      "id": "gHeadNotifBadge",
      "component": "Badge",
      "props": {
        "count": {
          "path": "/notificationCount"
        },
        "overflowCount": 99,
        "status": "error"
      },
      "children": [
        "gHeadNotifIcon"
      ]
    },
    {
      "id": "gHeadNotifIcon",
      "component": "Icon",
      "props": {
