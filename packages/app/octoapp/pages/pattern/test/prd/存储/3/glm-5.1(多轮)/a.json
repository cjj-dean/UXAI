      }
    },
    {
      "id": "gHeadDivider2",
      "component": "div",
      "props": {
        "className": "w-px h-5 bg-divider mx-3"
      }
    },
    {
      "id": "gHeadUserProfile",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 cursor-pointer rounded-lg px-2 py-1 hover:bg-surface-variant transition-colors"
      },
      "children": [
        "gHeadUserAvatar",
        "gHeadUserName",
        "gHeadUserChevron"
      ]
    },
    {
      "id": "gHeadUserAvatar",
      "component": "img",
      "props": {
        "src": {
