    "rootId": "mainAppShell",
    "elements": [
        {
            "id": "mainAppShell",
            "component": "div",
            "props": {
                "className": "flex h-screen w-full bg-surface-container-lowest overflow-hidden"
            },
            "children": [
                "sideNavContainer",
                "mainViewport"
            ]
        },
        {
            "id": "sideNavContainer",
            "component": "aside",
            "props": {
                "className": "w-[15.5rem] h-full bg-surface-container-highest shadow-sm z-20 flex flex-col"
            },
            "children": [
                "snLogoWrapper",
                "snMenuScrollArea"
            ]
        },
        {
            "id": "mainViewport",
            "component": "main",
            "props": {
                "className": "flex-1 flex flex-col relative overflow-hidden"
            },
            "children": [
                "headerActionContainer",
                "scrollableContentArea"
            ]
        },
        {
            "id": "headerActionContainer",
            "component": "header",
            "props": {
                "className": "absolute top-0 right-0 h-12 px-page flex items-center justify-end z-30 gap-gutter"
            },
            "children": [
                "thaLangDropdown",
                "thaNotificationBadge",
                "thaUserDropdown"
            ]
        },
        {
            "id": "scrollableContentArea",
            "component": "div",
            "props": {
                "className": "flex-1 overflow-y-auto p-page flex flex-col gap-section"
            },
            "children": [
                "contentHeaderContainer",
                "filterToolbarContainer",
                "storageGridContainer"
            ]
        },
        {
            "id": "contentHeaderContainer",
            "component": "section",
            "props": {
                "className": "flex flex-col gap-stack"
            },
            "children": [
                "chTitleWrapper",
                "chTabsWrapper"
            ]
        },
        {
            "id": "filterToolbarContainer",
            "component": "section",
            "props": {
                "className": "bg-surface-container-highest p-gutter rounded-container shadow-sm flex items-center justify-between"
            },
            "children": [
                "ftLeftSection",
                "ftRightSection"
            ]
        },
        {
            "id": "storageGridContainer",
            "component": "section",
            "props": {
                "className": "grid grid-cols-4 gap-gutter"
            },
            "children": {
                "path": "/scgDevices",
                "componentId": "scgDeviceCard"
            }
        },
        {
            "id": "snLogoWrapper",
            "component": "div",
            "props": {
                "className": "h-16 flex items-center px-6 gap-3 border-b border-divider"
            },
            "children": [
                "snLogoIcon",
                "snLogoText"
            ]
        },
        {
            "id": "snLogoIcon",
            "component": "Icon",
            "props": {
                "name": "cpu",
                "color": "primary",
                "shape": "square",
                "className": "w-8 h-8"
            }
        },
        {
            "id": "snLogoText",
            "component": "span",
            "props": {
                "value": {
                    "path": "/snLogoText"
                },
                "className": "text-xl font-bold text-on-surface tracking-tight"
            }
        },
        {
            "id": "snMenuScrollArea",
            "component": "div",
            "props": {
                "className": "flex-1 overflow-y-auto py-4"
            },
            "children": [
                "snMainMenu"
            ]
        },
        {
            "id": "snMainMenu",
            "component": "Menu",
            "props": {
                "mode": "vertical",
                "selectedKeys": {
                    "path": "/snSelectedKeys"
                },
                "openKeys": {
                    "path": "/snOpenKeys"
                },
                "items": {
                    "path": "/snMenuItems"
                },
                "className": "border-none"
            }
        },
        {
            "id": "thaLangDropdown",
            "component": "Dropdown",
            "props": {
                "menu": {
                    "path": "/thaLangMenu"
                },
                "trigger": [
                    "click"
                ],
                "placement": "bottomRight"
            },
            "children": [
                "thaLangBtn"
            ]
        },
        {
            "id": "thaLangBtn",
            "component": "Button",
            "props": {
                "value": {
                    "path": "/thaLanguage"
                },
                "types": "link",
                "className": "text-on-surface font-medium"
            }
        },
        {
            "id": "thaNotificationBadge",
            "component": "Badge",
            "props": {
                "count": {
                    "path": "/thaNotificationCount"
                },
                "overflowCount": 9,
                "offset": [
                    2,
                    2
                ]
            },
            "children": [
                "thaNotificationIcon"
            ]
        },
        {
            "id": "thaNotificationIcon",
            "component": "Icon",
            "props": {
                "name": "bot",
                "className": "w-5 h-5 cursor-pointer text-on-surface-variant hover:text-primary transition-colors"
            }
        },
        {
            "id": "thaUserDropdown",
            "component": "Dropdown",
            "props": {
                "menu": {
                    "path": "/thaUserMenu"
                },
                "trigger": [
                    "click"
                ],
                "placement": "bottomRight"
            },
            "children": [
                "thaUserInfoWrapper"
            ]
        },
        {
            "id": "thaUserInfoWrapper",
            "component": "div",
            "props": {
                "className": "flex items-center gap-inline cursor-pointer hover:opacity-80 transition-opacity"
            },
            "children": [
                "thaUserAvatar",
                "thaUserName"
            ]
        },
        {
            "id": "thaUserAvatar",
            "component": "div",
            "props": {
                "className": "w-8 h-8 rounded-full overflow-hidden border border-divider"
            },
            "children": [
                "thaUserAvatarImg"
            ]
        },
