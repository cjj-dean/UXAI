        "className": "p-stack flex flex-col text-sm font-normal p-0 rounded-none"
      },
      "children": [
        "almMainTopSourceTitle",
        "almMainTopSourceChart"
      ]
    },
    {
      "id": "almMainTopSourceTitle",
      "component": "span",
      "props": {
        "className": "text-md font-semibold text-on-surface mb-stack",
        "value": "TOP 5 告警源"
      }
    },
    {
      "id": "almMainTopSourceChart",
      "component": "ProcessChart",
      "props": {
        "option": {
          "name": "ProcessBarChart",
          "data": {
            "path": "/almMainTopSourceChart/data"
          }
        },
        "className": "h-48 w-full"
      }
    },
    {
      "id": "almMainTableSection",
      "component": "div",
      "props": {
        "className": "flex flex-col gap-stack"
      },
      "children": [
        "almMainToolbar",
        "almMainTable"
      ]
    },
    {
      "id": "almMainToolbar",
      "component": "div",
      "props": {
        "className": "flex justify-between items-center"
      },
      "children": [
        "almMainToolbarLeft",
        "almMainToolbarRight"
      ]
    },
    {
      "id": "almMainToolbarLeft",
      "component": "div",
      "props": {
        "className": "flex gap-inline"
      },
      "children": [
        "almMainBtnConfirm",
        "almMainBtnClear",
        "almMainSearchInput"
      ]
    },
    {
      "id": "almMainBtnConfirm",
      "component": "Button",
      "props": {
        "value": "确认",
        "color": "primary",
        "icon": "chevron-down",
        "iconPlacement": "end"
      }
    },
    {
      "id": "almMainBtnClear",
      "component": "Button",
      "props": {
        "value": "清除",
        "icon": "chevron-down",
        "iconPlacement": "end"
      }
    },
    {
      "id": "almMainSearchInput",
      "component": "Input",
      "props": {
        "value": {
          "path": "/almMainSearchValue"
        },
        "placeholder": "搜索告警名称...",
        "prefix": "search",
        "className": "w-64"
      }
    },
    {
      "id": "almMainToolbarRight",
      "component": "div",
      "props": {
        "className": "flex gap-inline"
      },
      "children": [
        "almMainBtnExport",
        "almMainBtnRefresh"
      ]
    },
    {
      "id": "almMainBtnExport",
      "component": "Button",
      "props": {
        "icon": "download"
      }
    },
    {
      "id": "almMainBtnRefresh",
      "component": "Button",
      "props": {
        "icon": "refresh-cw"
      }
    },
    {
      "id": "almMainTable",
      "component": "Table",
      "props": {
        "rowKey": "id",
        "dataSource": {
          "path": "/almMainTableData"
        },
        "rowSelection": {
          "type": "checkbox"
        },
        "columns": [
          {
            "title": "名称",
            "dataIndex": "name",
            "minWidth": 180
          },
          {
            "title": "级别",
            "dataIndex": "level",
            "width": 100
          },
          {
            "title": "详情",
            "dataIndex": "details",
            "minWidth": 250
          },
          {
            "title": "站点",
            "dataIndex": "site"
          },
          {
            "title": "告警源分类",
            "dataIndex": "category"
          },
          {
            "title": "告警源",
            "dataIndex": "source",
            "minWidth": 150
          },
          {
            "title": "设备SN",
            "dataIndex": "sn"
          },
          {
            "title": "首次发生时间",
            "dataIndex": "firstTime",
            "width": 180
          },
          {
            "title": "末次发生时间",
            "dataIndex": "lastTime",
            "width": 180
          },
          {
            "title": "是否确认",
            "dataIndex": "status",
            "width": 100
          },
          {
            "title": "处理策略",
            "dataIndex": "strategy"
          },
          {
            "title": "操作",
            "dataIndex": "action",
            "fixed": "end",
            "width": 80
          }
        ]
      },
      "children": {
        "path": "/almMainTableData",
        "componentId": "almMainTableRow"
      }
    },
    {
      "id": "almMainTableRow",
      "component": "TableRow",
      "children": [
        "almMainCellName",
        "almMainCellLevel",
        "almMainCellDetails",
        "almMainCellSite",
        "almMainCellCategory",
        "almMainCellSource",
        "almMainCellSN",
        "almMainCellFirstTime",
        "almMainCellLastTime",
        "almMainCellStatus",
        "almMainCellStrategy",
        "almMainCellAction"
      ]
    },
    {
      "id": "almMainCellName",
      "component": "span",
      "props": {
        "className": "text-md text-on-surface",
        "value": {
          "path": "name"
        }
      }
    },
    {
      "id": "almMainCellLevel",
      "component": "div",
      "props": {
        "className": "flex items-center gap-1"
      },
      "children": [
        "almMainLevelIcon",
        "almMainLevelText"
      ]
    },
    {
      "id": "almMainLevelIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "levelIcon"
        },
        "color": {
          "path": "levelColor"
        },
        "className": "w-4 h-4"
      }
    },
    {
      "id": "almMainLevelText",
      "component": "span",
      "props": {
        "className": "text-md",
        "value": {
          "path": "level"
        }
      }
    },
    {
      "id": "almMainCellDetails",
      "component": "span",
      "props": {
        "className": "text-md text-on-surface-variant truncate",
        "value": {
          "path": "details"
        }
      }
    },
    {
      "id": "almMainCellSite",
      "component": "span",
      "props": {
        "className": "text-md",
        "value": {
          "path": "site"
        }
      }
    },
    {
      "id": "almMainCellCategory",
      "component": "Tag",
      "props": {
        "value": {
          "path": "category"
        },
        "variant": "outlined"
      }
    },
    {
      "id": "almMainCellSource",
      "component": "span",
      "props": {
        "className": "text-md",
        "value": {
          "path": "source"
        }
      }
    },
    {
      "id": "almMainCellSN",
      "component": "span",
      "props": {
        "className": "text-md font-mono",
        "value": {
          "path": "sn"
        }
      }
    },
    {
      "id": "almMainCellFirstTime",
      "component": "span",
      "props": {
        "className": "text-md text-on-surface-variant",
        "value": {
          "path": "firstTime"
        }
      }
    },
    {
      "id": "almMainCellLastTime",
      "component": "span",
      "props": {
        "className": "text-md text-on-surface-variant",
        "value": {
          "path": "lastTime"
        }
      }
    },
    {
      "id": "almMainCellStatus",
      "component": "div",
      "props": {
        "className": "flex items-center gap-1"
      },
      "children": [
        "almMainStatusIcon",
        "almMainStatusText"
      ]
    },
    {
      "id": "almMainStatusIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "statusIcon"
        },
        "className": "w-4 h-4"
      }
    },
    {
      "id": "almMainStatusText",
      "component": "span",
      "props": {
        "className": "text-md",
        "value": {
          "path": "status"
        }
      }
    },
    {
      "id": "almMainCellStrategy",
      "component": "span",
      "props": {
        "className": "text-md",
        "value": {
          "path": "strategy"
        }
      }
    },
    {
      "id": "almMainCellAction",
      "component": "Button",
      "props": {
        "icon": "more-horizontal",
        "types": "link"
      }
    }
  ]
}