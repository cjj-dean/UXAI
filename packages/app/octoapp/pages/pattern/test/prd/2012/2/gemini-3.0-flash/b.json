                        "title": "子评测集名称",
                        "dataIndex": "subName"
                    },
                    {
                        "title": "样本数量",
                        "dataIndex": "count"
                    },
                    {
                        "title": "Exact Match 评分",
                        "dataIndex": "score"
                    },
                    {
                        "title": "状态",
                        "dataIndex": "status"
                    },
                    {
                        "title": "操作",
                        "dataIndex": "action",
                        "width": 100
                    }
                ]
            },
            "children": {
                "path": "/summaryTable",
                "componentId": "summaryTableRow"
            }
        },
        {
            "id": "summaryTableRow",
            "component": "TableRow",
            "children": [
                "cellSubName",
                "cellCount",
                "cellScore",
                "cellStatus",
                "cellAction"
            ]
        },
        {
            "id": "cellSubName",
            "component": "span",
            "props": {
                "value": {
                    "path": "subName"
                },
                "className": "font-medium"
            }
        },
        {
            "id": "cellCount",
            "component": "span",
            "props": {
                "value": {
                    "path": "count"
                }
            }
        },
        {
            "id": "cellScore",
            "component": "span",
            "props": {
                "value": {
                    "path": "score"
                },
                "className": "font-bold text-primary"
            }
        },
        {
            "id": "cellStatus",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "status"
                },
                "color": "success"
            }
        },
        {
            "id": "cellAction",
            "component": "Button",
            "props": {
