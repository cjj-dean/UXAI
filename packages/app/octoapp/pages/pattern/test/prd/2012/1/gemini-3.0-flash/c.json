            "props": {
                "value": "部署任务",
                "className": "text-2xl font-bold text-on-surface"
            }
        },
        {
            "id": "contentScrollArea",
            "component": "div",
            "props": {
                "className": "flex-1 overflow-y-auto p-gutter"
            },
            "children": [
                "tableCard"
            ]
        },
        {
            "id": "tableCard",
            "component": "div",
            "props": {
                "className": "bg-surface-container-highest rounded-xl shadow-card p-inset"
            },
            "children": [
                "tableToolbar",
                "mainDataTable"
            ]
        },
        {
            "id": "tableToolbar",
            "component": "div",
            "props": {
                "className": "flex justify-between items-center mb-gutter"
            },
            "children": [
                "toolbarLeft",
                "toolbarRight"
            ]
        },
        {
            "id": "toolbarLeft",
            "component": "div",
            "props": {
                "className": "flex gap-stack"
            },
            "children": [
                "createBtn",
                "tableSearchInput"
            ]
        },
        {
            "id": "createBtn",
            "component": "Button",
            "props": {
                "value": "创建部署任务",
                "color": "primary",
                "icon": "plus",
                "iconPlacement": "start"
            }
        },
        {
            "id": "tableSearchInput",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/tableSearch"
                },
                "placeholder": "搜索任务名称或模型标识...",
                "prefix": "search",
                "className": "w-64"
            }
        },
        {
            "id": "toolbarRight",
            "component": "div",
            "props": {
                "className": "flex gap-stack"
            },
            "children": [
                "settingsBtn"
            ]
        },
        {
            "id": "settingsBtn",
            "component": "Button",
            "props": {
                "icon": "settings-2",
                "className": "bg-surface-variant"
            }
        },
        {
            "id": "mainDataTable",
            "component": "Table",
            "props": {
                "rowKey": "id",
                "dataSource": {
                    "path": "/deploymentTasks"
                },
                "columns": [
                    {
                        "title": "序号",
                        "dataIndex": "index",
                        "width": 60
                    },
                    {
                        "title": "任务名称",
                        "dataIndex": "taskName",
                        "sort": true
                    },
                    {
                        "title": "部署状态",
                        "dataIndex": "status",
                        "sort": true,
                        "width": 120
                    },
                    {
                        "title": "总卡数",
                        "dataIndex": "gpuCount",
                        "sort": true
                    },
                    {
                        "title": "调用人",
                        "dataIndex": "operator"
                    },
                    {
                        "title": "部署耗时",
                        "dataIndex": "duration",
                        "sort": true
                    },
                    {
                        "title": "开始时间",
                        "dataIndex": "startTime",
                        "sort": true
                    },
                    {
                        "title": "API地址",
                        "dataIndex": "apiUrl"
                    },
                    {
                        "title": "模型标识",
                        "dataIndex": "modelId",
                        "sort": true
                    },
                    {
                        "title": "操作",
                        "dataIndex": "actions",
                        "width": 180
                    }
                ]
            },
            "children": {
                "path": "/deploymentTasks",
                "componentId": "taskTableRow"
            }
        },
        {
            "id": "taskTableRow",
            "component": "TableRow",
            "children": [
                "cellIndex",
                "cellTaskName",
                "cellStatus",
                "cellGpu",
                "cellOperator",
                "cellDuration",
                "cellStartTime",
                "cellApi",
                "cellModelId",
                "cellActions"
            ]
        },
        {
            "id": "cellIndex",
            "component": "span",
            "props": {
                "value": {
                    "path": "index"
                },
                "className": "text-on-surface-variant"
            }
        },
        {
            "id": "cellTaskName",
            "component": "span",
            "props": {
                "value": {
                    "path": "taskName"
                },
                "className": "font-medium text-primary"
            }
        },
        {
            "id": "cellStatus",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "status"
                },
                "color": {
                    "path": "statusType"
                },
                "icon": {
                    "path": "statusIcon"
                },
                "variant": "outlined"
            }
        },
        {
            "id": "cellGpu",
            "component": "span",
            "props": {
                "value": {
                    "path": "gpuCount"
                }
            }
        },
        {
            "id": "cellOperator",
            "component": "span",
            "props": {
                "value": {
                    "path": "operator"
                }
            }
        },
        {
            "id": "cellDuration",
            "component": "span",
            "props": {
                "value": {
                    "path": "duration"
                }
            }
        },
        {
            "id": "cellStartTime",
            "component": "span",
            "props": {
                "value": {
                    "path": "startTime"
                },
                "className": "text-xs text-on-surface-variant"
            }
        },
        {
            "id": "cellApi",
            "component": "span",
            "props": {
                "value": {
                    "path": "apiUrl"
                },
                "className": "truncate max-w-[150px] inline-block text-xs"
            }
        },
        {
            "id": "cellModelId",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "modelId"
                },
                "className": "bg-surface-variant text-on-surface-variant border-none"
            }
        },
        {
            "id": "cellActions",
            "component": "div",
            "props": {
                "className": "flex gap-stack"
            },
            "children": [
                "actionClone",
                "actionEdit",
                "actionLog"
            ]
        },
        {
            "id": "actionClone",
            "component": "span",
            "props": {
                "value": "克隆",
                "className": "text-primary cursor-pointer hover:underline text-sm"
            }
        },
        {
            "id": "actionEdit",
            "component": "span",
            "props": {
                "value": "编辑",
                "className": "text-primary cursor-pointer hover:underline text-sm"
            }
        },
        {
            "id": "actionLog",
            "component": "span",
            "props": {
                "value": "日志路径",
                "className": "text-primary cursor-pointer hover:underline text-sm"
            }
        }
    ]
}