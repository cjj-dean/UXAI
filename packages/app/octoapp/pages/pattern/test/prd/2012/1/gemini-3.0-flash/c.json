            "children": {
                "path": "children",
                "componentId": "navSubItem"
            }
        },
        {
            "id": "navSubItem",
            "component": "div",
            "props": {
                "className": "p-2 pl-4 text-sm rounded-md hover:bg-surface-variant cursor-pointer"
