        },
        {
            "id": "navItemLabel",
            "component": "span",
            "props": {
                "value": {
                    "path": "title"
                },
                "className": "text-md text-on-surface"
            }
        },
        {
            "id": "navSubMenu",
            "component": "div",
            "props": {
                "className": "flex flex-col ml-6 mt-1 border-l border-divider"
