        },
        {
            "id": "userInfo",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "userName",
                "userRole"
            ]
        },
        {
            "id": "userName",
            "component": "span",
            "props": {
                "value": {
                    "path": "/currentUser/name"
                },
                "className": "text-sm font-semibold text-on-surface"
            }
        },
        {
            "id": "userRole",
            "component": "span",
            "props": {
                "value": {
                    "path": "/currentUser/role"
                },
                "className": "text-xs text-on-surface-variant"
            }
        },
        {
            "id": "mainContentArea",
            "component": "div",
