            },
            "children": [
                "topHeader",
                "contentScrollArea"
            ]
        },
        {
            "id": "topHeader",
            "component": "div",
            "props": {
                "className": "px-gutter py-stack bg-surface-container-highest border-b border-divider"
            },
            "children": [
                "breadcrumbNav",
                "pageTitleRow"
            ]
        },
        {
            "id": "breadcrumbNav",
            "component": "Breadcrumb",
            "props": {
                "items": {
                    "path": "/breadcrumbItems"
                },
                "className": "mb-2"
            }
        },
        {
            "id": "pageTitleRow",
            "component": "div",
            "props": {
                "className": "flex items-center gap-inline"
            },
            "children": [
                "pageTitleIcon",
