        {
            "id": "sidebarContainer",
            "component": "div",
            "props": {
                "className": "w-64 flex flex-col bg-surface-container-highest shadow-sm z-10"
            },
            "children": [
                "sidebarHeader",
                "sidebarNav",
                "sidebarFooter"
            ]
        },
        {
            "id": "sidebarHeader",
            "component": "div",
            "props": {
