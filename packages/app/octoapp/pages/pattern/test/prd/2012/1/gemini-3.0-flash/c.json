            },
            "children": [
                "logoWrapper",
                "sidebarSearch"
            ]
        },
        {
            "id": "logoWrapper",
            "component": "div",
            "props": {
                "className": "flex items-center gap-inline mb-2"
            },
            "children": [
                "logoIcon",
                "logoText"
            ]
        },
        {
            "id": "logoIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "/brand/logoIcon"
                },
                "color": "primary",
                "shape": "square",
                "className": "w-8 h-8"
            }
        },
        {
            "id": "logoText",
            "component": "span",
            "props": {
                "value": {
                    "path": "/brand/brandName"
                },
                "className": "text-xl font-bold text-on-surface"
            }
        },
        {
            "id": "sidebarSearch",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/searchQuery"
                },
                "placeholder": "搜索功能或任务...",
                "prefix": "search",
                "size": "medium",
                "className": "bg-surface-variant border-none"
            }
        },
        {
            "id": "sidebarNav",
            "component": "div",
            "props": {
                "className": "flex-1 overflow-y-auto px-inline"
            },
            "children": [
                "navMenuList"
            ]
        },
        {
            "id": "navMenuList",
