    "rootId": "appContainer",
    "elements": [
        {
            "id": "appContainer",
            "component": "div",
            "props": {
                "className": "flex flex-col min-h-screen bg-surface-container-lowest"
            },
            "children": [
                "navHeader",
                "mainContent"
            ]
        },
        {
            "id": "navHeader",
            "component": "header",
            "props": {
                "className": "sticky top-0 z-50 flex items-center justify-between h-16 px-gutter bg-surface-container-highest shadow-sm"
            },
            "children": [
                "navLogoSection",
                "navMenuSection",
                "navActionSection"
            ]
        },
        {
            "id": "navLogoSection",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": [
                "navLogoIcon",
                "navLogoText"
            ]
        },
        {
            "id": "navLogoIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "/brand/logo"
                },
                "color": "primary",
                "shape": "square",
                "className": "w-8 h-8"
            }
        },
        {
            "id": "navLogoText",
            "component": "span",
            "props": {
                "value": {
                    "path": "/brand/name"
                },
                "className": "text-lg font-bold text-on-surface"
            }
        },
        {
            "id": "navMenuSection",
            "component": "div",
            "props": {
                "className": "flex items-center gap-8"
            },
            "children": {
                "path": "/navMenus",
                "componentId": "navMenuItem"
            }
        },
        {
            "id": "navMenuItem",
            "component": "a",
            "props": {
                "className": "text-md font-medium transition-colors hover:text-primary"
            },
            "children": [
                "navMenuItemText"
            ]
        },
        {
            "id": "navMenuItemText",
            "component": "span",
            "props": {
                "value": {
                    "path": "label"
                },
                "className": {
                    "path": "isActive"
                }
            }
        },
        {
            "id": "navActionSection",
            "component": "div",
            "props": {
                "className": "flex items-center gap-4"
            },
            "children": [
                "navSearchBtn",
                "navHelpBtn",
                "navBellBtn",
                "navUserAvatar"
            ]
        },
        {
            "id": "navSearchBtn",
            "component": "Button",
            "props": {
                "icon": "search",
                "shape": "circle",
                "className": "text-on-surface-variant"
            }
        },
        {
            "id": "navHelpBtn",
            "component": "Button",
            "props": {
                "icon": "help-circle",
                "shape": "circle",
                "className": "text-on-surface-variant"
            }
        },
        {
            "id": "navBellBtn",
            "component": "Button",
            "props": {
                "icon": "bell",
                "shape": "circle",
                "className": "text-on-surface-variant"
            }
        },
        {
            "id": "navUserAvatar",
            "component": "img",
            "props": {
                "src": {
                    "path": "/user/avatar"
                },
                "className": "w-8 h-8 rounded-full border border-divider"
            }
        },
        {
            "id": "mainContent",
            "component": "main",
            "props": {
                "className": "flex flex-col gap-gutter p-gutter"
            },
            "children": [
                "dashboardSection",
                "managementSection"
            ]
        },
        {
            "id": "dashboardSection",
            "component": "div",
            "props": {
                "className": "grid grid-cols-4 gap-gutter"
            },
            "children": [
                "chartCard1",
                "chartCard2",
                "chartCard3",
                "chartCard4"
            ]
        },
        {
            "id": "chartCard1",
            "component": "div",
            "props": {
                "className": "p-inset bg-surface-container-highest rounded-container shadow-card"
            },
            "children": [
                "chartTitle1",
                "chartPie"
            ]
        },
        {
            "id": "chartTitle1",
            "component": "h3",
            "props": {
                "value": "链路占比趋势",
                "className": "text-md font-bold mb-stack"
            }
        },
        {
            "id": "chartPie",
            "component": "PieChart",
            "props": {
                "option": {
                    "type": "pie",
                    "title": {
                        "text": "链路分布"
                    },
                    "data": {
                        "path": "/charts/linkDistribution"
                    },
                    "color": [
                        "#0067D1",
                        "#09AA71",
                        "#F4840C",
                        "#715AFB"
                    ]
                },
                "className": "h-48 w-full"
            }
        },
        {
            "id": "chartCard2",
            "component": "div",
            "props": {
                "className": "p-inset bg-surface-container-highest rounded-container shadow-card"
            },
            "children": [
                "chartTitle2",
                "chartBar"
            ]
        },
        {
            "id": "chartTitle2",
            "component": "h3",
            "props": {
                "value": "Top5 时延越限链路 (ms)",
                "className": "text-md font-bold mb-stack"
            }
        },
        {
            "id": "chartBar",
            "component": "BarChart",
            "props": {
                "option": {
                    "direction": "horizontal",
                    "data": {
                        "path": "/charts/latencyTop5"
                    },
                    "xAxis": {
                        "data": "linkName"
                    },
                    "yAxisTitle": "ms",
                    "color": [
                        "#E02128"
                    ]
                },
                "className": "h-48 w-full"
            }
        },
        {
            "id": "chartCard3",
            "component": "div",
            "props": {
                "className": "p-inset bg-surface-container-highest rounded-container shadow-card flex flex-col items-center"
            },
            "children": [
                "chartTitle3",
                "chartGauge"
            ]
        },
        {
            "id": "chartTitle3",
            "component": "h3",
            "props": {
                "value": "无保护路径占比",
                "className": "text-md font-bold mb-stack self-start"
            }
        },
        {
            "id": "chartGauge",
            "component": "GaugeChart",
            "props": {
                "option": {
                    "progress": true,
                    "data": {
                        "path": "/charts/unprotected"
                    },
                    "status": "warning"
                },
                "className": "h-48 w-full"
            }
        },
        {
            "id": "chartCard4",
            "component": "div",
            "props": {
                "className": "p-inset bg-surface-container-highest rounded-container shadow-card"
            },
            "children": [
                "chartTitle4",
                "chartLine"
            ]
        },
        {
            "id": "chartTitle4",
            "component": "h3",
            "props": {
                "value": "故障链路核心数据 (24h)",
                "className": "text-md font-bold mb-stack"
            }
        },
        {
            "id": "chartLine",
            "component": "LineChart",
            "props": {
                "option": {
                    "area": true,
                    "smooth": true,
                    "data": {
                        "path": "/charts/faultTrend"
                    },
                    "xAxis": {
                        "data": "time"
                    },
                    "yAxisTitle": "故障数",
                    "color": [
                        "#715AFB"
                    ]
                },
                "className": "h-48 w-full"
            }
        },
        {
            "id": "managementSection",
            "component": "div",
            "props": {
                "className": "p-inset bg-surface-container-highest rounded-container shadow-card"
            },
            "children": [
                "mgmtHeader",
                "mgmtToolbar",
                "mgmtTable"
            ]
        },
        {
            "id": "mgmtHeader",
            "component": "div",
            "props": {
                "className": "flex items-center justify-between mb-gutter"
            },
            "children": [
                "mgmtTitle"
            ]
        },
        {
            "id": "mgmtTitle",
            "component": "h2",
            "props": {
                "value": "网络切片管理",
                "className": "text-xl font-bold text-on-surface"
            }
        },
        {
            "id": "mgmtToolbar",
            "component": "div",
            "props": {
                "className": "flex items-center justify-between mb-gutter"
            },
            "children": [
                "mgmtSearch",
                "mgmtActions"
            ]
        },
        {
            "id": "mgmtSearch",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/sliceSearch"
                },
                "placeholder": "搜索切片ID/名称/租户...",
                "prefix": "search",
                "className": "w-80"
            }
        },
        {
            "id": "mgmtActions",
            "component": "div",
            "props": {
                "className": "flex gap-inline"
            },
            "children": [
                "btnExport",
                "btnAdd"
            ]
        },
        {
            "id": "btnExport",
            "component": "Button",
            "props": {
                "value": "导出",
                "icon": "download",
                "iconPlacement": "start"
            }
        },
        {
            "id": "btnAdd",
            "component": "Button",
            "props": {
                "value": "添加切片",
                "icon": "plus",
                "iconPlacement": "start",
                "color": "primary"
            }
        },
        {
            "id": "mgmtTable",
            "component": "Table",
            "props": {
                "rowKey": "sliceId",
                "dataSource": {
                    "path": "/sliceTable"
                },
                "columns": [
                    {
                        "title": "切片ID",
                        "dataIndex": "sliceId"
                    },
                    {
                        "title": "切片名称",
                        "dataIndex": "sliceName"
                    },
                    {
                        "title": "租户",
                        "dataIndex": "tenant"
                    },
                    {
                        "title": "业务类型",
                        "dataIndex": "serviceType"
                    },
                    {
                        "title": "带宽",
                        "dataIndex": "bandwidth"
                    },
                    {
                        "title": "时延",
                        "dataIndex": "latency"
                    },
                    {
                        "title": "隔离级别",
                        "dataIndex": "isolationLevel"
                    },
                    {
                        "title": "激活状态",
                        "dataIndex": "activeStatus",
                        "width": 100
                    },
                    {
                        "title": "创建时间",
                        "dataIndex": "createTime"
                    },
                    {
                        "title": "操作",
                        "dataIndex": "actions",
                        "width": 120,
                        "align": "center"
                    }
                ]
            },
            "children": {
                "path": "/sliceTable",
                "componentId": "mgmtTableRow"
            }
        },
        {
            "id": "mgmtTableRow",
            "component": "TableRow",
            "children": [
                "cellId",
                "cellName",
                "cellTenant",
                "cellType",
                "cellBandwidth",
                "cellLatency",
                "cellIsolation",
                "cellStatus",
                "cellTime",
                "cellActions"
            ]
        },
        {
            "id": "cellId",
            "component": "span",
            "props": {
                "value": {
                    "path": "sliceId"
                },
                "className": "text-on-surface-variant font-mono"
            }
        },
        {
            "id": "cellName",
            "component": "span",
            "props": {
                "value": {
                    "path": "sliceName"
                },
                "className": "font-medium"
            }
        },
        {
            "id": "cellTenant",
            "component": "span",
            "props": {
                "value": {
                    "path": "tenant"
                }
            }
        },
        {
            "id": "cellType",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "serviceType"
                },
                "variant": "outlined"
            }
        },
        {
            "id": "cellBandwidth",
            "component": "span",
            "props": {
                "value": {
                    "path": "bandwidth"
                }
            }
        },
        {
            "id": "cellLatency",
            "component": "span",
            "props": {
                "value": {
                    "path": "latency"
                },
                "className": "text-primary"
            }
        },
        {
            "id": "cellIsolation",
            "component": "span",
            "props": {
                "value": {
                    "path": "isolationLevel"
                }
            }
        },
        {
            "id": "cellStatus",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "activeStatus"
                },
                "color": {
                    "path": "statusColor"
                }
            }
        },
        {
            "id": "cellTime",
            "component": "span",
            "props": {
                "value": {
                    "path": "createTime"
                },
                "className": "text-xs text-on-surface-variant"
            }
        },
        {
            "id": "cellActions",
            "component": "div",
            "props": {
                "className": "flex gap-2 justify-center"
            },
            "children": [
                "actionEdit",
                "actionDownload",
                "actionMore"
            ]
        },
        {
            "id": "actionEdit",
            "component": "Button",
            "props": {
                "icon": "edit",
                "size": "small",
                "shape": "circle",
                "className": "text-primary"
            }
        },
        {
            "id": "actionDownload",
            "component": "Button",
            "props": {
                "icon": "file-down",
                "size": "small",
                "shape": "circle",
                "className": "text-success"
            }
        },
        {
            "id": "actionMore",
            "component": "Button",
            "props": {
                "icon": "more-horizontal",
                "size": "small",
                "shape": "circle"
            }
        }
    ]
}