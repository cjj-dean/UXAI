    },
    {
      "id": "sideMenuLabel",
      "component": "span",
      "props": {
        "value": {
          "path": "label"
        },
        "className": "text-md"
      }
    },
    {
      "id": "contentArea",
      "component": "div",
      "props": {
        "className": "flex-1 overflow-y-auto p-inset flex flex-col gap-gutter"
      },
      "children": [
        "breadcrumb",
        "overviewCard",
        "rfListCard"
      ]
    },
    {
      "id": "breadcrumb",
      "component": "Breadcrumb",
      "props": {
        "items": {
          "path": "/breadcrumbs"
        }
      }
    },
    {
      "id": "overviewCard",
      "component": "div",
      "props": {
        "className": "bg-surface-container-highest rounded-xl p-6 shadow-card flex gap-10"
      },
      "children": [
        "radarSection",
        "statusSection"
      ]
    },
    {
      "id": "radarSection",
      "component": "div",
      "props": {
        "className": "w-1/3 flex flex-col"
      },
      "children": [
        "radarTitle",
        "radarChart"
      ]
    },
    {
      "id": "radarTitle",
      "component": "span",
      "props": {
        "value": "体验概览",
        "className": "text-md font-bold mb-4"
      }
    },
    {
      "id": "radarChart",
      "component": "RadarChart",
      "props": {
        "option": {
          "data": {
            "path": "/radarData"
          },
          "radar": {
            "shape": "polygon"
          }
        },
        "className": "h-64 w-full"
      }
    },
    {
      "id": "statusSection",
      "component": "div",
      "props": {
        "className": "flex-1 flex flex-col"
      },
      "children": [
        "statusHeader",
        "metricsTable"
      ]
    },
    {
      "id": "statusHeader",
      "component": "div",
      "props": {
        "className": "flex justify-between items-start mb-6"
      },
      "children": [
        "statusInfo",
        "optimizeBtn"
      ]
    },
    {
      "id": "statusInfo",
      "component": "div",
      "props": {
        "className": "flex flex-col"
      },
      "children": [
        "statusMain",
        "updateTime"
      ]
    },
    {
      "id": "statusMain",
      "component": "span",
      "props": {
        "value": {
          "path": "/overallStatus/text"
        },
        "className": "text-4xl font-bold text-success"
      }
    },
    {
      "id": "updateTime",
      "component": "span",
      "props": {
        "value": {
          "path": "/overallStatus/updateTime"
        },
        "className": "text-xs text-on-surface-variant mt-1"
      }
    },
    {
      "id": "optimizeBtn",
      "component": "Button",
      "props": {
        "value": "深度优化",
        "color": "primary",
        "className": "rounded-lg"
      }
    },
    {
      "id": "metricsTable",
      "component": "Table",
      "props": {
        "rowKey": "metricName",
        "dataSource": {
          "path": "/metrics"
        },
        "pagination": false,
        "columns": [
          {
            "title": "指标",
            "dataIndex": "name"
          },
          {
            "title": "指标状态",
            "dataIndex": "status"
          },
          {
            "title": "质优射频数",
            "dataIndex": "excellent"
          },
          {
            "title": "良好射频数",
            "dataIndex": "good"
          },
          {
            "title": "质差射频数",
            "dataIndex": "poor"
          }
        ]
      },
      "children": {
        "path": "/metrics",
        "componentId": "metricsRow"
      }
    },
    {
      "id": "metricsRow",
      "component": "TableRow",
      "children": [
        "mName",
        "mStatus",
        "mExc",
        "mGood",
        "mPoor"
      ]
    },
    {
      "id": "mName",
      "component": "span",
      "props": {
        "value": {
          "path": "name"
        }
      }
    },
    {
      "id": "mStatus",
      "component": "Tag",
      "props": {
        "value": {
          "path": "status"
        },
        "color": {
          "path": "color"
        }
      }
    },
    {
      "id": "mExc",
      "component": "span",
      "props": {
        "value": {
          "path": "excellent"
        }
      }
    },
    {
      "id": "mGood",
      "component": "span",
      "props": {
        "value": {
          "path": "good"
        }
      }
    },
    {
      "id": "mPoor",
      "component": "span",
      "props": {
        "value": {
          "path": "poor"
        }
      }
    },
    {
      "id": "rfListCard",
      "component": "div",
      "props": {
        "className": "bg-surface-container-highest rounded-xl p-6 shadow-card flex flex-col gap-4"
      },
      "children": [
        "rfHeader",
        "rfToolbar",
        "rfTable"
      ]
    },
    {
      "id": "rfHeader",
      "component": "span",
      "props": {
        "value": "射频列表",
        "className": "text-md font-bold"
      }
    },
    {
      "id": "rfToolbar",
      "component": "div",
      "props": {
        "className": "flex items-center gap-6"
      },
      "children": [
        "rfSearch",
        "rfFilter"
      ]
    },
    {
      "id": "rfSearch",
      "component": "Input",
      "props": {
        "value": {
          "path": "/rfSearch"
        },
        "placeholder": "搜索射频名称...",
        "prefix": "search",
        "className": "w-64"
      }
    },
    {
      "id": "rfFilter",
      "component": "RadioGroup",
      "props": {
        "value": {
          "path": "/rfBand"
        },
        "options": {
          "path": "/rfBands"
        },
        "optionType": "button"
      }
    },
    {
      "id": "rfTable",
      "component": "Table",
      "props": {
        "rowKey": "id",
        "dataSource": {
          "path": "/rfList"
        },
        "columns": [
          {
            "title": "射频名称",
            "dataIndex": "name"
          },
          {
            "title": "射频状态",
            "dataIndex": "status",
            "width": 100
          },
          {
            "title": "频段",
            "dataIndex": "band"
          },
          {
            "title": "信道",
            "dataIndex": "channel"
          },
          {
            "title": "功率",
            "dataIndex": "power"
          },
          {
            "title": "接入用户数",
            "dataIndex": "users"
          },
          {
            "title": "信道利用率",
            "dataIndex": "utilization"
          },
          {
            "title": "干扰率",
            "dataIndex": "interference"
          },
          {
            "title": "噪声强度",
            "dataIndex": "noise"
          },
          {
            "title": "频宽",
            "dataIndex": "bandwidth"
          }
        ]
      },
      "children": {
        "path": "/rfList",
        "componentId": "rfRow"
      }
    },
    {
      "id": "rfRow",
      "component": "TableRow",
      "children": [
        "rfName",
        "rfStatus",
        "rfBand",
        "rfChan",
        "rfPow",
        "rfUser",
        "rfUtil",
        "rfInter",
        "rfNoise",
        "rfBw"
      ]
    },
    {
      "id": "rfName",
      "component": "span",
      "props": {
        "value": {
          "path": "name"
        },
        "className": "font-medium"
      }
    },
    {
      "id": "rfStatus",
      "component": "Tag",
      "props": {
        "value": {
          "path": "status"
        },
        "color": {
          "path": "statusColor"
        },
        "variant": "filled"
      }
    },
    {
      "id": "rfBand",
      "component": "span",
      "props": {
        "value": {
          "path": "band"
        }
      }
    },
    {
      "id": "rfChan",
      "component": "span",
      "props": {
        "value": {
          "path": "channel"
        }
      }
    },
    {
      "id": "rfPow",
      "component": "span",
      "props": {
        "value": {
          "path": "power"
        }
      }
    },
    {
      "id": "rfUser",
      "component": "span",
      "props": {
        "value": {
          "path": "users"
        }
      }
    },
    {
      "id": "rfUtil",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": [
        "utilDot",
        "utilVal"
      ]
    },
    {
      "id": "utilDot",
      "component": "Icon",
      "props": {
        "name": "circle",
        "shape": "fill",
        "color": {
          "path": "utilDot"
        },
        "className": "w-2 h-2"
      }
    },
    {
      "id": "utilVal",
      "component": "span",
      "props": {
        "value": {
          "path": "utilization"
        }
      }
    },
    {
      "id": "rfInter",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": [
        "interDot",
        "interVal"
      ]
    },
    {
      "id": "interDot",
      "component": "Icon",
      "props": {
        "name": "circle",
        "shape": "fill",
        "color": {
          "path": "interDot"
        },
        "className": "w-2 h-2"
      }
    },
    {
      "id": "interVal",
      "component": "span",
      "props": {
        "value": {
          "path": "interference"
