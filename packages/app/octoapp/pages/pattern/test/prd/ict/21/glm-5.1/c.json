  "rootId": "appLayout",
  "elements": [
    {
      "id": "appLayout",
      "component": "div",
      "props": {
        "className": "flex flex-col h-screen bg-surface-container-lowest"
      },
      "children": [
        "header",
        "mainBody"
      ]
    },
    {
      "id": "header",
      "component": "div",
      "props": {
        "className": "h-14 flex items-center justify-between px-gutter bg-surface-container-highest shadow-sm z-10"
      },
      "children": [
        "headerLeft",
        "headerRight"
      ]
    },
    {
      "id": "headerLeft",
      "component": "div",
      "props": {
        "className": "flex items-center gap-6"
      },
      "children": [
        "brandGroup",
        "topNavMenu"
      ]
    },
    {
      "id": "brandGroup",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": [
        "logo",
        "brandName"
      ]
    },
    {
      "id": "logo",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/brand/logo"
        },
        "color": "primary",
        "shape": "square",
        "className": "w-8 h-8"
      }
    },
    {
      "id": "brandName",
      "component": "span",
      "props": {
        "value": {
          "path": "/brand/name"
        },
        "className": "text-lg font-bold text-on-surface"
      }
    },
    {
      "id": "topNavMenu",
      "component": "Tabs",
      "props": {
        "activeKey": {
          "path": "/activeTopNav"
        },
        "className": "h-14"
      },
      "children": {
        "path": "/topNav",
        "componentId": "topNavItem"
      }
    },
    {
      "id": "topNavItem",
      "component": "TabItem",
      "props": {
        "key": {
          "path": "key"
        },
        "label": {
          "path": "label"
        }
      }
    },
    {
      "id": "headerRight",
      "component": "div",
      "props": {
        "className": "flex items-center gap-4"
      },
      "children": [
        "themeBtn",
        "noticeBtn",
        "userGroupBtn",
        "homeBtn"
      ]
    },
    {
      "id": "themeBtn",
      "component": "Button",
      "props": {
        "icon": "sun",
        "shape": "circle",
        "className": "border-none"
      }
    },
    {
      "id": "noticeBtn",
      "component": "Button",
      "props": {
        "icon": "bell",
        "shape": "circle",
        "className": "border-none"
      }
    },
    {
      "id": "userGroupBtn",
      "component": "Button",
      "props": {
        "icon": "users",
        "shape": "circle",
        "className": "border-none"
      }
    },
    {
      "id": "homeBtn",
      "component": "Button",
      "props": {
        "value": "返回首页",
        "className": "rounded-lg"
      }
    },
    {
      "id": "mainBody",
      "component": "div",
      "props": {
        "className": "flex flex-1 overflow-hidden"
      },
      "children": [
        "sidebar",
        "contentArea"
      ]
    },
    {
      "id": "sidebar",
      "component": "div",
      "props": {
        "className": "w-60 bg-surface-container-highest border-r border-divider flex flex-col py-4"
      },
      "children": [
        "sideMenu"
      ]
    },
    {
      "id": "sideMenu",
      "component": "div",
      "props": {
        "className": "flex flex-col gap-1 px-2"
      },
      "children": {
        "path": "/sideNav",
        "componentId": "sideMenuItem"
      }
    },
    {
      "id": "sideMenuItem",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3 px-4 py-3 rounded-lg cursor-pointer transition-colors"
