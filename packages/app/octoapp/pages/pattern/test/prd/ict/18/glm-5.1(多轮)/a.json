    },
    {
      "id": "mainAppGuideImage",
      "component": "img",
      "props": {
        "src": {
          "path": "/guideCard/guideIllustrationImage"
        },
        "alt": "3D Cloud Deploy Illustration",
        "className": "w-full h-full object-cover"
      }
    },
    {
      "id": "mainAppGuideStepsWrap",
      "component": "div",
      "props": {
        "className": "flex-1 flex items-center"
      },
      "children": [
        "mainAppGuideSteps"
      ]
    },
    {
      "id": "mainAppGuideSteps",
      "component": "Steps",
      "props": {
        "current": 0,
        "orientation": "horizontal",
        "types": "default"
      },
      "children": {
        "path": "/guideCard/deploySteps",
        "componentId": "mainAppGuideStepItem"
      }
    },
    {
      "id": "mainAppGuideStepItem",
      "component": "StepItem",
      "props": {
        "title": {
          "path": "stepTitle"
        },
        "content": {
          "path": "stepDescription"
        },
        "icon": {
          "path": "stepIcon"
        }
      }
    },
    {
      "id": "mainAppDataCard",
      "component": "div",
      "props": {
        "className": "bg-surface-container-highest rounded-container shadow-card p-inset"
      },
      "children": [
        "mainAppDataHeader",
        "mainAppDataTable"
      ]
    },
    {
      "id": "mainAppDataHeader",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between mb-stack"
      },
      "children": [
        "mainAppDataTitle",
        "mainAppToolbarWrap"
      ]
    },
    {
      "id": "mainAppDataTitle",
      "component": "span",
      "props": {
        "className": "text-lg font-semibold text-on-surface",
        "value": {
          "path": "/dataCard/cardTitle"
        }
      }
    },
    {
      "id": "mainAppToolbarWrap",
      "component": "div",
      "props": {
        "className": "flex items-center gap-gutter"
      },
      "children": [
        "mainAppSearchInput",
        "mainAppToolbarBtnGroup"
      ]
    },
    {
      "id": "mainAppSearchInput",
      "component": "Input",
      "props": {
        "value": {
          "path": "/searchValue"
        },
        "placeholder": "搜索应用名称",
        "prefix": "search",
        "className": "w-60"
      }
    },
    {
      "id": "mainAppToolbarBtnGroup",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": {
        "path": "/dataCard/toolbarActions",
        "componentId": "mainAppToolbarBtn"
      }
    },
    {
      "id": "mainAppToolbarBtn",
      "component": "Button",
      "props": {
        "value": {
          "path": "actionLabel"
        },
        "icon": {
          "path": "actionIcon"
        },
        "iconPlacement": "start",
        "color": {
          "path": "actionType"
        }
      }
    },
    {
      "id": "mainAppDataTable",
      "component": "Table",
      "props": {
        "rowKey": "id",
        "dataSource": {
          "path": "/dataCard/tableDataSource"
        },
        "rowSelection": {
          "type": "checkbox",
          "selectedRowKeys": {
            "path": "/selectedRowKeys"
          }
        },
        "columns": [
          {
            "title": "应用名称",
            "dataIndex": "appName",
            "width": 200
          },
          {
            "title": "状态",
            "dataIndex": "status",
            "width": 110,
            "align": "center"
          },
          {
            "title": "实例数量",
            "dataIndex": "instanceCount",
            "width": 110,
            "align": "center"
          },
          {
            "title": "CPU使用率",
            "dataIndex": "cpuUsage",
            "width": 150
          },
          {
            "title": "内存使用率",
            "dataIndex": "memoryUsage",
            "width": 150
          },
          {
            "title": "创建时间",
            "dataIndex": "createdTime",
            "width": 180
          },
          {
            "title": "操作",
            "dataIndex": "action",
            "width": 160,
            "fixed": "end",
            "align": "center"
          }
        ],
        "className": "mb-4"
      },
      "children": {
        "path": "/dataCard/tableDataSource",
        "componentId": "mainAppTableRow"
      }
    },
    {
      "id": "mainAppTableRow",
      "component": "TableRow",
      "children": [
        "mainAppNameCell",
        "mainAppStatusCell",
        "mainAppInstanceCell",
        "mainAppCpuCell",
        "mainAppMemoryCell",
        "mainAppTimeCell",
        "mainAppActionCell"
      ]
    },
    {
      "id": "mainAppNameCell",
      "component": "span",
      "props": {
        "className": "text-md font-medium text-on-surface",
        "value": {
          "path": "appName"
        }
      }
    },
    {
      "id": "mainAppStatusCell",
      "component": "Tag",
      "props": {
        "value": {
          "path": "statusTag/statusText"
        },
        "color": {
          "path": "statusTag/statusColor"
        }
      }
    },
    {
      "id": "mainAppInstanceCell",
      "component": "span",
      "props": {
        "className": "text-md text-on-surface",
        "value": {
          "path": "instanceCount"
        }
      }
    },
    {
      "id": "mainAppCpuCell",
      "component": "Progress",
      "props": {
        "percent": {
          "path": "cpuUsagePercent"
        },
        "size": "small",
        "showInfo": true
      }
    },
    {
      "id": "mainAppMemoryCell",
      "component": "Progress",
      "props": {
        "percent": {
          "path": "memoryUsagePercent"
        },
        "size": "small",
        "showInfo": true
      }
    },
    {
      "id": "mainAppTimeCell",
      "component": "span",
      "props": {
        "className": "text-md text-on-surface-variant",
        "value": {
          "path": "createdTime"
        }
      }
    },
    {
      "id": "mainAppActionCell",
      "component": "div",
      "props": {
        "className": "flex items-center justify-center gap-3"
      },
      "children": {
        "path": "rowActions",
        "componentId": "mainAppActionBtn"
      }
    },
    {
      "id": "mainAppActionBtn",
      "component": "Button",
      "props": {
        "value": {
          "path": "actionName"
        },
        "icon": {
          "path": "actionIcon"
        },
        "types": "link",
        "size": "small",
        "iconPlacement": "start"
      }
    }
  ]
}