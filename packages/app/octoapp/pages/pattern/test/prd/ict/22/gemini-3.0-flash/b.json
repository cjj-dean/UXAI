    "rootId": "dashboardContainer",
    "elements": [
        {
            "id": "dashboardContainer",
            "component": "div",
            "props": {
                "className": "flex flex-col min-h-screen bg-surface-container-lowest"
            },
            "children": [
                "globalHeader",
                "mainScrollArea"
            ]
        },
        {
            "id": "globalHeader",
            "component": "header",
            "props": {
                "className": "flex items-center justify-between px-gutter py-inline bg-surface-container-highest shadow-sm z-10"
            },
            "children": [
                "headerLeft",
                "headerCenter",
                "headerRight"
            ]
        },
        {
            "id": "headerLeft",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": [
                "brandLogo",
                "brandText"
            ]
        },
        {
            "id": "brandLogo",
            "component": "Icon",
            "props": {
                "name": "network",
                "color": "primary",
                "shape": "square",
                "className": "w-8 h-8"
            }
        },
        {
            "id": "brandText",
            "component": "span",
            "props": {
                "value": {
                    "path": "/brandName"
                },
                "className": "text-lg font-bold text-on-surface"
            }
        },
        {
            "id": "headerCenter",
            "component": "h1",
            "props": {
                "value": {
                    "path": "/pageTitle"
                },
                "className": "text-xl font-bold text-on-surface tracking-wide"
            }
        },
        {
            "id": "headerRight",
            "component": "div",
            "props": {
                "className": "flex items-center gap-4"
            },
            "children": [
                "switchButton",
                "headerActionList"
            ]
        },
        {
            "id": "switchButton",
            "component": "Button",
            "props": {
                "value": {
                    "path": "/switchLabel"
                },
                "icon": "chevron-down",
                "iconPlacement": "end",
                "shape": "round",
                "className": "bg-primary-container text-primary border-none"
            }
        },
        {
            "id": "headerActionList",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": {
                "path": "/actionIcons",
                "componentId": "headerActionIcon"
            }
        },
        {
            "id": "headerActionIcon",
            "component": "Button",
            "props": {
                "icon": {
                    "path": "icon"
                },
                "shape": "circle",
                "className": "text-on-surface-variant hover:bg-surface-variant"
            }
        },
        {
            "id": "mainScrollArea",
            "component": "main",
            "props": {
                "className": "flex-1 overflow-y-auto p-gutter flex flex-col gap-gutter"
            },
            "children": [
                "metricsPanel",
                "analysisPanel",
                "trendPanel"
            ]
        },
        {
            "id": "metricsPanel",
            "component": "section",
            "props": {
                "className": "relative bg-surface-container-highest rounded-container shadow-card p-inset"
            },
            "children": [
                "panelBadge",
                "metricsGrid"
            ]
        },
        {
            "id": "panelBadge",
            "component": "div",
            "props": {
                "className": "absolute top-0 left-0"
            },
            "children": [
                "badgeTag"
            ]
        },
        {
            "id": "badgeTag",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "/cornerBadge"
                },
                "color": "primary",
                "variant": "filled",
                "className": "rounded-tl-container rounded-br-container px-3"
            }
        },
        {
            "id": "metricsGrid",
            "component": "div",
            "props": {
                "className": "grid grid-cols-6 gap-gutter mt-4"
            },
            "children": {
                "path": "/metrics",
                "componentId": "metricItem"
            }
        },
        {
            "id": "metricItem",
            "component": "div",
            "props": {
                "className": "flex flex-col items-center text-center p-inline rounded-xl bg-surface-variant"
            },
            "children": [
                "metricIcon",
                "metricLabel",
                "metricValueGroup"
            ]
        },
        {
            "id": "metricIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "icon"
                },
                "color": {
                    "path": "color"
                },
                "shape": "circle",
                "className": "w-10 h-10 mb-2"
            }
        },
        {
            "id": "metricLabel",
            "component": "span",
            "props": {
                "value": {
                    "path": "label"
                },
                "className": "text-xs text-on-surface-variant mb-1"
            }
        },
        {
            "id": "metricValueGroup",
            "component": "div",
            "props": {
                "className": "flex items-baseline gap-1"
            },
            "children": [
                "metricValue",
                "metricUnit"
            ]
        },
        {
            "id": "metricValue",
            "component": "span",
            "props": {
                "value": {
                    "path": "value"
                },
                "className": "text-2xl font-bold",
                "style": {
                    "color": {
                        "path": "color"
                    }
                }
            }
        },
        {
            "id": "metricUnit",
            "component": "span",
            "props": {
                "value": {
                    "path": "unit"
                },
                "className": "text-xs text-on-surface-variant"
            }
        },
        {
            "id": "analysisPanel",
            "component": "section",
            "props": {
                "className": "bg-surface-container-highest rounded-container shadow-card p-inset"
            },
            "children": [
                "analysisTitle",
                "processStepsComp",
                "analysisChartsGrid"
            ]
        },
        {
            "id": "analysisTitle",
            "component": "h2",
            "props": {
                "value": "故障诊断全景分析",
                "className": "text-lg font-bold mb-6 text-on-surface"
            }
        },
        {
            "id": "processStepsComp",
            "component": "Steps",
            "props": {
                "current": 1,
                "className": "mb-gutter"
            },
            "children": {
                "path": "/processSteps",
                "componentId": "processStepItem"
            }
        },
        {
            "id": "processStepItem",
            "component": "StepItem",
            "props": {
                "title": {
                    "path": "title"
                },
                "content": {
                    "path": "desc"
                },
                "status": {
                    "path": "status"
                }
            }
        },
        {
            "id": "analysisChartsGrid",
            "component": "div",
            "props": {
                "className": "grid grid-cols-4 gap-gutter h-64"
            },
            "children": [
                "donutChartBox",
                "stackedBarBox",
                "topReasonsBox",
                "diagnosticTableBox"
            ]
        },
        {
            "id": "donutChartBox",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "donutTitle",
                "donutChart"
            ]
        },
        {
            "id": "donutTitle",
            "component": "span",
            "props": {
                "value": "故障总次数分布",
                "className": "text-sm font-medium mb-2"
            }
        },
        {
            "id": "donutChart",
            "component": "PieChart",
            "props": {
                "option": {
                    "type": "circle",
                    "data": {
                        "path": "/faultDonutData"
                    },
                    "title": {
                        "text": "1130",
                        "subtext": "总数"
                    }
                },
                "className": "flex-1 w-full"
            }
        },
        {
            "id": "stackedBarBox",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "stackedTitle",
                "stackedChart"
            ]
        },
        {
            "id": "stackedTitle",
            "component": "span",
            "props": {
                "value": "故障类型时段分布",
                "className": "text-sm font-medium mb-2"
            }
        },
        {
            "id": "stackedChart",
            "component": "BarChart",
            "props": {
                "option": {
                    "type": "stack",
                    "data": {
                        "path": "/faultStackedData"
                    },
                    "xAxis": {
                        "data": "Time"
                    },
                    "yAxisTitle": "次数"
                },
                "className": "flex-1 w-full"
            }
        },
        {
            "id": "topReasonsBox",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "topTitle",
                "topChart"
            ]
        },
        {
            "id": "topTitle",
            "component": "span",
            "props": {
                "value": "根本原因 TOP 10",
                "className": "text-sm font-medium mb-2"
            }
        },
        {
            "id": "topChart",
            "component": "BarChart",
            "props": {
                "option": {
                    "direction": "horizontal",
                    "data": {
                        "path": "/reasonTopData"
                    },
                    "xAxis": {
                        "data": "reason"
                    },
                    "yAxisTitle": "数量"
                },
                "className": "flex-1 w-full"
            }
        },
        {
            "id": "diagnosticTableBox",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "tableTitle",
                "diagTable"
            ]
        },
        {
            "id": "tableTitle",
            "component": "span",
            "props": {
                "value": "最新诊断结论",
                "className": "text-sm font-medium mb-2"
            }
        },
        {
            "id": "diagTable",
            "component": "Table",
            "props": {
                "rowKey": "id",
                "dataSource": {
                    "path": "/diagnosticTable"
                },
                "pagination": false,
                "className": "text-xs",
                "columns": [
                    {
                        "title": "目标",
                        "dataIndex": "target"
                    },
                    {
                        "title": "结论",
                        "dataIndex": "conclusion"
                    },
                    {
                        "title": "置信度",
                        "dataIndex": "confidence",
                        "width": 60
                    }
                ]
            },
            "children": {
                "path": "/diagnosticTable",
                "componentId": "diagTableRow"
            }
        },
        {
            "id": "diagTableRow",
            "component": "TableRow",
            "children": [
                "cellTarget",
                "cellConclusion",
                "cellConfidence"
            ]
        },
        {
            "id": "cellTarget",
            "component": "span",
            "props": {
                "value": {
                    "path": "target"
                }
            }
        },
        {
            "id": "cellConclusion",
            "component": "span",
            "props": {
                "value": {
                    "path": "conclusion"
                },
                "className": "text-primary"
            }
        },
        {
            "id": "cellConfidence",
            "component": "span",
            "props": {
                "value": {
                    "path": "confidence"
                },
                "className": "font-bold text-success"
            }
        },
        {
            "id": "trendPanel",
            "component": "section",
            "props": {
                "className": "bg-surface-container-highest rounded-container shadow-card p-inset"
            },
            "children": [
                "trendHeader",
                "trendChart"
            ]
        },
        {
            "id": "trendHeader",
            "component": "div",
            "props": {
                "className": "flex justify-between items-center mb-gutter"
            },
            "children": [
                "trendTitle",
                "trendFilter"
            ]
        },
        {
            "id": "trendTitle",
            "component": "h2",
            "props": {
                "value": "故障诊断趋势",
                "className": "text-lg font-bold text-on-surface"
            }
        },
        {
            "id": "trendFilter",
            "component": "div",
            "props": {
                "className": "flex gap-2"
            },
            "children": [
                "filterBtn"
            ]
        },
        {
            "id": "filterBtn",
            "component": "Button",
            "props": {
                "value": "最近7天",
                "size": "small",
                "icon": "calendar"
            }
        },
        {
            "id": "trendChart",
            "component": "LineChart",
            "props": {
                "option": {
                    "smooth": true,
                    "area": true,
                    "data": {
                        "path": "/trendData"
                    },
                    "xAxis": {
                        "data": "time"
                    },
                    "yAxisTitle": "故障数",
                    "color": [
                        "#FF4D4F",
                        "#FAAD14",
                        "#1890FF"
                    ]
                },
                "className": "h-80 w-full"
            }
        }
    ]
}