  "rootId": "appShellContainer",
  "elements": [
    {
      "id": "appShellContainer",
      "component": "div",
      "props": {
        "className": "flex flex-col h-screen w-full bg-surface-container-lowest"
      },
      "children": [
        "headerNavContainer",
        "bodyLayoutContainer"
      ]
    },
    {
      "id": "headerNavContainer",
      "component": "header",
      "props": {
        "className": "h-16 flex items-center px-page bg-surface-container-highest shadow-card shrink-0 z-10"
      },
      "children": [
        "hdrLeftSection",
        "hdrSpacer",
        "hdrRightSection"
      ]
    },
    {
      "id": "bodyLayoutContainer",
      "component": "div",
      "props": {
        "className": "flex flex-1 overflow-hidden"
      },
      "children": [
        "sideNavMenuContainer",
        "mainContentContainer"
      ]
    },
    {
      "id": "sideNavMenuContainer",
      "component": "aside",
      "props": {
        "className": "w-60 flex flex-col bg-surface-container-highest shrink-0 overflow-y-auto border-r border-divider"
      },
      "children": [
        "sideNavHeader",
        "sideNavMenuWrap"
      ]
    },
    {
      "id": "mainContentContainer",
      "component": "main",
      "props": {
        "className": "flex-1 flex flex-col p-page gap-page overflow-y-auto bg-surface-container-lowest"
      },
      "children": [
        "mainContBreadcrumb",
        "mainContTitleRow",
        "mainContChartsRow",
        "mainContTableSection"
      ]
    },
    {
      "id": "hdrLeftSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-6"
      },
      "children": [
        "hdrLogoGroup",
        "hdrPrimaryMenu"
      ]
    },
    {
      "id": "hdrLogoGroup",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 cursor-pointer"
      },
      "children": [
        "hdrLogoIcon",
        "hdrLogoText"
      ]
    },
    {
      "id": "hdrLogoIcon",
      "component": "Icon",
      "props": {
        "name": "cloud",
        "color": "primary",
        "shape": "fill",
        "className": "w-6 h-6"
      }
    },
    {
      "id": "hdrLogoText",
      "component": "span",
      "props": {
        "value": {
          "path": "/logoText"
        },
        "className": "text-lg font-bold text-primary"
      }
    },
    {
      "id": "hdrPrimaryMenu",
      "component": "Menu",
      "props": {
        "mode": "horizontal",
        "selectedKeys": {
          "path": "/selectedNavKey"
        },
        "items": {
          "path": "/navMenuItems"
        },
        "className": "border-b-0"
      }
    },
    {
      "id": "hdrSpacer",
      "component": "div",
      "props": {
        "className": "flex-1"
      }
    },
    {
      "id": "hdrRightSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-4"
      },
      "children": [
        "hdrSearchInput",
        "hdrActionGroup",
        "hdrDivider",
        "hdrUserDropdown"
      ]
    },
    {
      "id": "hdrSearchInput",
      "component": "Input",
      "props": {
        "value": {
          "path": "/searchValue"
        },
        "placeholder": "全局搜索...",
        "prefix": "search",
        "className": "w-52"
      }
    },
    {
      "id": "hdrActionGroup",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "hdrBellBadge",
        "hdrHelpIcon"
      ]
    },
    {
      "id": "hdrBellBadge",
      "component": "Badge",
      "props": {
        "count": {
          "path": "/globalActions/1/badgeCount"
        },
        "overflowCount": 99
      },
      "children": [
        "hdrBellIcon"
      ]
    },
    {
      "id": "hdrBellIcon",
      "component": "Icon",
      "props": {
        "name": "bell",
        "shape": "outline",
        "className": "w-5 h-5 cursor-pointer"
      }
    },
    {
      "id": "hdrHelpIcon",
      "component": "Icon",
      "props": {
        "name": "help-circle",
        "shape": "outline",
        "className": "w-5 h-5 cursor-pointer"
      }
    },
    {
      "id": "hdrDivider",
      "component": "div",
      "props": {
        "className": "w-px h-6 bg-surface-dim"
      }
    },
    {
      "id": "hdrUserDropdown",
      "component": "Dropdown",
      "props": {
        "placement": "bottomRight",
        "trigger": [
          "click"
        ],
        "menu": {
          "path": "/userDropdownMenu"
        }
      },
      "children": [
        "hdrUserTrigger"
      ]
    },
    {
      "id": "hdrUserTrigger",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 cursor-pointer hover:opacity-80 transition-opacity"
      },
      "children": [
        "hdrUserAvatar",
        "hdrUserInfo"
      ]
    },
    {
      "id": "hdrUserAvatar",
      "component": "img",
      "props": {
        "src": {
          "path": "/userProfile/avatarImage"
        },
        "alt": "avatar",
        "className": "w-8 h-8 rounded-full object-cover"
      }
    },
    {
      "id": "hdrUserInfo",
      "component": "div",
      "props": {
        "className": "flex flex-col"
      },
      "children": [
        "hdrUserName",
        "hdrUserRole"
      ]
    },
    {
      "id": "hdrUserName",
      "component": "span",
      "props": {
        "value": {
          "path": "/userProfile/userName"
        },
        "className": "text-sm font-medium text-on-surface leading-tight"
      }
    },
    {
      "id": "hdrUserRole",
      "component": "span",
      "props": {
        "value": {
          "path": "/userProfile/roleName"
        },
        "className": "text-xs text-on-surface-variant leading-tight"
      }
    },
    {
      "id": "sideNavHeader",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 px-4 py-4 border-b border-divider"
      },
      "children": [
        "sideNavHeaderIcon",
        "sideNavHeaderTitle"
      ]
    },
    {
      "id": "sideNavHeaderIcon",
      "component": "Icon",
      "props": {
        "name": "server",
        "color": "primary",
        "shape": "square",
        "className": "w-6 h-6"
      }
    },
    {
      "id": "sideNavHeaderTitle",
      "component": "span",
      "props": {
        "className": "text-lg font-semibold text-on-surface",
        "value": {
          "path": "/menuTitleText"
        }
      }
    },
    {
      "id": "sideNavMenuWrap",
      "component": "div",
      "props": {
        "className": "flex-1 px-2 py-2"
      },
      "children": [
        "sideNavMenu"
      ]
    },
    {
      "id": "sideNavMenu",
      "component": "Menu",
      "props": {
        "mode": "vertical",
        "inlineCollapsed": false,
        "selectedKeys": {
          "path": "/selectedMenuKeys"
        },
        "openKeys": {
          "path": "/openMenuKeys"
        },
        "items": {
          "path": "/menuItems"
        },
        "className": "w-full"
      }
    },
    {
      "id": "mainContBreadcrumb",
      "component": "Breadcrumb",
      "props": {
        "items": {
          "path": "/breadcrumbPath"
        },
        "separator": "/",
        "className": "mb-1"
      }
    },
    {
      "id": "mainContTitleRow",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3 mb-section"
      },
      "children": [
        "mainContTitleIcon",
        "mainContTitle"
      ]
    },
    {
      "id": "mainContTitleIcon",
      "component": "Icon",
      "props": {
        "name": "layout-dashboard",
