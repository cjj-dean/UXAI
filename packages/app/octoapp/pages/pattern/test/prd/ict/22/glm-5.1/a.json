  "rootId": "mainAppRoot",
  "elements": [
    {
      "id": "mainAppRoot",
      "component": "div",
      "props": {
        "className": "flex flex-col min-h-screen bg-[#0B1120] text-white"
      },
      "children": [
        "navBarContainer",
        "mainContentArea",
        "globalFooter"
      ]
    },
    {
      "id": "navBarContainer",
      "component": "header",
      "props": {
        "className": "flex items-center justify-between px-6 py-3 bg-[#0f172a] border-b border-[#1e3a5f]/50"
      },
      "children": [
        "navLeftSection",
        "navCenterSection",
        "navRightSection"
      ]
    },
    {
      "id": "navLeftSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "navBrandIcon",
        "navBrandName"
      ]
    },
    {
      "id": "navBrandIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/brandLogoIcon"
        },
        "color": "primary",
        "shape": "square",
        "className": "w-8 h-8"
      }
    },
    {
      "id": "navBrandName",
      "component": "span",
      "props": {
        "className": "text-lg font-bold text-white tracking-wide",
        "value": {
          "path": "/brandName"
        }
      }
    },
    {
      "id": "navCenterSection",
      "component": "div",
      "props": {
        "className": "flex-1 text-center"
      },
      "children": [
        "navPageTitle"
      ]
    },
    {
      "id": "navPageTitle",
      "component": "span",
      "props": {
        "className": "text-xl font-bold text-white/90 tracking-wider",
        "value": {
          "path": "/pageTitle"
        }
      }
    },
    {
      "id": "navRightSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-4"
      },
      "children": [
        "navToggleGroup",
        "navSystemIconsGroup",
        "navUserSection"
      ]
    },
    {
      "id": "navToggleGroup",
      "component": "div",
      "props": {
        "className": "flex gap-1 bg-[#1e293b] rounded-lg p-1"
      },
      "children": [
        "navToggleDashboard",
        "navToggleTopology"
      ]
    },
    {
      "id": "navToggleDashboard",
      "component": "Button",
      "props": {
        "value": "Dashboard",
        "color": "primary",
        "size": "small"
      }
    },
    {
      "id": "navToggleTopology",
      "component": "Button",
      "props": {
        "value": "Topology",
        "size": "small"
      }
    },
    {
      "id": "navSystemIconsGroup",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "navBellWrapper",
        "navSettingsIcon"
      ]
    },
    {
      "id": "navBellWrapper",
      "component": "div",
      "props": {
        "className": "relative"
      },
      "children": [
        "navBellIcon",
        "navBellBadge"
      ]
    },
    {
      "id": "navBellIcon",
      "component": "Icon",
      "props": {
        "name": "bell",
        "color": "inverse",
        "className": "w-5 h-5"
      }
    },
    {
      "id": "navBellBadge",
      "component": "div",
      "props": {
        "className": "absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold rounded-full w-4 h-4 flex items-center justify-center",
        "value": {
          "path": "/systemIcons/0/badgeCount"
        }
      }
    },
    {
      "id": "navSettingsIcon",
      "component": "Icon",
      "props": {
        "name": "settings",
        "color": "inverse",
        "className": "w-5 h-5"
      }
    },
    {
      "id": "navUserSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 ml-2 pl-3 border-l border-slate-700"
      },
      "children": [
        "navUserAvatar",
        "navUserName"
      ]
    },
    {
      "id": "navUserAvatar",
      "component": "img",
      "props": {
        "src": {
          "path": "/userInfo/avatarImage"
        },
        "className": "w-8 h-8 rounded-full border-2 border-blue-500/50",
        "alt": "User Avatar"
      }
    },
    {
      "id": "navUserName",
      "component": "span",
      "props": {
        "className": "text-sm text-slate-300 font-medium",
        "value": {
          "path": "/userInfo/userName"
        }
      }
    },
    {
      "id": "mainContentArea",
      "component": "div",
      "props": {
        "className": "flex-1 p-6 flex flex-col gap-6 overflow-auto"
      },
      "children": [
        "metricsCardContainer",
        "analysisCardContainer",
        "trendCardContainer",
        "alarmsCardContainer"
      ]
    },
    {
      "id": "metricsCardContainer",
      "component": "div",
      "props": {
        "className": "bg-[#111827] border border-[#1e3a5f]/40 rounded-xl p-5"
      },
      "children": [
        "metricsCardHeader",
        "metricsGrid"
      ]
    },
    {
      "id": "metricsCardHeader",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between mb-4"
      },
      "children": [
        "metricsCardTitle",
        "metricsLiveTag"
      ]
    },
    {
      "id": "metricsCardTitle",
      "component": "span",
      "props": {
        "className": "text-lg font-semibold text-white",
        "value": {
          "path": "/metricsCardTitle"
        }
      }
    },
    {
      "id": "metricsLiveTag",
      "component": "Tag",
      "props": {
        "value": "Live",
        "color": "processing",
        "icon": "radio",
        "size": "small"
      }
    },
    {
      "id": "metricsGrid",
      "component": "div",
      "props": {
        "className": "grid grid-cols-6 gap-4"
      },
      "children": {
        "path": "/metricsList",
        "componentId": "metricsItem"
      }
    },
    {
      "id": "metricsItem",
      "component": "div",
      "props": {
        "className": "bg-[#1e293b]/60 border border-[#334155]/40 rounded-lg p-4 flex items-center gap-4"
      },
      "children": [
        "metricsItemIcon",
        "metricsItemInfo"
      ]
    },
    {
      "id": "metricsItemIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "metricIcon"
        },
        "color": {
          "path": "iconColor"
        },
        "shape": "square",
        "className": "w-10 h-10"
      }
    },
