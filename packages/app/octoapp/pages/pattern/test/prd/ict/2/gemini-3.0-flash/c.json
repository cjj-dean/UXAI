            "id": "cellP2",
            "component": "span",
            "props": {
                "value": {
                    "path": "p2"
                }
            }
        },
        {
            "id": "cellBw",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "bw"
                },
                "color": "warning",
                "variant": "outlined"
            }
        },
        {
            "id": "cellD1",
            "component": "span",
            "props": {
                "value": {
                    "path": "d1"
                }
            }
