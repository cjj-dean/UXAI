                    {
                        "title": "网络端口使用率 (60%-80%)",
                        "dataIndex": "p2"
                    },
                    {
                        "title": "带宽利用率 (70%-100%)",
                        "dataIndex": "bw"
                    },
                    {
                        "title": "磁盘空间 (60%-80%)",
                        "dataIndex": "d1"
                    },
                    {
                        "title": "磁盘空间 (80%-100%)",
                        "dataIndex": "d2"
                    }
                ]
