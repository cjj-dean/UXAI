        },
        "className": "text-md text-on-surface-variant"
      }
    },
    {
      "id": "cntMetricsWrap",
      "component": "div",
      "props": {
        "className": "bg-surface-variant rounded-lg p-stack"
      },
      "children": [
        "cntMetricsTable"
      ]
    },
    {
      "id": "cntMetricsTable",
      "component": "Table",
      "props": {
        "rowKey": "key",
        "dataSource": {
          "path": "/metricsData"
        },
        "pagination": false,
        "columns": [
          {
            "title": "射频总数",
            "dataIndex": "totalRfCount",
            "align": "center"
          },
          {
            "title": "正常",
            "dataIndex": "normalCount",
            "align": "center"
          },
          {
            "title": "告警",
            "dataIndex": "warningCount",
            "align": "center"
          },
          {
            "title": "降级",
            "dataIndex": "degradedCount",
            "align": "center"
          },
          {
            "title": "故障",
            "dataIndex": "errorCount",
            "align": "center"
          }
        ]
      },
      "children": {
        "path": "/metricsData",
        "componentId": "cntMetricsRow"
      }
    },
    {
      "id": "cntMetricsRow",
      "component": "TableRow",
      "children": [
        "cntMetricsTotalCell",
        "cntMetricsNormalCell",
        "cntMetricsWarningCell",
        "cntMetricsDegradedCell",
        "cntMetricsErrorCell"
      ]
    },
    {
      "id": "cntMetricsTotalCell",
      "component": "span",
      "props": {
        "value": {
          "path": "totalRfCount"
        },
        "className": "text-lg font-bold text-on-surface"
      }
    },
    {
      "id": "cntMetricsNormalCell",
      "component": "span",
      "props": {
        "value": {
          "path": "normalCount"
        },
        "className": "text-lg font-bold text-success"
      }
    },
    {
      "id": "cntMetricsWarningCell",
      "component": "span",
      "props": {
        "value": {
          "path": "warningCount"
        },
        "className": "text-lg font-bold text-critical"
      }
    },
    {
      "id": "cntMetricsDegradedCell",
      "component": "span",
      "props": {
        "value": {
