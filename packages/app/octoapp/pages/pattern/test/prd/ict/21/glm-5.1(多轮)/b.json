    {
      "id": "hdrBrandLogo",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/brandInfo/logoIcon"
        },
        "color": "primary",
        "shape": "square",
        "className": "w-8 h-8"
      }
    },
    {
      "id": "hdrBrandName",
      "component": "span",
      "props": {
        "value": {
          "path": "/brandInfo/brandName"
        },
        "className": "text-lg font-semibold text-on-surface whitespace-nowrap"
      }
    },
    {
      "id": "hdrDivider",
      "component": "div",
      "props": {
        "className": "w-px h-6 bg-divider"
      }
    },
    {
      "id": "hdrNavMenu",
      "component": "Menu",
      "props": {
        "mode": "horizontal",
        "selectedKeys": {
          "path": "/selectedMenuKeys"
        },
        "items": {
          "path": "/menuItems"
        },
        "className": "flex-1 min-w-0"
      }
    },
    {
      "id": "hdrRightSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-gutter shrink-0"
      },
      "children": [
        "hdrActionsGroup",
        "hdrHomeBtn"
      ]
    },
    {
      "id": "hdrActionsGroup",
      "component": "div",
      "props": {
        "className": "flex items-center gap-1"
      },
      "children": {
        "path": "/headerActions",
        "componentId": "hdrActionWrap"
      }
    },
    {
      "id": "hdrActionWrap",
      "component": "div",
      "props": {
        "title": {
          "path": "tooltip"
        },
        "className": "flex items-center justify-center w-8 h-8 rounded-md hover:bg-surface-variant transition-colors cursor-pointer"
      },
      "children": [
        "hdrActionIcon"
      ]
    },
    {
      "id": "hdrActionIcon",
      "component": "Icon",
      "props": {
        "name": {
