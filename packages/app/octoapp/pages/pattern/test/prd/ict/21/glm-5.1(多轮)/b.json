      "props": {
        "value": {
          "path": "/homeButton/buttonText"
        },
        "shape": {
          "path": "/homeButton/buttonType"
        },
        "color": "primary"
      }
    },
    {
      "id": "sdNavMenu",
      "component": "Menu",
      "props": {
        "mode": "vertical",
        "inlineCollapsed": false,
        "selectedKeys": {
          "path": "/selectedMenuKeys"
        },
        "items": {
          "path": "/sideMenuItems"
        },
        "className": "w-full"
      }
    },
