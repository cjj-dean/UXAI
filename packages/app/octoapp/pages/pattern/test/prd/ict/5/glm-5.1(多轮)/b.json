      "children": [
        "hdrNavLogoIcon",
        "hdrNavPlatformName",
        "hdrNavMainMenu"
      ]
    },
    {
      "id": "hdrNavLogoIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/logoIcon"
        },
        "color": "primary",
        "shape": "outline",
        "className": "w-8 h-8"
      }
    },
    {
      "id": "hdrNavPlatformName",
      "component": "span",
      "props": {
        "value": {
          "path": "/platformName"
        },
        "className": "text-xl font-bold text-primary mr-4"
      }
    },
    {
      "id": "hdrNavMainMenu",
      "component": "Menu",
      "props": {
        "mode": "horizontal",
        "selectedKeys": {
          "path": "/selectedMenuKey"
        },
        "items": {
          "path": "/mainMenus"
        },
        "className": "border-none bg-transparent"
      }
    },
    {
      "id": "hdrNavRightSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "hdrNavAssetBtn",
        "hdrNavNotifBadge",
        "hdrNavUserDropdown"
      ]
    },
    {
      "id": "hdrNavAssetBtn",
      "component": "Button",
      "props": {
        "icon": {
          "path": "/assetCenterIcon"
        },
        "types": "link",
        "className": "text-on-surface-variant hover:text-primary"
      }
    },
    {
      "id": "hdrNavNotifBadge",
      "component": "Badge",
      "props": {
        "count": {
          "path": "/messageCount"
