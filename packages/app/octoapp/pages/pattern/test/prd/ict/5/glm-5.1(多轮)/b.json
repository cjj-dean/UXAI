      "props": {
        "value": "经营中心",
        "className": "text-lg font-semibold text-on-surface"
      }
    },
    {
      "id": "sideMnuDivider",
      "component": "Divider",
      "props": {
        "className": "mx-0",
        "variant": "solid",
        "size": "small"
