  "rootId": "appRoot",
  "elements": [
    {
      "id": "appRoot",
      "component": "div",
      "props": {
        "className": "flex flex-col w-full h-screen bg-surface-container-lowest overflow-hidden"
      },
      "children": [
        "headerNavContainer",
        "appBodyContainer"
      ]
    },
    {
      "id": "headerNavContainer",
      "component": "header",
      "props": {
        "className": "h-16 flex items-center px-page bg-surface-container-highest shadow-sm z-10 shrink-0"
      },
      "children": [
        "hdrNavBrandArea",
        "hdrNavTabsArea",
        "hdrNavRightArea"
      ]
    },
    {
      "id": "appBodyContainer",
      "component": "div",
      "props": {
        "className": "flex flex-1 overflow-hidden"
      },
      "children": [
        "leftSidebarContainer",
        "mainContentContainer"
      ]
    },
    {
      "id": "leftSidebarContainer",
      "component": "aside",
      "props": {
        "className": "w-60 h-full flex flex-col bg-surface-container-highest border-r border-divider shrink-0"
      },
      "children": [
        "lftSdbTitleArea",
        "lftSdbMenuWrapper",
        "lftSdbCollapseArea"
      ]
    },
    {
      "id": "mainContentContainer",
      "component": "main",
      "props": {
        "className": "flex-1 flex flex-col overflow-y-auto p-page"
      },
      "children": [
        "mainCBreadcrumb",
        "mainCChartsRow",
        "mainCTableCard"
      ]
    },
    {
      "id": "hdrNavBrandArea",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 mr-8 shrink-0"
      },
      "children": [
        "hdrNavBrandIcon",
        "hdrNavBrandText"
      ]
    },
    {
      "id": "hdrNavBrandIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/brandInfo/brandLogoIcon"
        },
        "color": "primary",
        "shape": "outline",
        "className": "w-6 h-6"
      }
    },
    {
      "id": "hdrNavBrandText",
      "component": "span",
      "props": {
        "value": {
          "path": "/brandInfo/brandName"
        },
        "className": "text-lg font-bold text-primary whitespace-nowrap"
      }
    },
    {
      "id": "hdrNavTabsArea",
      "component": "div",
      "props": {
        "className": "flex-1 flex justify-center"
      },
      "children": [
        "hdrNavGlobalTabs"
      ]
    },
    {
      "id": "hdrNavGlobalTabs",
      "component": "Tabs",
      "props": {
        "activeKey": {
          "path": "/activeTab"
        }
      },
      "children": {
        "path": "/globalTabs",
        "componentId": "hdrNavTabItem"
      }
    },
    {
      "id": "hdrNavTabItem",
      "component": "TabItem",
      "props": {
        "key": {
          "path": "tabKey"
        },
        "label": {
          "path": "tabName"
        }
      }
    },
    {
      "id": "hdrNavRightArea",
      "component": "div",
      "props": {
        "className": "flex items-center gap-6 shrink-0 ml-auto"
      },
      "children": [
        "hdrNavRightMenu",
        "hdrNavDivider",
        "hdrNavUserDropdown"
      ]
    },
    {
      "id": "hdrNavRightMenu",
      "component": "Menu",
      "props": {
        "mode": "horizontal",
        "selectedKeys": {
          "path": "/selectedMenuKeys"
        },
        "items": {
          "path": "/headerMenus"
        },
        "className": "border-none bg-transparent"
      }
    },
    {
      "id": "hdrNavDivider",
      "component": "div",
      "props": {
        "className": "w-px h-6 bg-surface-dim"
      }
    },
    {
      "id": "hdrNavUserDropdown",
      "component": "Dropdown",
      "props": {
        "placement": "bottomRight",
        "trigger": [
          "click"
        ],
        "menu": {
          "path": "/userMenuItems"
        }
      },
      "children": [
        "hdrNavUserAvatarWrap"
      ]
    },
    {
      "id": "hdrNavUserAvatarWrap",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 cursor-pointer hover:opacity-80 transition-opacity"
      },
      "children": [
        "hdrNavUserAvatar",
        "hdrNavUserName",
        "hdrNavUserChevron"
      ]
    },
    {
      "id": "hdrNavUserAvatar",
      "component": "img",
      "props": {
        "src": {
          "path": "/userInfo/userAvatarImage"
        },
        "alt": "User Avatar",
        "className": "w-8 h-8 rounded-full object-cover"
      }
    },
    {
      "id": "hdrNavUserName",
      "component": "span",
      "props": {
        "value": {
          "path": "/userInfo/userName"
        },
        "className": "text-md text-on-surface font-medium"
      }
    },
    {
      "id": "hdrNavUserChevron",
      "component": "Icon",
      "props": {
        "name": "chevron-down",
        "shape": "outline",
        "className": "w-4 h-4"
      }
    },
    {
      "id": "lftSdbTitleArea",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 px-4 py-4 border-b border-divider"
      },
      "children": [
        "lftSdbTitleIcon",
        "lftSdbTitleText"
      ]
    },
    {
      "id": "lftSdbTitleIcon",
      "component": "Icon",
      "props": {
        "name": "monitor",
        "color": "primary",
        "shape": "outline",
        "className": "w-5 h-5"
      }
    },
    {
      "id": "lftSdbTitleText",
      "component": "span",
      "props": {
        "className": "text-lg font-semibold text-on-surface",
        "value": {
          "path": "/sidebarTitle"
        }
      }
    },
    {
      "id": "lftSdbMenuWrapper",
      "component": "div",
      "props": {
        "className": "flex-1 overflow-y-auto py-1"
      },
      "children": [
        "lftSdbMenu"
      ]
    },
    {
      "id": "lftSdbMenu",
      "component": "Menu",
      "props": {
        "mode": "vertical",
        "inlineCollapsed": false,
        "selectedKeys": {
          "path": "/selectedMenuKeys"
        },
        "openKeys": {
