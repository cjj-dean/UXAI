      ]
    },
    {
      "id": "mainTableTitle",
      "component": "h3",
      "props": {
        "className": "text-lg font-semibold text-on-surface",
        "value": {
          "path": "/tableCardData/cardTitle"
        }
      }
    },
    {
      "id": "mainTableToolbar",
      "component": "div",
      "props": {
        "className": "flex items-center gap-inline"
      },
      "children": {
        "path": "/tableCardData/toolbarActions",
        "componentId": "mainToolbarBtn"
      }
    },
    {
      "id": "mainToolbarBtn",
      "component": "Button",
      "props": {
        "value": {
          "path": "actionName"
        },
        "icon": {
          "path": "actionIcon"
        },
        "iconPlacement": "start",
        "color": {
          "path": "buttonType"
        }
      }
    },
    {
      "id": "mainTableBody",
      "component": "div",
      "props": {
        "className": "p-inset pt-stack"
      },
      "children": [
        "mainDataTable"
      ]
    },
    {
      "id": "mainDataTable",
      "component": "Table",
      "props": {
        "rowKey": "rowId",
        "dataSource": {
          "path": "/tableCardData/tableRows"
        },
        "rowSelection": {
          "type": "checkbox",
          "selectedRowKeys": {
            "path": "/selectedRowKeys"
          }
        },
        "columns": [
          {
            "title": "应用名称",
            "dataIndex": "appName",
            "sort": true,
            "minWidth": 140
          },
          {
            "title": "描述",
            "dataIndex": "description",
            "sort": true,
            "minWidth": 200
          },
          {
            "title": "运行状态",
            "dataIndex": "instanceStatus",
            "minWidth": 130
          },
          {
            "title": "命名空间",
            "dataIndex": "namespace",
            "minWidth": 100
          },
          {
            "title": "创建时间",
            "dataIndex": "createTime",
            "sort": true,
            "minWidth": 140
          },
          {
            "title": "操作",
            "dataIndex": "actions",
            "width": 120,
            "align": "center"
          }
        ],
        "className": "mb-4"
      },
      "children": {
        "path": "/tableCardData/tableRows",
        "componentId": "mainTableRow"
      }
    },
    {
      "id": "mainTableRow",
      "component": "TableRow",
      "children": [
        "mainCellAppName",
        "mainCellDesc",
        "mainCellStatus",
        "mainCellNamespace",
        "mainCellCreateTime",
        "mainCellActions"
      ]
    },
    {
      "id": "mainCellAppName",
      "component": "span",
      "props": {
        "className": "text-md font-medium text-on-surface",
        "value": {
          "path": "appName"
        }
      }
    },
    {
      "id": "mainCellDesc",
      "component": "span",
      "props": {
        "className": "text-md text-on-surface-variant",
        "value": {
          "path": "description"
        }
      }
    },
    {
      "id": "mainCellStatus",
      "component": "Tag",
      "props": {
        "value": {
          "path": "instanceStatus/statusText"
        },
        "color": {
          "path": "instanceStatus/statusColor"
        }
      }
    },
    {
      "id": "mainCellNamespace",
      "component": "span",
      "props": {
        "className": "text-md text-on-surface",
        "value": {
          "path": "namespace"
        }
      }
    },
    {
      "id": "mainCellCreateTime",
      "component": "span",
      "props": {
        "className": "text-md text-on-surface-variant",
        "value": {
          "path": "createTime"
        }
      }
    },
    {
      "id": "mainCellActions",
      "component": "div",
      "props": {
        "className": "flex items-center justify-center gap-2"
      },
      "children": [
        "mainActionCreateBtn",
        "mainActionDeleteBtn"
      ]
    },
    {
      "id": "mainActionCreateBtn",
      "component": "Button",
      "props": {
        "icon": "copy-plus",
        "types": "link",
        "size": "small"
      }
    },
    {
      "id": "mainActionDeleteBtn",
      "component": "Button",
      "props": {
        "icon": "trash-2",
        "types": "link",
        "size": "small"
      }
    }
  ]
}