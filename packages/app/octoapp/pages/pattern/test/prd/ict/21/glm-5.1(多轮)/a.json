        "className": "w-8 h-8 rounded-full object-cover"
      }
    },
    {
      "id": "hdUserName",
      "component": "span",
      "props": {
        "value": {
          "path": "/actionItems/userName"
        },
        "className": "text-md text-on-surface whitespace-nowrap"
      }
    },
    {
      "id": "sdCategoryWrap",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 px-4 pt-6 pb-2"
      },
      "children": [
        "sdCategoryIcon",
        "sdCategoryLabel"
      ]
    },
    {
      "id": "sdCategoryIcon",
      "component": "Icon",
      "props": {
        "name": "activity",
        "color": "primary",
        "shape": "outline",
        "className": "w-5 h-5"
      }
    },
    {
      "id": "sdCategoryLabel",
      "component": "span",
      "props": {
        "value": "监控分析",
        "className": "text-sm font-semibold text-on-surface tracking-wide"
      }
    },
    {
      "id": "sdDivider",
      "component": "div",
      "props": {
        "className": "mx-4 border-t border-divider"
      }
    },
    {
      "id": "sdMenuWrap",
      "component": "div",
      "props": {
        "className": "flex-1 overflow-y-auto px-2 pt-2"
      },
      "children": [
        "sdMenu"
      ]
    },
    {
      "id": "sdMenu",
      "component": "Menu",
      "props": {
        "mode": "vertical",
        "inlineCollapsed": false,
        "selectedKeys": {
          "path": "/selectedKeys"
        },
        "items": {
          "path": "/menuItems"
        },
        "className": "w-full"
      }
    },
    {
      "id": "bcBreadcrumb",
      "component": "Breadcrumb",
      "props": {
