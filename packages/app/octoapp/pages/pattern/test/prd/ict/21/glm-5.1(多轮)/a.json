      "children": [
        "rfLCardHeader",
        "rfLCardBody"
      ]
    },
    {
      "id": "hdLeftSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-gutter"
      },
      "children": [
        "hdLogoIcon",
        "hdBrandName",
        "hdNavDivider",
        "hdPrimaryMenu"
      ]
    },
    {
      "id": "hdLogoIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/brand/logoIcon"
        },
        "color": "primary",
        "shape": "square",
        "className": "w-8 h-8"
      }
    },
    {
      "id": "hdBrandName",
      "component": "span",
      "props": {
        "value": {
          "path": "/brand/brandName"
        },
        "className": "text-lg font-semibold text-on-surface whitespace-nowrap"
      }
    },
    {
      "id": "hdNavDivider",
      "component": "div",
      "props": {
        "className": "w-px h-6 bg-border-base"
      }
    },
    {
      "id": "hdPrimaryMenu",
      "component": "Menu",
      "props": {
        "mode": "horizontal",
        "selectedKeys": {
          "path": "/selectedNavKeys"
        },
        "items": {
          "path": "/menuNavItems"
        },
        "className": "border-none bg-transparent"
      }
    },
    {
      "id": "hdRightSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-gutter ml-auto"
      },
      "children": [
        "hdSearchBtn",
        "hdNotificationBadge",
        "hdUserDivider",
        "hdUserSection"
      ]
    },
    {
      "id": "hdSearchBtn",
      "component": "Button",
      "props": {
        "icon": {
          "path": "/actionItems/globalSearchIcon"
        },
        "shape": "circle",
        "types": "link",
        "className": "w-9 h-9 flex items-center justify-center"
      }
    },
    {
      "id": "hdNotificationBadge",
      "component": "Badge",
      "props": {
        "count": {
          "path": "/actionItems/notificationCount"
        },
        "overflowCount": 99
      },
      "children": [
        "hdBellIcon"
      ]
    },
    {
      "id": "hdBellIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/actionItems/notificationIcon"
        },
        "color": "default",
        "shape": "outline",
        "className": "w-6 h-6 cursor-pointer"
      }
    },
    {
      "id": "hdUserDivider",
      "component": "div",
      "props": {
        "className": "w-px h-6 bg-border-base"
      }
    },
    {
