      }
    },
    {
      "id": "mainContStatusText",
      "component": "span",
      "props": {
        "value": "良好",
        "className": "text-3xl font-bold text-success"
      }
    },
    {
      "id": "mainContUpdateTime",
      "component": "span",
      "props": {
        "value": "2002.12.22 14:22 更新",
        "className": "text-sm text-on-surface-variant"
      }
    },
    {
      "id": "mainContActionBtn",
      "component": "Button",
      "props": {
        "value": "深度优化",
        "color": "primary",
        "shape": "round"
      }
    },
    {
      "id": "mainContMetricsTable",
      "component": "Table",
      "props": {
        "rowKey": "id",
        "dataSource": {
          "path": "/metricsData"
        },
        "pagination": false,
        "columns": [
          {
            "title": "指标",
            "dataIndex": "metricName"
          },
          {
            "title": "指标状态",
            "dataIndex": "statusText"
          },
          {
            "title": "质优射频数",
            "dataIndex": "excellentCount"
          },
          {
            "title": "良好射频数",
            "dataIndex": "goodCount"
          },
          {
            "title": "质差射频数",
            "dataIndex": "poorCount"
          }
        ]
      },
      "children": {
        "path": "/metricsData",
        "componentId": "mainContMetricRow"
      }
    },
    {
      "id": "mainContMetricRow",
      "component": "TableRow",
