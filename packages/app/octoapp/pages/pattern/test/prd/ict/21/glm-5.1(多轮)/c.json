  "rootId": "shellAppContainer",
  "elements": [
    {
      "id": "shellAppContainer",
      "component": "div",
      "props": {
        "className": "flex flex-col min-h-screen bg-surface-container-lowest"
      },
      "children": [
        "headerTopNavSlot",
        "bodyLayoutContainer"
      ]
    },
    {
      "id": "headerTopNavSlot",
      "component": "header",
      "props": {
        "className": "h-16 flex items-center bg-surface-container-highest shadow-sm px-page shrink-0 z-10"
      },
      "children": [
        "topNavLeftZone",
        "topNavRightZone"
      ]
    },
    {
      "id": "bodyLayoutContainer",
      "component": "div",
      "props": {
        "className": "flex flex-row flex-1 overflow-hidden"
      },
      "children": [
        "sideNavMenuSlot",
        "mainContentSlot"
      ]
    },
    {
      "id": "sideNavMenuSlot",
      "component": "aside",
      "props": {
        "className": "w-60 bg-surface-container-highest flex flex-col shrink-0 overflow-y-auto border-r border-divider"
      },
      "children": [
        "sideNavMenu"
      ]
    },
    {
      "id": "mainContentSlot",
      "component": "main",
      "props": {
        "className": "flex-1 flex flex-col p-page overflow-y-auto bg-surface-container-lowest"
      },
      "children": [
        "mainContBreadcrumb",
        "mainContOverviewCard",
        "mainContRfListCard"
      ]
    },
    {
      "id": "topNavLeftZone",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "topNavBrandLogo",
        "topNavBrandName",
        "topNavBrandDivider",
        "topNavPrimaryMenu"
      ]
    },
    {
      "id": "topNavBrandLogo",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/brandInfo/logoIcon"
        },
        "color": "primary",
        "shape": "square",
        "className": "w-8 h-8"
      }
    },
    {
      "id": "topNavBrandName",
      "component": "span",
      "props": {
        "value": {
          "path": "/brandInfo/brandName"
        },
        "className": "text-lg font-semibold text-on-surface whitespace-nowrap"
      }
    },
    {
      "id": "topNavBrandDivider",
      "component": "div",
      "props": {
        "className": "w-px h-6 bg-border-base mx-1"
      }
    },
    {
      "id": "topNavPrimaryMenu",
      "component": "Menu",
      "props": {
        "mode": "horizontal",
        "selectedKeys": {
          "path": "/selectedNavKeys"
        },
        "items": {
          "path": "/primaryNav"
        },
        "className": "ml-2"
      }
    },
    {
      "id": "topNavRightZone",
      "component": "div",
      "props": {
        "className": "flex items-center gap-4 ml-auto"
      },
      "children": [
        "topNavSunIcon",
        "topNavBellBadge",
        "topNavUsersIcon",
        "topNavHomeBtn"
      ]
    },
    {
      "id": "topNavSunIcon",
      "component": "Icon",
      "props": {
        "name": "sun",
        "color": "default",
        "shape": "outline",
        "className": "w-5 h-5 cursor-pointer"
      }
    },
    {
      "id": "topNavBellBadge",
      "component": "Badge",
      "props": {
        "count": {
          "path": "/actionIcons/1/notificationCount"
        },
        "overflowCount": 99
      },
      "children": [
        "topNavBellIcon"
      ]
    },
    {
      "id": "topNavBellIcon",
      "component": "Icon",
      "props": {
        "name": "bell",
        "color": "default",
        "shape": "outline",
        "className": "w-5 h-5 cursor-pointer"
      }
    },
    {
      "id": "topNavUsersIcon",
      "component": "Icon",
      "props": {
        "name": "users",
        "color": "default",
        "shape": "outline",
        "className": "w-5 h-5 cursor-pointer"
      }
    },
    {
      "id": "topNavHomeBtn",
      "component": "Button",
      "props": {
        "value": {
          "path": "/homeButton/buttonText"
        },
        "types": "default",
        "shape": "round"
      }
    },
    {
      "id": "sideNavMenu",
      "component": "Menu",
      "props": {
        "mode": "vertical",
        "inlineCollapsed": false,
        "selectedKeys": {
          "path": "/selectedMenuKeys"
        },
        "items": {
          "path": "/sideMenuItems"
        },
        "className": "h-full w-full border-none"
      }
    },
    {
      "id": "mainContBreadcrumb",
