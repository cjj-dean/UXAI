          "xAxis": {
            "data": "month"
          },
          "yAxisTitle": "设备数量",
          "smooth": true,
          "color": [
            "#2070F3",
            "#62B42E"
          ]
        },
        "className": "w-full h-80"
      }
    },
    {
      "id": "contentChartsRow",
      "component": "div",
      "props": {
        "className": "grid grid-cols-2 gap-4 mt-6"
      },
      "children": [
        "contentIndustryCard",
        "contentGrowthCard"
      ]
    },
    {
      "id": "contentIndustryCard",
      "component": "div",
      "props": {
        "className": "bg-surface-container-highest rounded-xl shadow-card p-6"
      },
      "children": [
        "contentIndustryHeader",
        "contentIndustryChart"
      ]
    },
    {
      "id": "contentIndustryHeader",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between mb-4"
      },
      "children": [
        "contentIndustryTitle",
        "contentIndustryChartType"
      ]
    },
    {
      "id": "contentIndustryTitle",
      "component": "span",
      "props": {
        "value": {
          "path": "/leftChart/cardTitle"
        },
        "className": "text-base font-semibold text-on-surface"
      }
    },
    {
      "id": "contentIndustryChartType",
      "component": "Tag",
      "props": {
        "value": {
          "path": "/leftChart/chartType"
        },
        "size": "small",
        "color": "processing"
      }
    },
    {
      "id": "contentIndustryChart",
      "component": "BarChart",
      "props": {
        "option": {
          "data": {
            "path": "/leftChart/industryRankingData"
          },
          "direction": "horizontal",
          "xAxis": {
            "data": "industryName"
          },
          "yAxisTitle": "设备数量（台）",
          "color": [
            "#2070F3"
          ]
        },
        "className": "w-full h-72"
      }
    },
    {
      "id": "contentGrowthCard",
      "component": "div",
      "props": {
        "className": "bg-surface-container-highest rounded-xl shadow-card p-6"
      },
      "children": [
        "contentGrowthHeader",
        "contentGrowthChart"
      ]
    },
    {
      "id": "contentGrowthHeader",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between mb-4"
      },
      "children": [
        "contentGrowthTitle",
        "contentGrowthChartType"
      ]
    },
    {
      "id": "contentGrowthTitle",
      "component": "span",
      "props": {
        "value": {
          "path": "/rightChart/cardTitle"
        },
        "className": "text-base font-semibold text-on-surface"
      }
    },
    {
      "id": "contentGrowthChartType",
      "component": "Tag",
      "props": {
        "value": {
          "path": "/rightChart/chartType"
        },
        "size": "small",
        "color": "processing"
      }
    },
    {
      "id": "contentGrowthChart",
      "component": "BarChart",
      "props": {
        "option": {
          "data": {
            "path": "/rightChart/monthlyGrowthData"
          },
          "xAxis": {
            "data": "month"
          },
          "yAxisTitle": "数量",
          "color": [
            "#715AFB",
            "#F69E39"
          ]
        },
        "className": "w-full h-72"
      }
    },
    {
      "id": "contentActivitiesCard",
      "component": "div",
      "props": {
        "className": "bg-surface-container-highest rounded-xl shadow-card p-6 mt-6"
      },
      "children": [
        "contentActivitiesHeader",
        "contentActivitiesTimeline"
      ]
    },
    {
      "id": "contentActivitiesHeader",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between mb-4"
      },
      "children": [
        "contentActivitiesTitle",
        "contentActivitiesMore"
      ]
    },
    {
      "id": "contentActivitiesTitle",
      "component": "span",
      "props": {
        "value": {
          "path": "/activitiesCardTitle"
        },
        "className": "text-base font-semibold text-on-surface"
      }
    },
    {
      "id": "contentActivitiesMore",
      "component": "span",
      "props": {
        "value": "查看全部 →",
        "className": "text-sm text-primary cursor-pointer"
      }
    },
    {
      "id": "contentActivitiesTimeline",
      "component": "Timeline",
      "props": {
        "orientation": "vertical"
      },
      "children": {
        "path": "/activities",
        "componentId": "contentActivityItem"
      }
    },
    {
      "id": "contentActivityItem",
      "component": "TimelineItem",
      "props": {
        "title": {
          "path": "tenantName"
        },
        "icon": "clock",
        "color": "primary",
        "content": {
          "componentId": "contentActivityContent"
        }
      }
    },
    {
      "id": "contentActivityContent",
      "component": "div",
      "props": {
        "className": "flex items-start gap-3"
      },
      "children": [
        "activityAvatar",
        "activityTextWrap"
      ]
    },
    {
      "id": "activityAvatar",
      "component": "img",
      "props": {
        "src": {
          "path": "operatorAvatarImage"
        },
        "className": "w-9 h-9 rounded-full object-cover shrink-0"
      }
    },
    {
      "id": "activityTextWrap",
      "component": "div",
      "props": {
        "className": "flex-1 flex flex-col gap-1.5"
      },
      "children": [
        "activityActionText",
        "activityMetaRow"
      ]
    },
    {
      "id": "activityActionText",
      "component": "span",
      "props": {
        "value": {
          "path": "action"
        },
        "className": "text-sm text-on-surface"
      }
    },
    {
      "id": "activityMetaRow",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "activityTenantIdTag",
        "activityTimestampText"
      ]
    },
    {
      "id": "activityTenantIdTag",
      "component": "Tag",
      "props": {
        "value": {
          "path": "tenantId"
        },
        "size": "small",
        "color": "default"
      }
    },
    {
      "id": "activityTimestampText",
      "component": "span",
      "props": {
        "value": {
          "path": "timestamp"
        },
        "className": "text-xs text-on-surface-variant"
      }
    }
  ]
}