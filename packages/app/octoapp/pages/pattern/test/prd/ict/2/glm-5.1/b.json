  "rootId": "appRoot",
  "elements": [
    {
      "id": "appRoot",
      "component": "div",
      "props": {
        "className": "flex flex-col min-h-screen bg-surface-container-lowest"
      },
      "children": [
        "headerNavBar",
        "bodyContainer",
        "footerSection"
      ]
    },
    {
      "id": "headerNavBar",
      "component": "div",
      "props": {
        "className": "flex items-center h-14 px-4 bg-inverse-surface shadow-md"
      },
      "children": [
        "headerBrandSection",
        "headerNavTabsWrapper",
        "headerRightSection"
      ]
    },
    {
      "id": "headerBrandSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 shrink-0"
      },
      "children": [
        "headerBrandImg",
        "headerBrandText"
      ]
    },
    {
      "id": "headerBrandImg",
      "component": "img",
      "props": {
        "src": {
          "path": "/brandInfo/brandIcon"
        },
        "alt": "iMasterCloud Logo",
        "className": "w-8 h-8 rounded-lg"
      }
    },
    {
      "id": "headerBrandText",
      "component": "span",
      "props": {
        "className": "text-inverse-on-surface font-bold text-lg",
        "value": {
          "path": "/brandInfo/brandName"
        }
      }
    },
    {
      "id": "headerNavTabsWrapper",
      "component": "div",
      "props": {
        "className": "flex-1 flex justify-center"
      },
      "children": [
        "headerNavTabs"
      ]
    },
    {
      "id": "headerNavTabs",
      "component": "Tabs",
      "props": {
        "activeKey": {
          "path": "/activeTab"
        },
        "className": "[&_.ant-tabs-nav]:bg-inverse-surface [&_.ant-tabs-tab]:text-inverse-on-surface-variant [&_.ant-tabs-tab-active]:text-inverse-on-surface",
        "size": "medium"
      },
      "children": {
        "path": "/mainTabs",
        "componentId": "headerNavTabItem"
      }
    },
    {
      "id": "headerNavTabItem",
      "component": "TabItem",
      "props": {
        "key": {
          "path": "tabId"
        },
        "label": {
          "path": "tabName"
        }
      }
    },
    {
      "id": "headerRightSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-1 shrink-0"
      },
      "children": [
        "headerRightActions",
        "headerUserDivider",
        "headerUserSection"
      ]
    },
    {
      "id": "headerRightActions",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": {
        "path": "/rightActions",
        "componentId": "headerRightActionItem"
      }
    },
    {
      "id": "headerRightActionItem",
      "component": "div",
      "props": {
        "className": "flex items-center gap-1 cursor-pointer hover:opacity-80 transition-opacity"
      },
      "children": [
        "headerRightActionIcon",
        "headerRightActionName"
      ]
    },
    {
      "id": "headerRightActionIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "actionIcon"
        },
        "color": "default",
        "shape": "outline",
        "className": "w-4 h-4"
      }
    },
    {
      "id": "headerRightActionName",
      "component": "span",
      "props": {
        "className": "text-sm text-inverse-on-surface-variant",
        "value": {
          "path": "actionName"
        }
      }
    },
    {
      "id": "headerUserDivider",
      "component": "div",
      "props": {
        "className": "w-px h-5 bg-inverse-on-surface-variant opacity-30 mx-2"
      }
    },
    {
      "id": "headerUserSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 cursor-pointer"
      },
      "children": [
        "headerUserAvatar",
        "headerUserName"
      ]
    },
    {
      "id": "headerUserAvatar",
      "component": "img",
      "props": {
        "src": {
          "path": "/userInfo/userAvatarImage"
        },
        "alt": "User Avatar",
        "className": "w-8 h-8 rounded-full object-cover"
      }
    },
    {
      "id": "headerUserName",
      "component": "span",
      "props": {
        "className": "text-sm text-inverse-on-surface font-medium",
        "value": {
          "path": "/userInfo/userName"
        }
      }
    },
    {
      "id": "bodyContainer",
      "component": "div",
      "props": {
        "className": "flex flex-1 overflow-hidden"
      },
      "children": [
        "sidebarContainer",
        "contentContainer"
      ]
    },
    {
      "id": "sidebarContainer",
      "component": "div",
      "props": {
        "className": "w-56 shrink-0 bg-surface-container-highest flex flex-col shadow-sm border-r border-divider overflow-y-auto"
      },
      "children": [
        "sidebarTitleRow",
        "sidebarCollapse",
        "sidebarFooter"
