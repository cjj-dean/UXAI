        {
            "id": "globalHeader",
            "component": "header",
            "props": {
                "className": "flex items-center justify-between px-gutter h-14 bg-surface-container-highest shadow-sm z-10"
            },
            "children": [
                "headerLeft",
                "headerCenter",
                "headerRight"
            ]
        },
        {
            "id": "headerLeft",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": [
                "headerLogo",
                "headerBrandName"
            ]
        },
        {
            "id": "headerLogo",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "/brand/logoIcon"
                },
                "color": "primary",
                "className": "w-6 h-6"
            }
        },
        {
            "id": "headerBrandName",
            "component": "span",
            "props": {
                "className": "text-lg font-bold text-on-surface",
                "value": {
                    "path": "/brand/brandName"
                }
            }
        },
        {
            "id": "headerCenter",
            "component": "div",
            "props": {
                "className": "flex-1 flex justify-center"
            },
            "children": [
                "headerTabs"
            ]
        },
        {
            "id": "headerTabs",
            "component": "Tabs",
            "props": {
                "activeKey": {
                    "path": "/activeTab"
                },
                "className": "h-full"
            },
            "children": {
                "path": "/navTabs",
                "componentId": "navTabItem"
            }
        },
        {
            "id": "navTabItem",
            "component": "TabItem",
            "props": {
                "key": {
                    "path": "id"
                },
                "label": {
                    "path": "label"
                },
                "icon": {
                    "path": "icon"
                }
            }
        },
        {
            "id": "headerRight",
            "component": "div",
            "props": {
                "className": "flex items-center gap-4"
            },
            "children": [
                "headerLinks",
                "headerActions"
