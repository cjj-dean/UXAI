        {
            "id": "deviceCardTitle",
            "component": "div",
            "props": {
                "className": "text-md font-semibold mb-6",
                "value": "租户设备统计（总数64）"
            }
        },
        {
            "id": "deviceItemsGrid",
            "component": "div",
            "props": {
                "className": "flex justify-between items-center"
            },
            "children": {
                "path": "/topMetrics/deviceStats",
                "componentId": "deviceStatItem"
            }
        },
        {
            "id": "deviceStatItem",
            "component": "div",
            "props": {
                "className": "flex flex-col items-center gap-2"
            },
            "children": [
                "deviceIcon",
                "deviceValue",
                "deviceName"
            ]
        },
        {
            "id": "deviceIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "icon"
                },
                "shape": "square",
                "className": "w-8 h-8 text-primary"
            }
        },
        {
            "id": "deviceValue",
            "component": "span",
            "props": {
                "className": "text-xl font-bold",
                "value": {
                    "path": "value"
                }
            }
        },
        {
            "id": "deviceName",
            "component": "span",
            "props": {
                "className": "text-xs text-on-surface-variant",
                "value": {
                    "path": "name"
                }
            }
        },
        {
            "id": "growthChartCard",
            "component": "div",
            "props": {
                "className": "bg-surface-container-highest rounded-xl shadow-card p-inset"
            },
            "children": [
                "growthChartTitle",
                "growthChart"
            ]
        },
        {
            "id": "growthChartTitle",
            "component": "div",
            "props": {
                "className": "text-md font-semibold mb-4",
                "value": "设备类型月度增长分布"
            }
        },
        {
            "id": "growthChart",
            "component": "LineChart",
            "props": {
                "option": {
                    "data": {
                        "path": "/monthlyGrowthData"
                    },
                    "xAxis": {
                        "data": "month"
                    },
                    "yAxisTitle": "设备数量",
                    "area": true,
                    "smooth": true
                },
                "className": "h-80 w-full"
            }
        },
        {
            "id": "bottomChartsRow",
            "component": "div",
            "props": {
                "className": "flex gap-gutter"
            },
            "children": [
                "industryCard",
                "yearlyGrowthCard"
            ]
        },
        {
            "id": "industryCard",
            "component": "div",
            "props": {
                "className": "w-1/4 bg-surface-container-highest rounded-xl shadow-card p-inset"
