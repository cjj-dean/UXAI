            ]
        },
        {
            "id": "yearlyTitle",
            "component": "div",
            "props": {
                "className": "text-md font-semibold mb-4",
                "value": "2023年租户月度增长趋势图"
            }
        },
        {
            "id": "yearlyChart",
            "component": "LineChart",
            "props": {
                "option": {
                    "data": {
                        "path": "/yearlyGrowth"
                    },
                    "xAxis": {
                        "data": "month"
                    },
                    "yAxisTitle": "租户总数",
                    "area": true,
                    "color": [
                        "#2070F3"
                    ]
