        {
            "id": "industryTitle",
            "component": "div",
            "props": {
                "className": "text-md font-semibold mb-4",
                "value": "租户行业top5"
            }
        },
        {
            "id": "industryChart",
            "component": "BarChart",
            "props": {
                "option": {
                    "data": {
                        "path": "/industryTop5"
                    },
                    "xAxis": {
                        "data": "industry"
                    },
                    "yAxisTitle": "租户数",
                    "direction": "horizontal"
                },
                "className": "h-64 w-full"
            }
        },
        {
            "id": "yearlyGrowthCard",
            "component": "div",
            "props": {
                "className": "w-3/4 bg-surface-container-highest rounded-xl shadow-card p-inset"
