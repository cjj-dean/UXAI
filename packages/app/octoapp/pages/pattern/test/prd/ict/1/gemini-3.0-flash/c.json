                    "path": "groupName"
                }
            }
        },
        {
            "id": "groupItems",
            "component": "div",
            "props": {
                "className": "flex flex-col gap-1"
            },
            "children": {
                "path": "items",
                "componentId": "menuItem"
            }
        },
        {
            "id": "menuItem",
            "component": "div",
            "props": {
                "className": "flex items-center gap-3 px-3 py-2 rounded-md transition-colors cursor-pointer hover:bg-surface-variant"
            },
            "children": [
                "menuItemIcon",
                "menuItemLabel"
            ]
        },
        {
            "id": "menuItemIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "icon"
                },
                "className": "w-4 h-4"
            }
        },
        {
            "id": "menuItemLabel",
            "component": "span",
            "props": {
                "className": "text-sm",
                "value": {
                    "path": "label"
                }
            }
        },
        {
            "id": "sideNavFooter",
            "component": "div",
            "props": {
                "className": "p-4 border-t border-divider flex justify-center"
