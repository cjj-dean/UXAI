        {
            "id": "collapseBtn",
            "component": "Icon",
            "props": {
                "name": "chevron-left",
                "className": "w-5 h-5 text-on-surface-variant cursor-pointer"
            }
        },
        {
            "id": "contentArea",
            "component": "main",
            "props": {
                "className": "flex-1 overflow-y-auto p-gutter flex flex-col gap-gutter"
