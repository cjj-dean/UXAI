    "rootId": "appContainer",
    "elements": [
        {
            "id": "appContainer",
            "component": "div",
            "props": {
                "className": "flex flex-col h-screen bg-surface-container-lowest"
            },
            "children": [
                "globalHeader",
                "mainLayout"
            ]
