            ]
        },
        {
            "id": "managementSearchZone",
            "component": "div",
            "props": {
                "className": "w-80"
            },
            "children": [
                "managementSearchInput"
            ]
        },
        {
            "id": "managementSearchInput",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/sliceSearch"
                },
                "placeholder": "搜索切片名称或ID...",
                "prefix": "search"
            }
        },
        {
            "id": "managementActionZone",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": [
                "refreshBtn",
                "exportBtn",
                "addLinkBtn"
            ]
        },
        {
            "id": "refreshBtn",
            "component": "Button",
            "props": {
                "icon": "refresh-cw",
                "shape": "default"
            }
        },
        {
            "id": "exportBtn",
            "component": "Button",
            "props": {
                "icon": "external-link",
                "value": "导出"
            }
        },
        {
            "id": "addLinkBtn",
            "component": "Button",
            "props": {
                "color": "primary",
                "icon": "plus",
                "value": "添加链路",
                "iconPlacement": "start"
            }
        },
        {
            "id": "managementTable",
            "component": "Table",
            "props": {
                "rowKey": "id",
                "dataSource": {
                    "path": "/sliceData"
                },
                "columns": [
                    {
                        "title": "切片名称",
                        "dataIndex": "sliceName"
                    },
                    {
                        "title": "切片ID",
                        "dataIndex": "sliceId"
                    },
                    {
                        "title": "业务类型",
                        "dataIndex": "serviceType"
                    },
                    {
                        "title": "带宽(Gbps)",
                        "dataIndex": "bandwidth"
                    },
                    {
                        "title": "时延(ms)",
                        "dataIndex": "latency"
                    },
                    {
                        "title": "源端节点",
                        "dataIndex": "sourceNode"
                    },
                    {
                        "title": "宿端节点",
                        "dataIndex": "destNode"
                    },
                    {
                        "title": "创建时间",
                        "dataIndex": "createTime"
                    },
                    {
                        "title": "激活状态",
                        "dataIndex": "status",
                        "width": 100
                    },
                    {
                        "title": "操作",
                        "dataIndex": "actions",
                        "width": 150
                    }
                ]
            },
            "children": {
                "path": "/sliceData",
                "componentId": "managementTableRow"
            }
        },
        {
            "id": "managementTableRow",
            "component": "TableRow",
            "children": [
                "cellSliceName",
                "cellSliceId",
                "cellServiceType",
                "cellBandwidth",
                "cellLatency",
                "cellSource",
                "cellDest",
                "cellTime",
                "cellStatus",
                "cellActions"
            ]
        },
        {
            "id": "cellSliceName",
            "component": "span",
            "props": {
                "className": "text-on-surface font-medium",
                "value": {
                    "path": "sliceName"
                }
            }
        },
        {
            "id": "cellSliceId",
            "component": "span",
            "props": {
                "className": "text-on-surface-variant",
                "value": {
                    "path": "sliceId"
                }
            }
        },
        {
            "id": "cellServiceType",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "serviceType"
                },
                "variant": "outlined"
            }
        },
        {
            "id": "cellBandwidth",
            "component": "span",
            "props": {
                "value": {
                    "path": "bandwidth"
                }
            }
        },
        {
            "id": "cellLatency",
            "component": "span",
            "props": {
                "value": {
                    "path": "latency"
                }
            }
        },
        {
            "id": "cellSource",
            "component": "span",
            "props": {
                "value": {
                    "path": "sourceNode"
                }
            }
        },
        {
            "id": "cellDest",
            "component": "span",
            "props": {
                "value": {
                    "path": "destNode"
                }
            }
        },
        {
            "id": "cellTime",
            "component": "span",
            "props": {
                "className": "text-xs text-on-surface-variant",
                "value": {
                    "path": "createTime"
                }
            }
        },
        {
            "id": "cellStatus",
            "component": "div",
            "props": {
                "className": "flex"
            },
            "children": [
                "statusTag"
            ]
        },
        {
            "id": "statusTag",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "status"
                },
                "color": {
                    "path": "status"
                }
            }
        },
        {
            "id": "cellActions",
            "component": "div",
            "props": {
                "className": "flex items-center gap-3"
