        {
            "id": "actionEdit",
            "component": "Icon",
            "props": {
                "name": "edit",
                "className": "w-4 h-4 text-primary cursor-pointer",
                "shape": "outline"
            }
        },
        {
            "id": "actionFile",
            "component": "Icon",
            "props": {
                "name": "file-text",
                "className": "w-4 h-4 text-on-surface-variant cursor-pointer",
