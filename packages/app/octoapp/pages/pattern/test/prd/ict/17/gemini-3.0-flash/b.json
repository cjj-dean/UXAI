            }
        },
        {
            "id": "managementCard",
            "component": "div",
            "props": {
                "className": "bg-surface-container-highest rounded-container shadow-card p-inset flex flex-col gap-stack"
            },
            "children": [
                "managementHeader",
                "managementTable"
            ]
        },
        {
            "id": "managementHeader",
