            "children": {
                "path": "/actionIcons",
                "componentId": "headerActionIcon"
            }
        },
        {
            "id": "headerActionIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "iconName"
                },
                "className": "w-5 h-5 text-on-surface-variant cursor-pointer"
            }
        },
        {
            "id": "headerHomeBtn",
            "component": "Button",
            "props": {
                "value": "返回首页",
                "icon": "home",
                "shape": "round",
                "size": "small"
            }
        },
        {
            "id": "bodySection",
