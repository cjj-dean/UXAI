        {
            "id": "healthUpdateTime",
            "component": "span",
            "props": {
                "value": "更新时间：2023-10-27 14:30:05",
                "className": "text-xs text-on-surface-variant mt-1"
            }
        },
        {
            "id": "healthStatusRight",
            "component": "Button",
            "props": {
                "value": "深度优化",
                "color": "primary",
                "size": "medium"
            }
        },
        {
            "id": "healthMetricTable",
            "component": "div",
            "props": {
                "className": "grid grid-cols-2 gap-2"
            },
            "children": {
                "path": "/metricTable",
                "componentId": "metricItem"
            }
        },
        {
            "id": "metricItem",
            "component": "div",
            "props": {
                "className": "flex items-center gap-3 p-3 border border-divider rounded-md"
            },
            "children": [
                "metricIcon",
                "metricContent"
            ]
        },
        {
            "id": "metricIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "icon"
                },
                "className": "w-5 h-5 text-on-surface-variant"
            }
        },
        {
            "id": "metricContent",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "metricVal",
                "metricLabel"
            ]
        },
        {
            "id": "metricVal",
            "component": "span",
            "props": {
                "value": {
                    "path": "value"
                },
                "className": "text-lg font-bold"
            }
        },
        {
            "id": "metricLabel",
            "component": "span",
            "props": {
                "value": {
                    "path": "indicator"
                },
                "className": "text-xs text-on-surface-variant"
            }
        },
        {
            "id": "rfListCard",
            "component": "div",
            "props": {
                "className": "bg-surface-container-highest rounded-container shadow-card p-gutter"
            },
            "children": [
                "rfCardHeader",
                "rfCardToolbar",
                "rfTableComp"
            ]
        },
        {
            "id": "rfCardHeader",
            "component": "div",
            "props": {
                "className": "text-md font-bold mb-4",
                "value": "射频列表"
            }
        },
        {
            "id": "rfCardToolbar",
            "component": "div",
            "props": {
                "className": "flex items-center justify-between mb-4"
            },
            "children": [
                "rfSearchInput",
                "rfFreqFilter"
            ]
        },
        {
            "id": "rfSearchInput",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/searchVal"
                },
                "placeholder": "搜索AP名称、MAC或SN...",
                "prefix": "search",
                "className": "w-80"
            }
        },
        {
            "id": "rfFreqFilter",
            "component": "RadioGroup",
            "props": {
                "value": {
                    "path": "/freqVal"
                },
                "options": {
                    "path": "/freqOptions"
                },
                "optionType": "button",
                "size": "medium"
            }
        },
        {
            "id": "rfTableComp",
            "component": "Table",
            "props": {
                "rowKey": "id",
                "dataSource": {
                    "path": "/rfList"
                },
                "columns": [
                    {
                        "title": "AP名称",
                        "dataIndex": "apName"
                    },
                    {
                        "title": "MAC地址",
                        "dataIndex": "macAddress"
                    },
                    {
                        "title": "频段",
                        "dataIndex": "frequency"
                    },
                    {
                        "title": "信道",
                        "dataIndex": "channel"
                    },
                    {
                        "title": "功率",
                        "dataIndex": "power"
                    },
                    {
                        "title": "状态",
                        "dataIndex": "status",
                        "width": 100
                    },
                    {
                        "title": "利用率",
                        "dataIndex": "utilization"
                    },
                    {
                        "title": "干扰",
                        "dataIndex": "interference"
                    },
                    {
                        "title": "底噪",
                        "dataIndex": "noiseFloor"
                    },
                    {
                        "title": "重传率",
                        "dataIndex": "retransRate"
                    }
                ]
            },
            "children": {
                "path": "/rfList",
                "componentId": "rfTableRow"
            }
        },
        {
            "id": "rfTableRow",
            "component": "TableRow",
            "children": [
                "cellApName",
                "cellMac",
                "cellFreq",
                "cellChannel",
                "cellPower",
                "cellStatus",
                "cellUtil",
                "cellInter",
                "cellNoise",
                "cellRetrans"
            ]
        },
        {
            "id": "cellApName",
            "component": "span",
            "props": {
                "value": {
                    "path": "apName"
                },
                "className": "text-sm font-medium"
            }
        },
        {
            "id": "cellMac",
            "component": "span",
            "props": {
                "value": {
                    "path": "macAddress"
                },
                "className": "text-xs text-on-surface-variant"
            }
        },
        {
            "id": "cellFreq",
            "component": "span",
            "props": {
                "value": {
                    "path": "frequency"
                }
            }
        },
        {
            "id": "cellChannel",
            "component": "span",
            "props": {
                "value": {
                    "path": "channel"
                }
            }
        },
        {
            "id": "cellPower",
            "component": "span",
            "props": {
                "value": {
                    "path": "power"
                }
            }
        },
        {
            "id": "cellStatus",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "status"
                },
                "color": {
                    "path": "statusColor"
                },
                "variant": "filled"
            }
        },
        {
            "id": "cellUtil",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": [
                "dotUtil",
                "valUtil"
            ]
        },
        {
            "id": "dotUtil",
            "component": "Icon",
            "props": {
                "name": "circle",
                "color": {
                    "path": "utilizationLevel"
                },
                "shape": "fill",
                "className": "w-2 h-2"
            }
        },
        {
            "id": "valUtil",
            "component": "span",
            "props": {
                "value": {
                    "path": "utilization"
                }
            }
        },
        {
            "id": "cellInter",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": [
                "dotInter",
                "valInter"
            ]
        },
        {
            "id": "dotInter",
            "component": "Icon",
            "props": {
                "name": "circle",
                "color": {
                    "path": "interferenceLevel"
                },
                "shape": "fill",
                "className": "w-2 h-2"
            }
        },
        {
            "id": "valInter",
            "component": "span",
            "props": {
                "value": {
                    "path": "interference"
