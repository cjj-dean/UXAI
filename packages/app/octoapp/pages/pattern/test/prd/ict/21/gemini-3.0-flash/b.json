                "headerLogo",
                "headerTitle"
            ]
        },
        {
            "id": "headerLogo",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "/brand/logoIcon"
                },
                "color": "primary",
                "shape": "square",
                "className": "w-8 h-8"
            }
        },
        {
            "id": "headerTitle",
            "component": "span",
            "props": {
                "value": {
                    "path": "/brand/title"
                },
                "className": "text-lg font-bold text-on-surface"
            }
        },
        {
            "id": "headerCenter",
            "component": "nav",
            "props": {
                "className": "flex items-center gap-8"
            },
            "children": {
                "path": "/navMenus",
                "componentId": "navMenuItem"
            }
        },
        {
            "id": "navMenuItem",
            "component": "span",
            "props": {
                "value": {
                    "path": "label"
                },
                "className": "text-md cursor-pointer hover:text-primary transition-colors font-medium"
            }
        },
        {
            "id": "headerRight",
            "component": "div",
            "props": {
                "className": "flex items-center gap-4"
            },
            "children": [
                "headerIconGroup",
                "headerHomeBtn"
