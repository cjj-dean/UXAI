    "rootId": "mainLayout",
    "elements": [
        {
            "id": "mainLayout",
            "component": "div",
            "props": {
                "className": "flex flex-col h-screen bg-surface-container-lowest"
            },
            "children": [
                "headerSection",
                "bodySection"
            ]
        },
        {
            "id": "headerSection",
            "component": "header",
            "props": {
                "className": "flex items-center justify-between px-gutter h-14 bg-surface-container-highest shadow-sm z-10"
            },
            "children": [
                "headerLeft",
                "headerCenter",
                "headerRight"
            ]
        },
        {
            "id": "headerLeft",
            "component": "div",
            "props": {
