  "rootId": "rootContainer",
  "elements": [
    {
      "id": "rootContainer",
      "component": "div",
      "props": {
        "className": "min-h-screen bg-surface-container-lowest flex flex-col"
      },
      "children": [
        "headerNavBar",
        "mainContent"
      ]
    },
    {
      "id": "headerNavBar",
      "component": "div",
      "props": {
        "className": "sticky top-0 z-50 bg-surface-container-highest shadow-sm px-gutter py-3 flex items-center justify-between"
      },
      "children": [
        "headerLeft",
        "headerRight"
      ]
    },
    {
      "id": "headerLeft",
      "component": "div",
      "props": {
        "className": "flex items-center gap-gutter"
      },
      "children": [
        "headerBrandIcon",
        "headerBrandName",
        "headerNavDivider",
        "headerNavList"
      ]
    },
    {
      "id": "headerBrandIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/brandIcon"
        },
        "color": "primary",
        "shape": "fill",
        "className": "w-8 h-8"
      }
    },
    {
      "id": "headerBrandName",
      "component": "span",
      "props": {
        "value": {
          "path": "/brandName"
        },
        "className": "text-lg font-bold text-primary"
      }
    },
    {
      "id": "headerNavDivider",
      "component": "div",
      "props": {
        "className": "w-px h-6 bg-surface-dim"
      }
    },
    {
      "id": "headerNavList",
      "component": "div",
      "props": {
        "className": "flex items-center gap-1"
      },
      "children": [
        "headerActiveNavItem",
        "headerOtherNavLoop"
      ]
    },
    {
      "id": "headerActiveNavItem",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 px-3 py-2 rounded-action bg-primary-container text-primary"
      },
      "children": [
        "headerActiveNavIcon",
        "headerActiveNavLabel"
      ]
    },
    {
      "id": "headerActiveNavIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/activeNav/menuIcon"
        },
        "color": "primary",
        "shape": "outline",
        "className": "w-4 h-4"
      }
    },
    {
      "id": "headerActiveNavLabel",
      "component": "span",
      "props": {
        "value": {
          "path": "/activeNav/menuLabel"
        },
        "className": "text-sm font-semibold text-primary"
      }
    },
    {
      "id": "headerOtherNavLoop",
      "component": "div",
      "props": {
        "className": "flex items-center gap-1"
      },
      "children": {
        "path": "/otherNavs",
        "componentId": "headerOtherNavItem"
      }
    },
    {
      "id": "headerOtherNavItem",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 px-3 py-2 rounded-action hover:bg-surface-variant transition-colors cursor-pointer"
      },
      "children": [
        "headerOtherNavIcon",
        "headerOtherNavLabel"
      ]
    },
    {
      "id": "headerOtherNavIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "menuIcon"
        },
        "color": "default",
        "shape": "outline",
        "className": "w-4 h-4"
      }
    },
    {
      "id": "headerOtherNavLabel",
      "component": "span",
      "props": {
        "value": {
          "path": "menuLabel"
        },
        "className": "text-sm text-on-surface-variant"
      }
    },
    {
      "id": "headerRight",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "headerNotifyBtn",
        "headerHelpBtn",
        "headerUserDivider",
        "headerUserAvatar",
        "headerUserName"
      ]
    },
    {
      "id": "headerNotifyBtn",
      "component": "Button",
      "props": {
        "icon": "bell",
        "shape": "circle",
        "size": "small"
      }
    },
    {
      "id": "headerHelpBtn",
      "component": "Button",
      "props": {
        "icon": "circle-help",
        "shape": "circle",
        "size": "small"
      }
    },
    {
      "id": "headerUserDivider",
      "component": "div",
      "props": {
        "className": "w-px h-6 bg-surface-dim"
      }
    },
    {
      "id": "headerUserAvatar",
      "component": "img",
      "props": {
        "src": {
          "path": "/userAvatarImage"
        },
        "alt": "用户头像",
        "className": "w-8 h-8 rounded-full object-cover"
      }
    },
    {
      "id": "headerUserName",
      "component": "span",
      "props": {
        "value": {
          "path": "/userName"
        },
        "className": "text-sm font-medium text-on-surface"
      }
    },
    {
      "id": "mainContent",
      "component": "div",
      "props": {
        "className": "flex-1 p-gutter flex flex-col gap-section"
      },
      "children": [
        "kpiSection",
        "chartSection",
        "sliceManagementSection",
        "footerSection"
      ]
    },
    {
      "id": "kpiSection",
      "component": "div",
      "props": {
        "className": "grid grid-cols-4 gap-gutter"
      },
      "children": {
        "path": "/kpis",
        "componentId": "kpiCard"
      }
    },
    {
      "id": "kpiCard",
      "component": "div",
      "props": {
        "className": "bg-surface-container-highest rounded-container shadow-card p-gutter flex items-center gap-gutter"
      },
      "children": [
        "kpiCardIconArea",
        "kpiCardContent"
      ]
    },
    {
      "id": "kpiCardIconArea",
      "component": "div",
      "props": {
        "className": "w-12 h-12 rounded-lg bg-primary-container flex items-center justify-center shrink-0"
      },
      "children": [
        "kpiCardIcon"
      ]
    },
    {
      "id": "kpiCardIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "cardIcon"
        },
        "color": {
          "path": "semanticColor"
        },
        "shape": "outline",
        "className": "w-6 h-6"
      }
    },
    {
      "id": "kpiCardContent",
      "component": "div",
      "props": {
        "className": "flex-1 min-w-0"
      },
      "children": [
        "kpiCardTitle",
        "kpiCardMetrics"
      ]
    },
    {
      "id": "kpiCardTitle",
      "component": "span",
      "props": {
        "value": {
          "path": "cardTitle"
        },
        "className": "text-xs text-on-surface-variant block"
      }
    },
    {
      "id": "kpiCardMetrics",
      "component": "div",
      "props": {
        "className": "flex items-baseline gap-2 mt-1 flex-wrap"
      },
      "children": [
        "kpiCardValue",
        "kpiCardTrendWrap",
        "kpiComparisonText"
      ]
