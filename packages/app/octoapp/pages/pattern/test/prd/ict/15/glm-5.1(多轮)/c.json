        "mainTablePanel"
      ]
    },
    {
      "id": "mainTreePanel",
      "component": "div",
      "props": {
        "className": "w-72 flex-shrink-0 flex flex-col border-r border-divider p-inset"
      },
      "children": [
        "mainTreeSearchInput",
        "mainTree"
      ]
    },
    {
      "id": "mainTreeSearchInput",
      "component": "Input",
      "props": {
        "value": {
          "path": "/treeSearchValue"
        },
        "placeholder": "搜索网络节点",
        "prefix": "search",
        "className": "mb-gutter"
      }
    },
    {
      "id": "mainTree",
      "component": "Tree",
      "props": {
        "defaultExpandedKeys": {
          "path": "/expandedKeys"
        },
        "defaultSelectedKeys": {
          "path": "/selectedTreeKeys"
        },
        "options": {
          "path": "/treeOptions"
        },
        "className": "flex-1 overflow-auto"
      }
    },
    {
      "id": "mainTablePanel",
      "component": "div",
      "props": {
        "className": "flex-1 flex flex-col p-inset min-w-0"
      },
      "children": [
        "mainToolbar",
        "mainDataTable"
      ]
    },
    {
      "id": "mainToolbar",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between mb-gutter flex-shrink-0"
      },
      "children": [
        "mainTableSearchInput",
        "mainToolbarActions"
      ]
    },
    {
      "id": "mainTableSearchInput",
      "component": "Input",
      "props": {
        "value": {
          "path": "/tableSearchValue"
        },
        "placeholder": "输入名称搜索",
        "prefix": "search",
        "className": "w-60"
      }
    },
    {
      "id": "mainToolbarActions",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": [
        "mainBtnDelete",
        "mainBtnExport",
        "mainBtnImport",
        "mainBtnCreate"
      ]
    },
    {
      "id": "mainBtnDelete",
      "component": "Button",
      "props": {
        "value": "删除",
        "icon": "trash-2",
        "iconPlacement": "start"
      }
    },
    {
      "id": "mainBtnExport",
      "component": "Button",
      "props": {
        "value": "导出",
        "icon": "download",
        "iconPlacement": "start"
      }
    },
    {
      "id": "mainBtnImport",
      "component": "Button",
      "props": {
        "value": "导入",
        "icon": "upload",
        "iconPlacement": "start"
      }
    },
    {
      "id": "mainBtnCreate",
      "component": "Button",
      "props": {
        "value": "创建",
        "icon": "plus",
        "iconPlacement": "start",
        "color": "primary"
      }
    },
    {
      "id": "mainDataTable",
      "component": "Table",
      "props": {
        "rowKey": "id",
        "dataSource": {
          "path": "/tableDataSource"
        },
        "rowSelection": {
          "type": "checkbox",
          "selectedRowKeys": {
            "path": "/selectedRowKeys"
          }
        },
        "columns": [
          {
            "title": "模板名称",
            "dataIndex": "templateName",
            "minWidth": 280
          },
          {
            "title": "2.4G射频",
            "dataIndex": "radio2g",
            "width": 140,
            "align": "center"
          },
          {
            "title": "5G射频",
            "dataIndex": "radio5g",
            "width": 140,
            "align": "center"
          },
          {
            "title": "6G射频",
            "dataIndex": "radio6g",
            "width": 140,
            "align": "center"
          },
          {
            "title": "操作",
            "dataIndex": "actions",
            "width": 200,
            "align": "center",
            "fixed": "end"
          }
        ],
        "className": "flex-1"
      },
      "children": {
        "path": "/tableDataSource",
        "componentId": "mainTableRow"
      }
    },
    {
      "id": "mainTableRow",
      "component": "TableRow",
      "children": [
        "mainTableNameCell",
        "mainTable2gCell",
        "mainTable5gCell",
        "mainTable6gCell",
        "mainTableActionCell"
      ]
    },
    {
      "id": "mainTableNameCell",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "mainTableImg",
        "mainTableInfo"
      ]
    },
    {
      "id": "mainTableImg",
      "component": "img",
      "props": {
        "src": {
          "path": "templateName/previewImage"
        },
        "alt": "template",
        "className": "w-10 h-10 rounded-md object-cover flex-shrink-0"
      }
    },
    {
      "id": "mainTableInfo",
      "component": "div",
      "props": {
        "className": "flex flex-col min-w-0"
      },
      "children": [
        "mainTableTitle",
        "mainTableDesc"
      ]
    },
    {
      "id": "mainTableTitle",
      "component": "span",
      "props": {
        "value": {
          "path": "templateName/title"
        },
        "className": "text-md font-medium text-on-surface truncate"
      }
    },
    {
      "id": "mainTableDesc",
      "component": "span",
      "props": {
        "value": {
          "path": "templateName/description"
        },
        "className": "text-sm text-on-surface-variant truncate"
      }
    },
    {
      "id": "mainTable2gCell",
      "component": "span",
      "props": {
        "value": {
          "path": "radio2g"
        },
        "className": "text-md text-on-surface"
      }
    },
    {
      "id": "mainTable5gCell",
      "component": "span",
      "props": {
        "value": {
          "path": "radio5g"
        },
        "className": "text-md text-on-surface"
      }
    },
    {
      "id": "mainTable6gCell",
      "component": "span",
      "props": {
        "value": {
          "path": "radio6g"
        },
        "className": "text-md text-on-surface"
      }
    },
    {
      "id": "mainTableActionCell",
      "component": "div",
      "props": {
        "className": "flex items-center justify-center gap-2"
      },
      "children": [
        "mainBtnEdit",
        "mainBtnCopy",
        "mainBtnExportRow"
      ]
    },
    {
      "id": "mainBtnEdit",
      "component": "Button",
      "props": {
        "value": "编辑",
        "types": "link",
        "size": "small"
      }
    },
    {
      "id": "mainBtnCopy",
      "component": "Button",
      "props": {
        "value": "复制",
        "types": "link",
        "size": "small"
      }
    },
    {
      "id": "mainBtnExportRow",
      "component": "Button",
      "props": {
        "value": "导出",
        "types": "link",
        "size": "small"
      }
    }
  ]
}