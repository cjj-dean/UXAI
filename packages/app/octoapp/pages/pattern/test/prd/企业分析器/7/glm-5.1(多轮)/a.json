  "rootId": "appRoot",
  "elements": [
    {
      "id": "appRoot",
      "component": "div",
      "props": {
        "className": "flex flex-col w-full min-h-screen bg-surface-container-lowest"
      },
      "children": [
        "appHeaderSlot",
        "appMainContainer"
      ]
    },
    {
      "id": "appHeaderSlot",
      "component": "header",
      "props": {
        "className": "sticky top-0 z-20 flex-none bg-surface-container-highest shadow-sm"
      },
      "children": [
        "hdrPrimaryNav",
        "hdrControlBar"
      ]
    },
    {
      "id": "appMainContainer",
      "component": "main",
      "props": {
        "className": "flex-1 flex flex-col p-page gap-section overflow-y-auto"
      },
      "children": [
        "mainOverviewSlot",
        "mainDetailSlot"
      ]
    },
    {
      "id": "mainOverviewSlot",
      "component": "section",
      "props": {
        "className": "grid grid-cols-3 gap-section"
      },
      "children": [
        "ovwScoreCard",
        "ovwWeightedCard",
        "ovwTrendCard"
      ]
    },
    {
      "id": "mainDetailSlot",
      "component": "section",
      "props": {
        "className": "flex flex-col gap-section"
      },
      "children": [
        "svcSectionHeader",
        "svcCardsContainer"
      ]
    },
    {
      "id": "hdrPrimaryNav",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between h-12 px-page"
      },
      "children": [
        "hdrBrandSection",
        "hdrMainNav",
        "hdrActionsSection"
      ]
    },
    {
      "id": "hdrBrandSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": [
        "hdrBrandMenuIcon",
        "hdrBrandSystemName"
      ]
    },
    {
      "id": "hdrBrandMenuIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/brandMenuIcon"
        },
        "shape": "outline",
        "color": "default",
        "className": "w-6 h-6"
      }
    },
    {
      "id": "hdrBrandSystemName",
      "component": "span",
      "props": {
        "className": "text-md font-semibold text-on-surface whitespace-nowrap",
        "value": {
          "path": "/brandSystemName"
        }
      }
    },
    {
      "id": "hdrMainNav",
      "component": "Menu",
      "props": {
        "mode": "horizontal",
        "selectedKeys": {
          "path": "/selectedNavKeys"
        },
        "items": {
          "path": "/mainNavItems"
        },
        "className": "border-b-0"
      }
    },
    {
      "id": "hdrActionsSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "hdrSearchIcon",
        "hdrHelpIcon",
        "hdrSettingsIcon",
        "hdrUserDivider",
        "hdrUserAvatar"
      ]
    },
    {
      "id": "hdrSearchIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/searchIconName"
        },
        "shape": "outline",
        "color": "default",
        "className": "w-5 h-5"
      }
    },
    {
      "id": "hdrHelpIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/helpIconName"
        },
        "shape": "outline",
        "color": "default",
        "className": "w-5 h-5"
      }
    },
    {
      "id": "hdrSettingsIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/settingsIconName"
        },
        "shape": "outline",
        "color": "default",
        "className": "w-5 h-5"
      }
    },
    {
      "id": "hdrUserDivider",
      "component": "div",
      "props": {
        "className": "w-px h-5 bg-divider"
      }
    },
    {
      "id": "hdrUserAvatar",
      "component": "img",
      "props": {
        "src": {
          "path": "/userAvatarImage"
        },
        "alt": "User Avatar",
        "className": "w-7 h-7 rounded-full object-cover"
      }
    },
    {
      "id": "hdrControlBar",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between h-10 px-page border-t border-divider"
      },
      "children": [
        "hdrControlLeft",
        "hdrControlRight"
      ]
    },
    {
      "id": "hdrControlLeft",
      "component": "div",
      "props": {
        "className": "flex items-center gap-4"
      },
      "children": [
        "hdrControlTabs",
        "hdrSiteSelect",
        "hdrSystemSelect"
      ]
    },
    {
      "id": "hdrControlTabs",
      "component": "Tabs",
      "props": {
        "activeKey": {
          "path": "/controlActiveTab"
        },
        "size": "small"
      },
      "children": {
        "path": "/controlTabs",
        "componentId": "hdrControlTabItem"
      }
    },
    {
      "id": "hdrControlTabItem",
      "component": "TabItem",
      "props": {
        "key": {
          "path": "key"
        },
        "label": {
          "path": "label"
        },
        "content": ""
      }
    },
    {
      "id": "hdrSiteSelect",
      "component": "Select",
      "props": {
        "value": {
          "path": "/siteFilterValue"
        },
        "placeholder": "站点健康度",
        "options": {
          "path": "/siteFilterOptions"
        },
        "size": "small",
        "className": "w-36"
      }
    },
    {
      "id": "hdrSystemSelect",
      "component": "Select",
      "props": {
        "value": {
          "path": "/systemFilterValue"
        },
        "placeholder": "评估体系",
        "options": {
          "path": "/systemFilterOptions"
        },
        "size": "small",
        "className": "w-36"
      }
    },
    {
      "id": "hdrControlRight",
      "component": "div",
      "props": {
        "className": "flex items-center gap-1.5"
      },
      "children": [
        "hdrTimeIcon",
        "hdrTimeLabel"
      ]
    },
    {
      "id": "hdrTimeIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/timeIconName"
        },
        "shape": "outline",
        "color": "default",
        "className": "w-4 h-4"
      }
    },
    {
      "id": "hdrTimeLabel",
      "component": "span",
      "props": {
        "className": "text-sm text-on-surface-variant",
        "value": {
          "path": "/timeLabel"
