    {
      "id": "root",
      "component": "div",
      "props": {
        "className": "h-screen w-full flex flex-col bg-surface-container-lowest overflow-hidden"
      },
      "children": [
        "headerSlot",
        "filterSlot",
        "tableSlot",
        "paginationSlot"
      ]
    },
    {
      "id": "headerSlot",
      "component": "header",
      "props": {
        "className": "flex-shrink-0 h-12 bg-surface-container-highest shadow-sm z-10"
      },
      "children": [
        "gHeadLeftSection",
        "gHeadRightSection"
      ]
    },
    {
      "id": "filterSlot",
      "component": "section",
      "props": {
        "className": "flex-shrink-0 px-page pt-section pb-section"
      },
      "children": [
        "pFilterBreadcrumb",
        "pFilterAlertContainer",
        "pFilterToolbar"
      ]
    },
    {
      "id": "tableSlot",
      "component": "main",
      "props": {
        "className": "flex-1 min-h-0 overflow-y-auto px-page pb-page"
      },
      "children": [
        "mTableContainer"
      ]
    },
    {
      "id": "paginationSlot",
      "component": "footer",
      "props": {
        "className": "flex-shrink-0 h-16 bg-surface-container-highest shadow-sm border-t border-divider px-page flex items-center justify-between"
      },
      "children": [
        "fPaginStatsGroup",
        "fPaginControlsGroup"
      ]
    },
    {
      "id": "gHeadLeftSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3 flex-1 h-full pl-4"
      },
      "children": [
        "gHeadLogoIcon",
        "gHeadBrandTitle",
        "gHeadBrandSubtitle",
        "gHeadNavDivider",
        "gHeadNavMenu"
      ]
    },
    {
      "id": "gHeadLogoIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/brandInfo/logoIcon"
        },
        "color": "primary",
        "shape": "outline",
        "className": "w-5 h-5"
      }
    },
    {
      "id": "gHeadBrandTitle",
      "component": "span",
      "props": {
        "value": {
          "path": "/brandInfo/titleText"
        },
        "className": "text-lg font-bold text-on-surface whitespace-nowrap"
      }
    },
    {
      "id": "gHeadBrandSubtitle",
      "component": "span",
      "props": {
        "value": {
          "path": "/brandInfo/subtitleText"
        },
        "className": "text-md text-on-surface-variant whitespace-nowrap"
      }
    },
    {
      "id": "gHeadNavDivider",
      "component": "div",
      "props": {
        "className": "w-px h-5 bg-divider mx-1"
      }
    },
    {
      "id": "gHeadNavMenu",
      "component": "Menu",
      "props": {
        "mode": "horizontal",
        "selectedKeys": {
          "path": "/selectedMenuKeys"
        },
        "items": {
          "path": "/navMenus"
        },
        "className": "border-none h-full leading-[3rem]"
      }
    },
    {
      "id": "gHeadRightSection",
      "component": "div",
      "props": {
        "className": "flex items-center gap-4 h-full pr-4"
      },
      "children": [
