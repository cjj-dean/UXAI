        "className": "w-5 h-5"
      }
    },
    {
      "id": "gHeadSettingsIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "/globalActionIcons/2"
        },
        "color": "default",
        "shape": "outline",
        "className": "w-5 h-5"
      }
    },
    {
      "id": "gHeadQuestionIcon",
