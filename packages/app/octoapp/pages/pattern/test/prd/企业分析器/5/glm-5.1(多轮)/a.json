      "props": {
        "className": "w-px h-5 bg-divider"
      }
    },
    {
      "id": "gHeadUserDropdown",
      "component": "Dropdown",
      "props": {
        "placement": "bottomRight",
        "trigger": [
          "click"
        ],
        "menu": {
          "path": "/userDropdownMenu"
        }
      },
      "children": [
        "gHeadUserTrigger"
      ]
    },
    {
      "id": "gHeadUserTrigger",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 cursor-pointer"
      },
      "children": [
        "gHeadUserAvatar",
        "gHeadUserName",
        "gHeadUserChevron"
      ]
    },
    {
      "id": "gHeadUserAvatar",
      "component": "img",
      "props": {
        "src": {
          "path": "/userProfile/avatarImage"
        },
        "alt": "avatar",
        "className": "w-7 h-7 rounded-full object-cover"
      }
    },
    {
      "id": "gHeadUserName",
      "component": "span",
      "props": {
        "value": {
          "path": "/userProfile/userName"
        },
        "className": "text-md text-on-surface font-medium"
      }
    },
    {
      "id": "gHeadUserChevron",
      "component": "Icon",
      "props": {
        "name": "chevron-down",
        "shape": "outline",
        "className": "w-4 h-4",
        "color": "default"
      }
    },
    {
      "id": "pFilterBreadcrumb",
      "component": "Breadcrumb",
      "props": {
        "items": {
          "path": "/pathList"
        }
      }
    },
    {
      "id": "pFilterAlertContainer",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2 bg-error-container rounded-lg px-4 py-2.5 mt-section"
      },
      "children": [
        "pFilterAlertIcon",
        "pFilterAlertText",
        "pFilterAlertClose"
      ]
    },
    {
      "id": "pFilterAlertIcon",
      "component": "Icon",
      "props": {
        "name": "alert-circle",
        "color": "error",
        "shape": "outline",
        "className": "w-5 h-5 shrink-0"
      }
    },
    {
      "id": "pFilterAlertText",
      "component": "span",
      "props": {
        "className": "text-md text-on-error-container flex-1",
        "value": {
          "path": "/alertMessage"
        }
      }
    },
    {
      "id": "pFilterAlertClose",
      "component": "Icon",
      "props": {
        "name": "x",
        "color": "error",
        "shape": "outline",
        "className": "w-4 h-4 shrink-0 cursor-pointer"
      }
    },
    {
      "id": "pFilterToolbar",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between mt-section"
      },
      "children": [
        "pFilterTabs",
        "pFilterControls"
      ]
    },
    {
      "id": "pFilterTabs",
      "component": "Tabs",
      "props": {
        "activeKey": {
          "path": "/activeTab"
        }
      },
      "children": {
        "path": "/tabItems",
        "componentId": "pFilterTabItem"
      }
    },
    {
      "id": "pFilterTabItem",
      "component": "TabItem",
      "props": {
        "key": {
          "path": "key"
        },
        "label": {
          "path": "label"
        }
      }
    },
    {
      "id": "pFilterControls",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "pFilterNodeSelect",
        "pFilterSearchInput",
        "pFilterBtnGroup"
      ]
    },
    {
      "id": "pFilterNodeSelect",
      "component": "Select",
      "props": {
        "value": {
          "path": "/selectedNode"
        },
        "options": {
          "path": "/nodeOptions"
        },
        "className": "w-36"
      }
    },
    {
      "id": "pFilterSearchInput",
      "component": "Input",
      "props": {
        "value": {
          "path": "/searchValue"
        },
        "placeholder": {
          "path": "/searchPlaceholder"
        },
        "prefix": "search",
        "className": "w-64"
      }
    },
    {
      "id": "pFilterBtnGroup",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": {
        "path": "/actionButtons",
        "componentId": "pFilterActionBtn"
      }
    },
    {
      "id": "pFilterActionBtn",
      "component": "Button",
      "props": {
        "value": {
          "path": "btnLabel"
        },
        "color": {
          "path": "btnType"
        }
      }
    },
    {
      "id": "mTableContainer",
      "component": "div",
      "props": {
        "className": "bg-surface-container-highest rounded-container shadow-card overflow-hidden flex flex-col"
      },
      "children": [
        "mTableDevice",
        "mTableExpandedPanel"
      ]
    },
    {
      "id": "mTableDevice",
      "component": "Table",
      "props": {
        "rowKey": "deviceId",
        "dataSource": {
          "path": "/devices"
        },
        "pagination": false,
        "rowSelection": {
          "type": "checkbox",
          "selectedRowKeys": {
            "path": "/selectedKeys"
          }
        },
        "columns": [
          {
            "title": "",
            "dataIndex": "expandAction",
            "width": 48,
            "align": "center"
          },
          {
            "title": "设备名称",
            "dataIndex": "deviceName",
            "width": 150
          },
          {
            "title": "设备类型",
            "dataIndex": "deviceType",
            "width": 110
          },
          {
            "title": "源目IP及端口",
            "dataIndex": "ipPort",
            "width": 260
          },
          {
            "title": "所属业务",
            "dataIndex": "business",
            "width": 120
          },
          {
            "title": "协议类型",
            "dataIndex": "protocol",
            "width": 90,
            "align": "center"
          },
          {
            "title": "MAC地址标识",
            "dataIndex": "macAddress",
            "width": 150
          },
          {
            "title": "转发状态",
            "dataIndex": "forwardStatus",
            "width": 100,
            "align": "center"
          },
          {
            "title": "责任人",
            "dataIndex": "principal",
            "width": 110
          },
          {
            "title": "健康状态",
            "dataIndex": "healthStatus",
            "width": 110,
            "align": "center"
          },
          {
            "title": "操作",
            "dataIndex": "actions",
            "width": 150,
            "align": "center",
            "fixed": "end"
          }
        ],
        "className": "mb-0"
      },
      "children": {
        "path": "/devices",
        "componentId": "mTableRow"
      }
    },
    {
      "id": "mTableRow",
      "component": "TableRow",
      "children": [
        "mTableCellExpand",
        "mTableCellDeviceName",
        "mTableCellDeviceType",
        "mTableCellIpPort",
        "mTableCellBusiness",
        "mTableCellProtocol",
        "mTableCellMacAddress",
        "mTableCellForwardStatus",
        "mTableCellPrincipal",
        "mTableCellHealthStatus",
        "mTableCellActions"
      ]
    },
    {
      "id": "mTableCellExpand",
      "component": "Icon",
      "props": {
        "name": {
          "path": "expandIcon"
        },
        "color": "default",
        "shape": "outline",
        "className": "w-4 h-4"
      }
    },
    {
      "id": "mTableCellDeviceName",
      "component": "span",
      "props": {
