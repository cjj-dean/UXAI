                "options": [
                    {
                        "label": "全部类型",
                        "value": "all"
                    },
                    {
                        "label": "交换机",
                        "value": "switch"
                    }
                ],
                "className": "w-40"
            }
        },
        {
            "id": "mcaSearchInput",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/mcaSearchText"
                },
                "placeholder": "搜索设备名称或IP...",
                "prefix": "search",
                "className": "w-64"
            }
        },
        {
            "id": "mcaActionRight",
            "component": "div",
            "props": {
                "className": "flex gap-inline"
            },
            "children": [
                "mcaExportBtn",
                "mcaAddBtn"
            ]
        },
        {
            "id": "mcaExportBtn",
            "component": "Button",
            "props": {
                "value": "导出数据",
                "icon": "download"
            }
        },
        {
            "id": "mcaAddBtn",
            "component": "Button",
            "props": {
                "value": "新增设备",
                "color": "primary",
                "icon": "plus"
            }
        },
        {
            "id": "mcaDeviceTable",
            "component": "Table",
            "props": {
                "rowKey": "id",
                "dataSource": {
                    "path": "/mcaDeviceList"
                },
                "rowSelection": {
                    "type": "checkbox",
                    "selectedRowKeys": {
                        "path": "/mcaSelectedRowKeys"
                    }
                },
                "expandable": {
                    "expandedRowKeys": {
                        "path": "/mcaExpandedRowKeys"
                    }
                },
                "columns": [
                    {
                        "title": "设备名称",
                        "dataIndex": "deviceName",
                        "minWidth": 160
                    },
                    {
                        "title": "设备类型",
                        "dataIndex": "deviceType"
                    },
                    {
                        "title": "源目 IP 及端口",
                        "dataIndex": "networkPath",
                        "minWidth": 200
                    },
                    {
                        "title": "所属业务",
                        "dataIndex": "businessUnit"
                    },
                    {
                        "title": "协议",
                        "dataIndex": "protocol"
                    },
                    {
                        "title": "MAC 地址",
                        "dataIndex": "macAddress"
                    },
                    {
                        "title": "转发状态",
                        "dataIndex": "forwardStatus"
                    },
                    {
                        "title": "责任人",
                        "dataIndex": "owner"
                    },
                    {
                        "title": "健康状态",
                        "dataIndex": "healthStatus"
                    },
                    {
                        "title": "操作",
                        "dataIndex": "actions",
                        "fixed": "end",
                        "width": 150
                    }
                ]
            },
            "children": {
                "path": "/mcaDeviceList",
                "componentId": "mcaDeviceTableRow"
            }
        },
