            "children": [
                "mcaCellDeviceName",
                "mcaCellDeviceType",
                "mcaCellNetworkPath",
                "mcaCellBusinessUnit",
                "mcaCellProtocol",
                "mcaCellMac",
                "mcaCellForward",
                "mcaCellOwner",
                "mcaCellHealth",
                "mcaCellActions"
