            },
            "children": [
                "mcaSecondaryTabs",
                "mcaActionBar",
                "mcaDeviceTable"
            ]
        },
        {
            "id": "mcaSecondaryTabs",
            "component": "Tabs",
            "props": {
                "activeKey": {
                    "path": "/mcaActiveSecondaryTab"
                },
                "types": "line",
                "className": "mb-gutter"
            },
            "children": {
                "path": "/mcaSecondaryTabs",
                "componentId": "mcaSecondaryTabItem"
            }
        },
        {
            "id": "mcaSecondaryTabItem",
            "component": "TabItem",
            "props": {
                "key": {
                    "path": "key"
                },
                "label": {
                    "path": "label"
                }
            }
        },
        {
            "id": "mcaActionBar",
            "component": "div",
            "props": {
