            "children": [
                "mcaActionLeft",
                "mcaActionRight"
            ]
        },
        {
            "id": "mcaActionLeft",
            "component": "div",
            "props": {
                "className": "flex gap-inline"
            },
            "children": [
                "mcaTypeSelect",
                "mcaSearchInput"
            ]
        },
        {
            "id": "mcaTypeSelect",
            "component": "Select",
            "props": {
                "value": {
                    "path": "/mcaDeviceType"
