        {
            "id": "mcaResetBtn",
            "component": "Button",
            "props": {
                "value": "重置"
            }
        },
        {
            "id": "mcaQueryBtn",
            "component": "Button",
            "props": {
                "value": "查询",
                "color": "primary"
            }
        },
        {
            "id": "mcaDeviceListContainer",
            "component": "div",
            "props": {
