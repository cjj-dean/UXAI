    "rootId": "rootAppShell",
    "elements": [
        {
            "id": "rootAppShell",
            "component": "div",
            "props": {
                "className": "flex flex-col h-screen w-full bg-surface-container-lowest overflow-hidden"
            },
            "children": [
                "shellHeaderContainer",
                "shellBodyWrapper"
            ]
        },
        {
            "id": "shellHeaderContainer",
            "component": "header",
            "props": {
                "className": "h-12 w-full bg-surface-container-highest shadow-sm z-50 flex items-center px-page shrink-0"
            },
            "children": [
                "ghdrLeftSection",
                "ghdrCenterSection",
                "ghdrRightSection"
            ]
        },
        {
            "id": "shellBodyWrapper",
            "component": "div",
            "props": {
                "className": "flex flex-1 w-full overflow-hidden"
            },
            "children": [
                "shellSiderContainer",
                "shellMainScrollArea"
