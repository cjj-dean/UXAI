        },
        {
            "id": "shellSiderContainer",
            "component": "aside",
            "props": {
                "className": "w-64 h-full bg-surface-container-highest border-r border-divider shrink-0 overflow-y-auto flex flex-col"
            },
            "children": [
                "snavHeaderWrapper",
                "snavMenuBody"
            ]
        },
        {
            "id": "shellMainScrollArea",
            "component": "main",
            "props": {
                "className": "flex-1 h-full overflow-y-auto bg-surface-container-lowest"
            },
            "children": [
                "shellMainContentStack"
            ]
        },
        {
            "id": "shellMainContentStack",
            "component": "div",
            "props": {
                "className": "flex flex-col gap-section p-page min-h-full"
            },
            "children": [
                "shellMetricsSlot",
                "shellTableSlot"
            ]
        },
        {
            "id": "shellMetricsSlot",
            "component": "section",
            "props": {
                "className": "w-full shrink-0 flex flex-col gap-stack"
            },
            "children": [
                "rmetTitleText",
                "rmetMainContainer"
            ]
        },
        {
            "id": "shellTableSlot",
            "component": "section",
            "props": {
                "className": "w-full flex-1 bg-surface-container-highest rounded-container shadow-card overflow-hidden flex flex-col"
            },
            "children": [
                "sltbHeader",
                "sltbTableContainer"
            ]
        },
        {
            "id": "ghdrLeftSection",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2 shrink-0"
            },
            "children": [
                "ghdrLogoIcon",
                "ghdrBrandName"
            ]
        },
        {
            "id": "ghdrLogoIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "/ghdrBrand/logoIcon"
                },
                "color": "primary",
                "className": "w-6 h-6"
            }
        },
        {
            "id": "ghdrBrandName",
            "component": "span",
            "props": {
                "value": {
                    "path": "/ghdrBrand/platformName"
                },
                "className": "text-lg font-bold text-on-surface"
            }
        },
        {
            "id": "ghdrCenterSection",
            "component": "div",
            "props": {
                "className": "flex-1 flex justify-center px-gutter"
            },
            "children": [
                "ghdrTopMenu"
            ]
        },
        {
            "id": "ghdrTopMenu",
            "component": "Menu",
            "props": {
                "mode": "horizontal",
                "selectedKeys": {
                    "path": "/ghdrNavSelected"
                },
                "items": {
                    "path": "/ghdrNavItems"
                },
                "className": "border-none bg-transparent"
            }
        },
        {
            "id": "ghdrRightSection",
            "component": "div",
            "props": {
                "className": "flex items-center gap-stack shrink-0"
            },
            "children": [
                "ghdrHelpBtn",
                "ghdrLangBtn",
                "ghdrUserWrapper"
            ]
        },
        {
            "id": "ghdrHelpBtn",
            "component": "Button",
            "props": {
                "icon": "help-circle",
                "types": "default",
                "className": "border-none shadow-none bg-transparent"
            }
        },
        {
            "id": "ghdrLangBtn",
            "component": "Button",
            "props": {
                "icon": "languages",
                "types": "default",
                "className": "border-none shadow-none bg-transparent"
            }
        },
        {
            "id": "ghdrUserWrapper",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2 ml-2 pl-2 border-l border-divider"
            },
            "children": [
                "ghdrUserAvatar",
                "ghdrUserName"
            ]
        },
        {
            "id": "ghdrUserAvatar",
            "component": "img",
            "props": {
                "src": {
                    "path": "/ghdrUserProfile/avatar"
                },
                "className": "w-8 h-8 rounded-full object-cover border border-divider"
            }
        },
        {
            "id": "ghdrUserName",
            "component": "span",
            "props": {
                "value": {
                    "path": "/ghdrUserProfile/name"
                },
                "className": "text-md font-medium text-on-surface-variant"
            }
        },
        {
            "id": "snavHeaderWrapper",
            "component": "div",
            "props": {
                "className": "px-inset py-stack flex items-center gap-inline border-b border-divider mb-stack"
            },
            "children": [
                "snavHeaderIcon",
                "snavHeaderTitle"
            ]
        },
        {
            "id": "snavHeaderIcon",
            "component": "Icon",
            "props": {
                "name": "layout-grid",
                "color": "primary",
                "shape": "square",
                "className": "w-8 h-8"
            }
        },
        {
            "id": "snavHeaderTitle",
            "component": "span",
            "props": {
                "value": {
                    "path": "/snavModuleTitle"
                },
                "className": "text-lg font-bold text-on-surface truncate"
            }
        },
        {
            "id": "snavMenuBody",
            "component": "Menu",
            "props": {
                "mode": "vertical",
                "selectedKeys": {
                    "path": "/snavSelectedKeys"
                },
                "openKeys": {
                    "path": "/snavOpenKeys"
                },
                "items": {
                    "path": "/snavMenuItems"
                },
                "className": "flex-1 border-none"
            }
        },
        {
            "id": "rmetTitleText",
            "component": "span",
            "props": {
                "value": {
                    "path": "/rmetCardTitle"
                },
                "className": "text-lg font-bold text-on-surface"
            }
        },
        {
            "id": "rmetMainContainer",
            "component": "div",
            "props": {
                "className": "bg-surface-container-highest rounded-container shadow-card p-inset w-full"
            },
            "children": [
                "rmetGroupsWrapper"
            ]
        },
        {
            "id": "rmetGroupsWrapper",
            "component": "div",
            "props": {
                "className": "flex flex-row flex-wrap gap-gutter justify-start items-start"
            },
            "children": {
                "path": "/rmetMetricGroups",
                "componentId": "rmetGroupItem"
            }
        },
        {
            "id": "rmetGroupItem",
            "component": "div",
            "props": {
                "className": "flex items-start gap-inset p-gutter bg-transparent shrink-0"
            },
            "children": [
                "rmetGroupIllustration",
                "rmetGroupContentArea"
            ]
        },
        {
            "id": "rmetGroupIllustration",
            "component": "div",
            "props": {
                "className": "w-20 h-20 shrink-0 rounded-md overflow-hidden"
            },
            "children": [
                "rmetGroupImage"
            ]
        },
        {
            "id": "rmetGroupImage",
            "component": "img",
            "props": {
                "src": {
                    "path": "illustrationImage"
                },
                "className": "w-full h-full object-cover"
            }
        },
        {
            "id": "rmetGroupContentArea",
            "component": "div",
            "props": {
                "className": "flex-1 flex flex-col gap-stack items-start text-left"
            },
            "children": [
                "rmetGroupHeaderTitle",
                "rmetMetricsRow"
            ]
        },
        {
            "id": "rmetGroupHeaderTitle",
            "component": "span",
            "props": {
                "value": {
                    "path": "groupTitle"
                },
                "className": "text-md font-semibold text-on-surface-variant"
            }
        },
        {
            "id": "rmetMetricsRow",
            "component": "div",
            "props": {
                "className": "flex flex-wrap gap-x-gutter gap-y-inline justify-start"
            },
            "children": {
                "path": "metrics",
                "componentId": "rmetMetricDataBlock"
            }
        },
        {
            "id": "rmetMetricDataBlock",
            "component": "div",
            "props": {
                "className": "flex flex-row items-baseline gap-inline"
            },
            "children": [
                "rmetMetricValue",
                "rmetMetricUnit"
            ]
        },
        {
            "id": "rmetMetricValue",
            "component": "span",
            "props": {
                "value": {
                    "path": "value"
                },
                "className": "text-2xl font-bold text-on-surface"
            }
        },
        {
            "id": "rmetMetricUnit",
            "component": "span",
            "props": {
                "value": {
                    "path": "unit"
                },
                "className": "text-sm text-on-surface-variant"
            }
        },
        {
            "id": "sltbHeader",
            "component": "div",
            "props": {
                "className": "flex items-center justify-between px-inset py-stack border-b border-divider"
            },
            "children": [
                "sltbTitle",
                "sltbToolbar"
            ]
        },
        {
            "id": "sltbTitle",
            "component": "span",
            "props": {
                "value": {
                    "path": "/sltbCardTitle"
                },
                "className": "text-lg font-bold text-on-surface"
            }
        },
        {
            "id": "sltbToolbar",
            "component": "div",
            "props": {
                "className": "flex items-center gap-inline"
            },
            "children": [
                "sltbExportBtn",
                "sltbPrintBtn",
                "sltbRefreshBtn",
                "sltbAddBtn"
            ]
        },
        {
            "id": "sltbExportBtn",
            "component": "Button",
            "props": {
                "value": "导出",
                "icon": "download",
                "iconPlacement": "start"
            }
        },
        {
            "id": "sltbPrintBtn",
            "component": "Button",
            "props": {
                "value": "打印",
                "icon": "printer",
                "iconPlacement": "start"
            }
        },
        {
            "id": "sltbRefreshBtn",
            "component": "Button",
            "props": {
                "value": "刷新",
                "icon": "rotate-cw",
                "iconPlacement": "start"
            }
        },
        {
            "id": "sltbAddBtn",
            "component": "Button",
            "props": {
                "value": "新增设备",
                "color": "primary",
                "icon": "plus",
                "iconPlacement": "start"
            }
        },
        {
            "id": "sltbTableContainer",
            "component": "div",
            "props": {
                "className": "flex-1 p-gutter overflow-auto"
            },
            "children": [
                "sltbMainTable"
            ]
        },
        {
            "id": "sltbMainTable",
            "component": "Table",
            "props": {
                "rowKey": "deviceId",
                "dataSource": {
                    "path": "/sltbTableData"
                },
                "rowSelection": {
                    "type": "checkbox",
                    "selectedRowKeys": {
                        "path": "/sltbSelectedRowKeys"
                    }
                },
                "columns": [
                    {
                        "title": "设备ID",
                        "dataIndex": "deviceId",
                        "sort": true
                    },
                    {
                        "title": "设备名称",
                        "dataIndex": "deviceName",
                        "minWidth": 150
                    },
                    {
                        "title": "IP地址",
                        "dataIndex": "ipAddress"
                    },
                    {
                        "title": "所属机房",
                        "dataIndex": "room"
                    },
                    {
                        "title": "操作系统",
                        "dataIndex": "os"
                    },
                    {
                        "title": "运行状态",
                        "dataIndex": "status"
                    },
                    {
                        "title": "CPU负载",
                        "dataIndex": "cpuLoad"
                    },
                    {
                        "title": "内存使用",
                        "dataIndex": "memUsage"
                    },
                    {
                        "title": "磁盘容量",
                        "dataIndex": "diskCap"
                    },
                    {
                        "title": "网络吞吐",
                        "dataIndex": "network"
                    },
                    {
                        "title": "操作",
                        "dataIndex": "actions",
                        "fixed": "end",
                        "width": 100
                    }
                ]
            },
            "children": {
