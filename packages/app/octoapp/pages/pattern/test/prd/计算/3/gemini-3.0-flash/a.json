                }
            }
        },
        {
            "id": "ffTaskStatusGroup",
            "component": "div",
            "props": {
                "className": "flex items-center gap-inline"
            },
            "children": [
                "ffTaskIcon",
                "ffTaskBadge"
            ]
        },
        {
            "id": "ffTaskIcon",
            "component": "Icon",
            "props": {
                "name": "activity",
                "color": "primary",
                "className": "w-4 h-4"
            }
        },
        {
            "id": "ffTaskBadge",
            "component": "Badge",
            "props": {
                "count": {
                    "path": "/ffPendingTasks"
                },
                "color": "#0067D1"
            },
            "children": [
                "ffTaskLabel"
            ]
        },
        {
            "id": "ffTaskLabel",
            "component": "span",
            "props": {
                "className": "text-md text-on-surface-variant pr-2",
                "value": "待办任务"
            }
        },
        {
            "id": "ffActionSection",
            "component": "div",
            "props": {
                "className": "ml-auto flex items-center gap-stack"
            },
            "children": {
                "path": "/ffActionButtons",
                "componentId": "ffActionButtonItem"
            }
        },
        {
            "id": "ffActionButtonItem",
            "component": "Button",
            "props": {
                "color": {
                    "path": "type"
                },
                "value": {
                    "path": "label"
                }
            }
        }
    ]
}