        "pmcCellRelatedUser",
        "pmcCellHitCount",
        "pmcCellStatus",
        "pmcCellCreateTime",
        "pmcCellUpdateTime",
        "pmcCellDescription",
        "pmcCellActions"
      ]
    },
    {
      "id": "pmcCellPolicyName",
