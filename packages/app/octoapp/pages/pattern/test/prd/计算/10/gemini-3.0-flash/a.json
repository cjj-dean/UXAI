      "id": "pmcCellDestZone",
      "component": "span",
      "props": {
        "value": {
          "path": "destZone"
        }
      }
    },
    {
      "id": "pmcCellRelatedUser",
      "component": "span",
      "props": {
        "value": {
          "path": "relatedUser"
        }
      }
    },
    {
      "id": "pmcCellHitCount",
      "component": "span",
      "props": {
        "value": {
          "path": "hitCount"
        },
