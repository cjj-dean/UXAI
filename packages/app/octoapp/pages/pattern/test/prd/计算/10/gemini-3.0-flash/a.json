      },
      "children": [
        "pmcPolicyTable"
      ]
    },
    {
      "id": "pmcPolicyTable",
      "component": "Table",
      "props": {
        "rowKey": "id",
        "dataSource": {
          "path": "/pmcPolicyList"
        },
        "rowSelection": {
          "type": "checkbox",
          "selectedRowKeys": {
            "path": "/pmcSelectedKeys"
          }
        },
        "columns": [
          {
            "title": "策略名称",
            "dataIndex": "policyName",
            "minWidth": 200,
            "sort": true
          },
          {
            "title": "源安全域",
            "dataIndex": "sourceZone",
            "sort": true
          },
          {
            "title": "目的安全域",
            "dataIndex": "destZone",
            "sort": true
          },
          {
            "title": "关联用户",
            "dataIndex": "relatedUser",
            "sort": true
          },
          {
            "title": "命中次数",
            "dataIndex": "hitCount",
            "sort": true,
            "align": "center"
          },
          {
            "title": "状态",
            "dataIndex": "status",
            "sort": true
          },
          {
            "title": "创建时间",
            "dataIndex": "createTime",
            "sort": true
          },
          {
            "title": "更新时间",
            "dataIndex": "updateTime",
            "sort": true
          },
          {
            "title": "描述说明",
            "dataIndex": "description",
            "minWidth": 180
          },
          {
            "title": "操作",
            "dataIndex": "actions",
            "fixed": "end",
            "width": 160,
            "align": "center"
          }
        ],
        "className": "mb-stack"
      },
      "children": {
        "path": "/pmcPolicyList",
        "componentId": "pmcPolicyRow"
      }
    },
    {
      "id": "pmcPolicyRow",
      "component": "TableRow",
      "children": [
        "pmcCellPolicyName",
        "pmcCellSourceZone",
