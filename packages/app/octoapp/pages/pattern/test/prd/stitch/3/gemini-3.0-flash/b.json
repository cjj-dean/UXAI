                "logoText"
            ]
        },
        {
            "id": "logoIcon",
            "component": "Icon",
            "props": {
                "name": "shield-check",
                "color": "primary",
                "shape": "square",
                "className": "w-8 h-8"
            }
        },
        {
            "id": "logoText",
            "component": "span",
            "props": {
                "value": "Security Gate",
                "className": "text-lg font-bold text-on-surface"
            }
        },
        {
            "id": "navMenu",
            "component": "nav",
            "props": {
                "className": "flex items-center gap-6"
            },
            "children": {
                "path": "/navLinks",
                "componentId": "navItem"
            }
        },
        {
            "id": "navItem",
            "component": "a",
            "props": {
                "className": "text-md font-medium transition-colors hover:text-primary",
                "value": {
                    "path": "label"
                },
                "href": "#"
            }
        },
        {
            "id": "headerRight",
            "component": "div",
            "props": {
                "className": "flex items-center gap-4"
            },
            "children": [
                "headerIconBell",
                "headerIconSearch",
                "headerIconUser"
            ]
        },
        {
            "id": "headerIconBell",
            "component": "Icon",
            "props": {
                "name": "bell",
                "className": "w-5 h-5 text-on-surface-variant cursor-pointer"
            }
        },
        {
            "id": "headerIconSearch",
            "component": "Icon",
            "props": {
                "name": "search",
                "className": "w-5 h-5 text-on-surface-variant cursor-pointer"
            }
        },
        {
            "id": "headerIconUser",
            "component": "Icon",
            "props": {
                "name": "circle-user",
                "className": "w-5 h-5 text-on-surface-variant cursor-pointer"
            }
        },
        {
            "id": "mainContent",
            "component": "main",
            "props": {
                "className": "flex-1 p-gutter max-w-7xl mx-auto w-full flex flex-col gap-6"
            },
            "children": [
                "directoryHeader",
                "filterToolbar",
                "tableContainer"
            ]
        },
        {
            "id": "directoryHeader",
            "component": "div",
            "props": {
                "className": "flex justify-between items-end"
            },
            "children": [
                "headerTextGroup",
                "addUserBtn"
            ]
        },
        {
            "id": "headerTextGroup",
            "component": "div",
            "props": {
                "className": "flex flex-col gap-1"
            },
            "children": [
                "directoryTitle",
                "directoryDesc"
            ]
        },
        {
            "id": "directoryTitle",
            "component": "h1",
            "props": {
                "value": "User Directory",
                "className": "text-3xl font-bold text-on-surface"
            }
        },
        {
            "id": "directoryDesc",
            "component": "p",
            "props": {
                "value": "Manage your organization's user accounts, assign roles, and monitor access permissions across all departments.",
                "className": "text-md text-on-surface-variant max-w-2xl"
            }
        },
        {
            "id": "addUserBtn",
            "component": "Button",
            "props": {
                "value": "Add New User",
                "color": "primary",
                "icon": "user-plus",
                "iconPlacement": "start",
                "size": "large"
            }
        },
        {
            "id": "filterToolbar",
            "component": "div",
            "props": {
                "className": "bg-surface-container-highest p-4 rounded-container shadow-sm flex flex-wrap items-center gap-4"
            },
            "children": [
                "searchInput",
                "roleSelect",
                "deptSelect",
                "statusSelect",
                "clearBtn"
            ]
        },
        {
            "id": "searchInput",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/filters/search"
                },
                "placeholder": "Search by name or email...",
                "prefix": "search",
                "className": "w-72"
            }
        },
        {
            "id": "roleSelect",
            "component": "Select",
            "props": {
                "value": {
                    "path": "/filters/role"
                },
                "options": [
                    {
                        "label": "Role: All",
                        "value": "All"
                    },
                    {
                        "label": "Admin",
                        "value": "Admin"
                    },
                    {
                        "label": "Editor",
                        "value": "Editor"
                    }
                ],
                "className": "w-40"
            }
        },
        {
            "id": "deptSelect",
            "component": "Select",
            "props": {
                "value": {
                    "path": "/filters/dept"
                },
                "options": [
                    {
                        "label": "Department: All",
                        "value": "All"
                    },
                    {
                        "label": "Engineering",
                        "value": "Engineering"
                    },
                    {
                        "label": "Design",
                        "value": "Design"
                    }
                ],
                "className": "w-44"
            }
        },
        {
            "id": "statusSelect",
            "component": "Select",
            "props": {
                "value": {
                    "path": "/filters/status"
                },
                "options": [
                    {
                        "label": "Status: All",
                        "value": "All"
                    },
                    {
                        "label": "Active",
                        "value": "Active"
                    },
                    {
                        "label": "Inactive",
                        "value": "Inactive"
                    }
                ],
                "className": "w-40"
            }
        },
        {
            "id": "clearBtn",
            "component": "Button",
            "props": {
                "value": "Clear Filters",
                "icon": "x-circle",
                "className": "ml-auto"
            }
        },
        {
            "id": "tableContainer",
            "component": "div",
            "props": {
                "className": "bg-surface-container-highest rounded-container shadow-sm overflow-hidden"
            },
            "children": [
                "userTable",
                "tableFooter"
            ]
        },
        {
            "id": "userTable",
            "component": "Table",
            "props": {
                "rowKey": "id",
                "dataSource": {
                    "path": "/userList"
                },
                "pagination": false,
                "columns": [
                    {
                        "title": "Name",
                        "dataIndex": "name"
                    },
                    {
                        "title": "Role",
                        "dataIndex": "role"
                    },
                    {
                        "title": "Department",
                        "dataIndex": "dept"
                    },
                    {
                        "title": "Status",
                        "dataIndex": "status",
                        "width": 120
                    },
                    {
                        "title": "Last Login",
                        "dataIndex": "lastLogin"
                    },
                    {
                        "title": "Actions",
                        "dataIndex": "actions",
                        "width": 150,
                        "align": "right"
                    }
                ]
            },
            "children": {
                "path": "/userList",
                "componentId": "userTableRow"
            }
        },
        {
            "id": "userTableRow",
            "component": "TableRow",
            "children": [
                "cellName",
                "cellRole",
                "cellDept",
                "cellStatus",
