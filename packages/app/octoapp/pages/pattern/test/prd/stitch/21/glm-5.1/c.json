        "className": "text-sm text-on-surface-variant"
      }
    },
    {
      "id": "filterBarContainer",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3 bg-surface-container-highest rounded-container p-4 shadow-card flex-wrap"
      },
      "children": [
        "filterSearchInput",
        "filterCategorySelect",
        "filterPriceWrap",
        "filterSwitchWrap",
        "filterActionBtn"
      ]
    },
    {
      "id": "filterSearchInput",
      "component": "Input",
      "props": {
        "value": {
          "path": "/filterSearchValue"
        },
        "placeholder": "搜索产品名称或SKU ID...",
        "prefix": "search",
        "className": "w-56"
      }
    },
    {
      "id": "filterCategorySelect",
      "component": "Select",
      "props": {
        "value": {
          "path": "/filterCategory"
        },
        "placeholder": "所有分类",
        "options": {
          "path": "/categoryOptions"
        },
        "className": "w-40"
      }
    },
    {
      "id": "filterPriceWrap",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": [
        "filterMinPrice",
        "filterPriceSep",
        "filterMaxPrice"
      ]
    },
    {
      "id": "filterMinPrice",
      "component": "InputNumber",
      "props": {
        "value": {
          "path": "/filterMinPrice"
        },
        "placeholder": "Min",
        "controls": false,
        "className": "w-24"
      }
    },
    {
      "id": "filterPriceSep",
      "component": "span",
      "props": {
        "value": "-",
        "className": "text-on-surface-variant text-sm"
      }
    },
    {
      "id": "filterMaxPrice",
      "component": "InputNumber",
      "props": {
        "value": {
          "path": "/filterMaxPrice"
        },
        "placeholder": "Max",
        "controls": false,
        "className": "w-24"
      }
    },
    {
      "id": "filterSwitchWrap",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": [
        "filterStatusLabel",
        "filterStatusSwitch"
      ]
    },
    {
      "id": "filterStatusLabel",
      "component": "span",
      "props": {
        "value": "仅看上架",
        "className": "text-sm text-on-surface-variant"
      }
    },
    {
      "id": "filterStatusSwitch",
      "component": "Switch",
      "props": {
        "value": {
          "path": "/filterStatusActive"
        },
        "checkedChildren": "开",
        "unCheckedChildren": "关"
      }
    },
    {
      "id": "filterActionBtn",
      "component": "Button",
      "props": {
        "icon": "sliders-horizontal",
        "shape": "circle"
      }
    },
    {
      "id": "tableWrapper",
      "component": "div",
      "props": {
        "className": "bg-surface-container-highest rounded-container shadow-card overflow-hidden"
      },
      "children": [
        "productTable"
      ]
    },
    {
      "id": "productTable",
      "component": "Table",
      "props": {
        "rowKey": "id",
        "dataSource": {
          "path": "/productTableItems"
        },
        "columns": [{
            "title": "产品信息 / SKU",
            "dataIndex": "productName"
          },
          {
            "title": "分类",
            "dataIndex": "category"
          },
          {
            "title": "规格描述",
            "dataIndex": "specification"
          },
          {
            "title": "单价 / 利润率",
            "dataIndex": "unitPrice"
          },
          {
            "title": "库存水位",
            "dataIndex": "stockCurrent"
          },
          {
            "title": "状态",
            "dataIndex": "productStatus",
            "width": 100
          },
          {
            "title": "操作",
            "dataIndex": "action",
            "width": 80
          }
        ],
        "pagination": true,
        "className": "mb-4"
      },
      "children": {
        "path": "/productTableItems",
        "componentId": "productTableRow"
      }
    },
    {
      "id": "productTableRow",
      "component": "TableRow",
      "children": [
        "tableProductInfoCell",
        "tableCategoryCell",
        "tableSpecCell",
        "tablePriceCell",
        "tableStockCell",
        "tableStatusCell",
        "tableActionCell"
      ]
    },
    {
      "id": "tableProductInfoCell",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "tableProductImg",
        "tableProductTextWrap"
      ]
    },
    {
      "id": "tableProductImg",
      "component": "img",
      "props": {
        "src": {
          "path": "productImage"
        },
        "className": "w-10 h-10 rounded-lg object-cover shrink-0",
        "alt": "Product"
      }
    },
    {
      "id": "tableProductTextWrap",
      "component": "div",
      "props": {
        "className": "flex flex-col min-w-0"
      },
      "children": [
        "tableProductName",
        "tableProductSku"
      ]
    },
    {
      "id": "tableProductName",
      "component": "span",
      "props": {
        "value": {
          "path": "productName"
        },
        "className": "text-sm font-medium text-on-surface truncate"
      }
    },
    {
      "id": "tableProductSku",
      "component": "span",
      "props": {
        "value": {
          "path": "id"
        },
        "className": "text-xs text-on-surface-variant"
      }
    },
    {
      "id": "tableCategoryCell",
      "component": "Tag",
      "props": {
        "value": {
          "path": "category"
        },
        "variant": "outlined",
        "size": "small"
      }
    },
    {
      "id": "tableSpecCell",
      "component": "span",
      "props": {
        "value": {
          "path": "specification"
        },
        "className": "text-sm text-on-surface-variant"
      }
    },
    {
      "id": "tablePriceCell",
      "component": "div",
      "props": {
        "className": "flex flex-col gap-1"
      },
      "children": [
        "tablePriceValue",
        "tableMarginRow"
      ]
    },
    {
      "id": "tablePriceValue",
      "component": "span",
      "props": {
        "value": {
          "path": "unitPrice"
        },
        "className": "text-sm font-medium text-on-surface"
      }
    },
    {
      "id": "tableMarginRow",
      "component": "div",
      "props": {
        "className": "flex items-center gap-1"
      },
      "children": [
        "tableMarginIcon",
        "tableMarginValue"
      ]
    },
    {
      "id": "tableMarginIcon",
      "component": "Icon",
      "props": {
        "name": {
          "path": "marginTrendIcon"
        },
        "color": {
          "path": "marginTrendColor"
        },
        "shape": "outline",
        "className": "w-3.5 h-3.5"
      }
    },
    {
      "id": "tableMarginValue",
      "component": "span",
      "props": {
        "value": {
          "path": "profitMargin"
        },
        "className": "text-xs text-on-surface-variant"
      }
    },
    {
      "id": "tableStockCell",
      "component": "div",
      "props": {
        "className": "flex flex-col gap-1 min-w-[120px]"
      },
      "children": [
        "tableStockProgress",
        "tableStockTextWrap"
      ]
    },
    {
      "id": "tableStockProgress",
      "component": "Progress",
      "props": {
        "percent": {
          "path": "stockPercentage"
        },
        "status": {
          "path": "progressStatus"
        },
        "strokeColor": {
          "path": "progressColor"
        },
        "showInfo": false,
        "size": "small"
      }
    },
    {
      "id": "tableStockTextWrap",
      "component": "div",
      "props": {
        "className": "flex items-center gap-1"
      },
      "children": [
        "tableStockCurrent",
        "tableStockSlash",
        "tableStockTotal"
      ]
    },
    {
      "id": "tableStockCurrent",
      "component": "span",
      "props": {
        "value": {
          "path": "stockCurrent"
        },
        "className": "text-xs text-on-surface-variant"
      }
    },
    {
      "id": "tableStockSlash",
      "component": "span",
      "props": {
        "value": "/",
        "className": "text-xs text-on-surface-variant"
      }
    },
    {
      "id": "tableStockTotal",
      "component": "span",
      "props": {
        "value": {
          "path": "stockTotal"
        },
        "className": "text-xs text-on-surface-variant"
      }
    },
    {
      "id": "tableStatusCell",
      "component": "Tag",
      "props": {
        "value": {
          "path": "productStatus"
        },
        "color": {
          "path": "statusTagColor"
        },
        "size": "small"
      }
    },
    {
      "id": "tableActionCell",
      "component": "Button",
      "props": {
        "icon": "more-horizontal",
        "shape": "circle",
        "size": "small"
      }
    }
  ]
}