                "className": "text-sm font-medium text-error",
                "value": {
                    "path": "/task/progress/due"
                }
            }
        },
        {
            "id": "progressBar",
            "component": "Progress",
            "props": {
                "percent": {
                    "path": "/task/progress/percent"
                },
                "strokeColor": "#0067D1"
            }
        },
        {
            "id": "metricGrid",
            "component": "div",
            "props": {
                "className": "grid grid-cols-2 gap-2 mt-stack"
            },
            "children": [
                "estMetric",
                "actMetric"
            ]
        },
        {
            "id": "estMetric",
            "component": "div",
            "props": {
                "className": "bg-surface-variant p-2 rounded-md"
            },
            "children": [
                "estLabel",
                "estVal"
            ]
        },
        {
            "id": "estLabel",
            "component": "span",
            "props": {
                "className": "text-xs text-on-surface-variant block",
                "value": "ESTIMATED"
            }
        },
        {
            "id": "estVal",
            "component": "span",
            "props": {
                "className": "text-md font-bold",
                "value": "45h"
            }
        },
        {
            "id": "actMetric",
            "component": "div",
            "props": {
                "className": "bg-surface-variant p-2 rounded-md"
            },
            "children": [
                "actLabel",
                "actVal"
            ]
        },
        {
            "id": "actLabel",
            "component": "span",
            "props": {
                "className": "text-xs text-on-surface-variant block",
                "value": "ACTUAL"
            }
        },
        {
            "id": "actVal",
            "component": "span",
            "props": {
                "className": "text-md font-bold text-primary",
                "value": "32.5h"
            }
        },
        {
            "id": "discussionCard",
            "component": "div",
            "props": {
                "className": "bg-surface-container-highest p-inset rounded-container shadow-card"
            },
            "children": [
                "discHeader",
                "discTimeline"
            ]
        },
        {
            "id": "discHeader",
            "component": "div",
            "props": {
                "className": "flex justify-between items-center mb-gutter"
            },
            "children": [
                "discTitle",
                "discCount"
            ]
        },
        {
            "id": "discTitle",
            "component": "h4",
            "props": {
                "className": "text-lg font-bold",
                "value": "Internal Discussion / 讨论"
            }
        },
        {
            "id": "discCount",
            "component": "Tag",
            "props": {
                "value": "12",
                "shape": "circle"
            }
        },
        {
            "id": "discTimeline",
            "component": "Timeline",
            "props": {
                "className": "mt-2"
            },
            "children": {
                "path": "/task/discussion",
                "componentId": "discItem"
            }
        },
        {
            "id": "discItem",
            "component": "TimelineItem",
            "props": {
                "title": {
                    "path": "userName"
                },
                "content": {
                    "componentId": "discContent"
                }
            }
        },
        {
            "id": "discContent",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "discMsg",
                "discTime"
            ]
        },
        {
            "id": "discMsg",
            "component": "p",
            "props": {
                "className": "text-sm text-on-surface-variant",
                "value": {
                    "path": "msg"
                }
            }
        },
        {
            "id": "discTime",
            "component": "span",
            "props": {
                "className": "text-xs text-on-surface-variant mt-1",
                "value": {
                    "path": "time"
                }
            }
        }
    ]
}