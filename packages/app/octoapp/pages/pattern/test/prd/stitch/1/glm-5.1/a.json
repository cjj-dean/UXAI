            "props": {
                "src": {
                    "path": "/containerStyle/backgroundBtTextureImage"
                },
                "alt": "background texture",
                "className": "absolute inset-0 w-full h-full object-cover opacity-[0.03] pointer-events-none"
            }
        },
        {
            "id": "navbar",
            "component": "div",
            "props": {
