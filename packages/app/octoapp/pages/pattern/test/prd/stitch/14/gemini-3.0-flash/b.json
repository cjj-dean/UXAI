            "props": {
                "className": "flex gap-inline"
            },
            "children": [
                "editBtn",
                "moreBtn"
            ]
        },
        {
            "id": "editBtn",
            "component": "Button",
            "props": {
                "value": "编辑",
                "size": "small"
            }
        },
        {
            "id": "moreBtn",
            "component": "Button",
            "props": {
                "icon": "more-horizontal",
                "size": "small"
            }
        },
        {
            "id": "bottomGrid",
            "component": "div",
            "props": {
                "className": "grid grid-cols-5 gap-gutter"
            },
            "children": [
                "trendsCard",
                "activityCard"
            ]
        },
        {
            "id": "trendsCard",
            "component": "div",
            "props": {
                "className": "col-span-3 bg-surface-container-highest p-inset rounded-xl shadow-card flex flex-col gap-gutter"
            },
            "children": [
                "trendsTitle",
                "trendsChart"
            ]
        },
        {
            "id": "trendsTitle",
            "component": "span",
            "props": {
                "className": "text-lg font-bold text-on-surface",
                "value": "回款趋势趋势 (Collection Trends)"
            }
        },
        {
            "id": "trendsChart",
            "component": "BarChart",
            "props": {
                "option": {
                    "data": {
                        "path": "/trends"
                    },
                    "xAxis": {
                        "data": "month"
                    },
                    "yAxisTitle": "Amount (¥)",
                    "color": [
                        "#0067D1"
                    ]
                },
                "className": "h-64 w-full"
            }
        },
        {
            "id": "activityCard",
            "component": "div",
            "props": {
                "className": "col-span-2 bg-surface-container-highest p-inset rounded-xl shadow-card flex flex-col gap-gutter"
            },
            "children": [
                "activityTitle",
                "activityTimeline"
            ]
        },
        {
            "id": "activityTitle",
            "component": "span",
            "props": {
                "className": "text-lg font-bold text-on-surface",
                "value": "最近活动 (Recent Activity)"
            }
        },
        {
            "id": "activityTimeline",
            "component": "Timeline",
            "props": {
                "orientation": "vertical"
            },
            "children": {
                "path": "/activities",
                "componentId": "activityItem"
            }
        },
        {
            "id": "activityItem",
            "component": "TimelineItem",
            "props": {
                "title": {
                    "path": "time"
                },
                "content": {
                    "path": "info"
                },
                "icon": {
                    "path": "icon"
                },
                "color": {
                    "path": "color"
                }
            }
        }
    ]
}