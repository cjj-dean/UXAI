        "iconPlacement": "start"
      }
    },
    {
      "id": "filterResetBtn",
      "component": "Button",
      "props": {
        "value": "重置",
        "icon": "rotate-ccw",
        "iconPlacement": "start"
      }
    },
    {
      "id": "filterActions",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "filterExportBtn",
        "filterNewBtn"
      ]
    },
    {
      "id": "filterExportBtn",
      "component": "Button",
      "props": {
        "value": "导出数据",
        "icon": "download",
        "iconPlacement": "start"
      }
    },
    {
      "id": "filterNewBtn",
      "component": "Button",
      "props": {
        "value": "新建入库",
        "color": "primary",
        "icon": "plus-circle",
        "iconPlacement": "start"
      }
    },
    {
      "id": "inventoryTable",
      "component": "Table",
      "props": {
        "rowKey": "id",
        "dataSource": {
          "path": "/tableRows"
        },
        "pagination": true,
        "columns": [{
            "title": "物料编码",
            "dataIndex": "materialCode",
            "sort": true
          },
          {
            "title": "物料信息",
            "dataIndex": "materialDetail"
          },
          {
            "title": "所在仓库",
            "dataIndex": "warehouseName",
            "sort": true
          },
          {
            "title": "库位",
            "dataIndex": "storageLocation"
          },
          {
            "title": "批次号",
            "dataIndex": "batchNo"
          },
          {
            "title": "当前库存",
            "dataIndex": "currentStock",
            "sort": true
          },
          {
            "title": "状态",
            "dataIndex": "stockStatus",
            "sort": true,
            "align": "center",
            "width": 90
          },
          {
            "title": "最后操作",
            "dataIndex": "lastOperationTime",
            "sort": true
          },
          {
            "title": "操作",
            "dataIndex": "actions",
            "width": 80,
            "align": "center"
          }
        ],
        "className": "mb-4"
      },
      "children": {
        "path": "/tableRows",
        "componentId": "tableRowTemplate"
      }
    },
    {
      "id": "tableRowTemplate",
      "component": "TableRow",
      "children": [
        "cellCode",
        "cellDetail",
        "cellWarehouse",
        "cellLocation",
        "cellBatch",
        "cellStock",
        "cellStatus",
        "cellTime",
        "cellActions"
      ]
    },
    {
      "id": "cellCode",
      "component": "span",
      "props": {
        "value": {
          "path": "materialCode"
        },
        "className": "text-sm font-mono text-on-surface"
      }
    },
    {
      "id": "cellDetail",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "cellDetailImg",
        "cellDetailInfo"
      ]
    },
    {
      "id": "cellDetailImg",
      "component": "img",
      "props": {
        "src": {
          "path": "materialImage"
        },
        "alt": "material",
        "className": "w-10 h-10 rounded-md object-cover shrink-0"
      }
    },
    {
      "id": "cellDetailInfo",
      "component": "div",
      "props": {
        "className": "flex flex-col gap-0.5"
      },
      "children": [
        "cellDetailName",
        "cellDetailSpec"
      ]
    },
    {
      "id": "cellDetailName",
      "component": "span",
      "props": {
        "value": {
          "path": "materialName"
        },
        "className": "text-sm font-medium text-on-surface"
      }
    },
    {
      "id": "cellDetailSpec",
      "component": "span",
      "props": {
        "value": {
          "path": "specAttribute"
        },
        "className": "text-xs text-on-surface-variant"
      }
    },
    {
      "id": "cellWarehouse",
      "component": "span",
      "props": {
        "value": {
          "path": "warehouseName"
        },
        "className": "text-sm text-on-surface"
      }
    },
    {
      "id": "cellLocation",
      "component": "span",
      "props": {
        "value": {
          "path": "storageLocation"
        },
        "className": "text-sm text-on-surface-variant font-mono"
      }
    },
    {
      "id": "cellBatch",
      "component": "span",
      "props": {
        "value": {
          "path": "batchNo"
        },
        "className": "text-sm text-on-surface font-mono"
      }
    },
    {
      "id": "cellStock",
      "component": "div",
      "props": {
        "className": "flex items-baseline gap-1"
      },
      "children": [
        "cellStockNum",
        "cellStockUnit"
      ]
    },
    {
      "id": "cellStockNum",
      "component": "span",
      "props": {
        "value": {
          "path": "currentStock"
        },
        "className": "text-sm font-semibold text-on-surface"
      }
    },
    {
      "id": "cellStockUnit",
      "component": "span",
      "props": {
        "value": {
          "path": "unitOfMeasure"
        },
        "className": "text-xs text-on-surface-variant"
      }
    },
    {
      "id": "cellStatus",
      "component": "Tag",
      "props": {
        "value": {
          "path": "stockStatus"
        },
        "color": {
          "path": "tagColor"
        }
      }
    },
    {
      "id": "cellTime",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": [
        "cellTimeText",
        "cellTimeAvatar"
      ]
    },
    {
      "id": "cellTimeText",
      "component": "span",
      "props": {
        "value": {
          "path": "lastOperationTime"
        },
        "className": "text-sm text-on-surface-variant"
      }
    },
    {
      "id": "cellTimeAvatar",
      "component": "img",
      "props": {
        "src": {
          "path": "operatorAvatarImage"
        },
        "alt": "operator",
        "className": "w-6 h-6 rounded-full object-cover shrink-0"
      }
    },
    {
      "id": "cellActions",
      "component": "Button",
      "props": {
        "value": "详情",
        "size": "small"
      }
    }
  ]
}