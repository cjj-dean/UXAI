            "id": "prodQtyCell",
            "component": "InputNumber",
            "props": {
                "value": {
                    "path": "quantity"
                },
                "size": "small",
                "controls": true
            }
        },
        {
            "id": "prodDiscCell",
            "component": "InputNumber",
            "props": {
                "value": {
                    "path": "discount"
