         "placeholder": "最低价",
         "min": 0,
         "className": "w-28"
       }
     },
     {
       "id": "filterPriceDash",
       "component": "span",
       "props": {
         "value": "—",
         "className": "text-on-surface-variant"
       }
     },
     {
       "id": "filterPriceMax",
       "component": "InputNumber",
       "props": {
         "value": {
           "path": "/priceMax"
         },
         "placeholder": "最高价",
         "min": 0,
         "className": "w-28"
       }
     },
     {
       "id": "filterStatusWrapper",
       "component": "div",
       "props": {
         "className": "flex items-center gap-2"
       },
       "children": [
         "filterStatusLabel",
         "filterStatusSwitch"
       ]
     },
     {
       "id": "filterStatusLabel",
       "component": "span",
       "props": {
         "value": "仅看上架",
         "className": "text-sm text-on-surface-variant whitespace-nowrap"
       }
     },
     {
       "id": "filterStatusSwitch",
       "component": "Switch",
       "props": {
         "value": {
           "path": "/statusToggle"
         }
       }
     },
     {
       "id": "filterSpacer",
       "component": "div",
       "props": {
         "className": "flex-1"
       }
     },
     {
       "id": "filterSubmitBtn",
       "component": "Button",
       "props": {
         "value": "查询",
         "icon": "search",
         "iconPlacement": "start",
         "color": "primary"
       }
     },
     {
       "id": "filterResetBtn",
       "component": "Button",
       "props": {
         "value": "重置",
         "icon": "rotate-ccw",
         "iconPlacement": "start"
       }
     },
     {
       "id": "tableSection",
       "component": "div",
       "props": {
         "className": "bg-surface-container-highest rounded-xl shadow-sm flex flex-col flex-1 min-h-0"
       },
       "children": [
         "tableHeader",
         "productTable"
       ]
     },
     {
       "id": "tableHeader",
       "component": "div",
       "props": {
         "className": "flex items-center justify-between px-5 py-3 border-b border-divider"
       },
       "children": [
         "tableTitle",
         "tableHeaderRight"
       ]
     },
     {
       "id": "tableTitle",
       "component": "span",
       "props": {
         "value": "产品明细列表",
         "className": "text-base font-semibold text-on-surface"
       }
     },
     {
       "id": "tableHeaderRight",
       "component": "div",
       "props": {
         "className": "flex items-center gap-2"
       },
       "children": [
         "tableExportBtn",
         "tableAddBtn"
       ]
     },
     {
       "id": "tableExportBtn",
       "component": "Button",
       "props": {
         "value": "导出",
         "icon": "download",
         "iconPlacement": "start"
       }
     },
     {
       "id": "tableAddBtn",
       "component": "Button",
       "props": {
         "value": "新增产品",
         "icon": "plus",
         "iconPlacement": "start",
         "color": "primary"
       }
     },
     {
       "id": "productTable",
       "component": "Table",
       "props": {
         "rowKey": "id",
         "dataSource": {
           "path": "/tableDataSource"
         },
         "pagination": true,
         "rowSelection": {
           "type": "checkbox",
           "selectedRowKeys": {
             "path": "/selectedRowKeys"
           }
         },
         "columns": [{
             "title": "产品信息",
             "dataIndex": "productName",
             "minWidth": 260
           },
           {
             "title": "SKU 编码",
             "dataIndex": "skuCode"
           },
           {
             "title": "分类",
             "dataIndex": "category"
           },
           {
             "title": "单价",
             "dataIndex": "price"
           },
           {
             "title": "库存水位",
             "dataIndex": "stockStatus",
             "minWidth": 160
           },
           {
             "title": "状态",
             "dataIndex": "status",
             "width": 100
           },
           {
             "title": "操作",
             "dataIndex": "actions",
             "width": 140,
             "fixed": "end"
           }
         ],
         "className": "mb-4"
       },
       "children": {
         "path": "/tableDataSource",
         "componentId": "tableRow"
       }
     },
     {
       "id": "tableRow",
       "component": "TableRow",
       "children": [
         "productInfoCell",
         "skuCell",
         "categoryCell",
         "priceCell",
         "stockCell",
         "statusCell",
         "actionCell"
       ]
     },
     {
       "id": "productInfoCell",
       "component": "div",
       "props": {
         "className": "flex items-center gap-3"
       },
       "children": [
         "productImg",
         "productNameText"
       ]
     },
     {
       "id": "productImg",
       "component": "img",
       "props": {
         "src": {
           "path": "productImage"
         },
         "className": "w-10 h-10 rounded-lg object-cover shrink-0"
       }
     },
     {
       "id": "productNameText",
       "component": "span",
       "props": {
         "value": {
           "path": "productName"
         },
         "className": "text-sm font-medium text-on-surface"
       }
     },
     {
       "id": "skuCell",
       "component": "span",
       "props": {
         "value": {
           "path": "skuCode"
         },
         "className": "text-sm text-on-surface-variant font-mono"
       }
     },
     {
       "id": "categoryCell",
       "component": "Tag",
       "props": {
         "value": {
           "path": "category"
         },
         "color": {
           "path": "categoryColor"
         },
         "variant": "outlined"
       }
     },
     {
       "id": "priceCell",
       "component": "span",
       "props": {
         "value": {
           "path": "price"
         },
         "className": "text-sm font-medium text-on-surface"
       }
     },
     {
       "id": "stockCell",
       "component": "div",
       "props": {
         "className": "flex flex-col gap-1"
       },
       "children": [
         "stockProgress",
         "stockTextSpan"
       ]
     },
     {
       "id": "stockProgress",
       "component": "Progress",
       "props": {
         "percent": {
           "path": "stockPercentage"
         },
         "strokeColor": {
           "path": "stockColor"
         },
         "showInfo": false,
         "size": "small"
       }
     },
     {
       "id": "stockTextSpan",
       "component": "span",
       "props": {
         "value": {
           "path": "stockText"
         },
         "className": "text-xs text-on-surface-variant"
       }
     },
     {
       "id": "statusCell",
       "component": "Tag",
       "props": {
         "value": {
           "path": "status"
         },
         "color": {
           "path": "statusColor"
         }
       }
     },
     {
       "id": "actionCell",
       "component": "div",
       "props": {
         "className": "flex items-center gap-1"
       },
       "children": [
         "actionEditBtn",
         "actionDetailBtn"
       ]
     },
     {
       "id": "actionEditBtn",
       "component": "Button",
       "props": {
         "value": "编辑",
         "size": "small"
       }
     },
     {
       "id": "actionDetailBtn",
       "component": "Button",
       "props": {
         "value": "详情",
         "size": "small",
         "color": "primary"
       }
     }
   ]
 }