            "id": "matrixTable",
            "component": "Table",
            "props": {
                "rowKey": "id",
                "dataSource": {
                    "path": "/main/matrix"
                },
                "pagination": false,
                "columns": [
                    {
                        "title": "FEATURE SET",
                        "dataIndex": "feature"
                    },
                    {
                        "title": "STRATEGIC INTEL (OUR)",
                        "dataIndex": "our",
                        "align": "center"
                    },
                    {
                        "title": "NEXGEN ANALYTICS",
                        "dataIndex": "compA",
                        "align": "center"
                    },
                    {
                        "title": "MARKETFORCE AI",
                        "dataIndex": "compB",
                        "align": "center"
                    },
                    {
                        "title": "QUANTEDGE PRO",
                        "dataIndex": "compC",
                        "align": "center"
                    }
                ]
            },
            "children": {
                "path": "/main/matrix",
                "componentId": "matrixRow"
            }
        },
        {
            "id": "matrixRow",
            "component": "TableRow",
            "children": [
                "cellFeature",
                "cellOur",
                "cellA",
                "cellB",
                "cellC"
            ]
        },
        {
            "id": "cellFeature",
            "component": "span",
            "props": {
                "className": {
                    "path": "isGroup ? 'font-bold text-primary tracking-wider' : 'text-on-surface'"
                },
                "value": {
                    "path": "feature"
                }
            }
        },
        {
            "id": "cellOur",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "our === 'check' ? 'check-circle-2' : our === 'x' ? 'x-circle' : 'minus'"
                },
                "color": {
                    "path": "our === 'check' ? 'success' : 'default'"
                },
                "className": "w-5 h-5 mx-auto"
            }
        },
        {
            "id": "cellA",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "compA === 'check' ? 'check-circle-2' : compA === 'x' ? 'x-circle' : 'minus'"
                },
                "color": {
                    "path": "compA === 'check' ? 'success' : 'default'"
                },
                "className": "w-5 h-5 mx-auto"
            }
        },
        {
            "id": "cellB",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "compB === 'check' ? 'check-circle-2' : compB === 'x' ? 'x-circle' : 'minus'"
                },
                "color": {
                    "path": "compB === 'check' ? 'success' : 'default'"
                },
                "className": "w-5 h-5 mx-auto"
            }
        },
        {
            "id": "cellC",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "compC === 'check' ? 'check-circle-2' : compC === 'x' ? 'x-circle' : 'minus'"
                },
                "color": {
                    "path": "compC === 'check' ? 'success' : 'default'"
                },
                "className": "w-5 h-5 mx-auto"
            }
        }
