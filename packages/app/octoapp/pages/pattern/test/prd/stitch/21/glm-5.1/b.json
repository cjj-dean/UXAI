    {
      "id": "toolbarCategorySelect",
      "component": "Select",
      "props": {
        "value": {
          "path": "/selectedCategory"
        },
        "options": {
          "path": "/filterCategories"
        },
        "placeholder": "选择分类",
        "className": "w-36"
      }
    },
    {
      "id": "toolbarPriceMinInput",
      "component": "InputNumber",
      "props": {
        "value": {
          "path": "/priceRangeFilter/minPrice"
        },
        "placeholder": "最低价",
        "min": 0,
        "className": "w-28"
      }
    },
    {
      "id": "toolbarPriceSep",
      "component": "span",
      "props": {
        "value": "—",
        "className": "text-on-surface-variant"
      }
    },
    {
      "id": "toolbarPriceMaxInput",
      "component": "InputNumber",
      "props": {
        "value": {
          "path": "/priceRangeFilter/maxPrice"
        },
        "placeholder": "最高价",
        "min": 0,
        "className": "w-28"
      }
    },
    {
      "id": "toolbarSwitchArea",
      "component": "div",
      "props": {
        "className": "flex items-center gap-2"
      },
      "children": [
        "toolbarSwitchLabel",
        "toolbarSwitch"
      ]
    },
    {
      "id": "toolbarSwitchLabel",
      "component": "span",
      "props": {
        "value": "仅看上架",
        "className": "text-sm text-on-surface-variant"
      }
    },
    {
      "id": "toolbarSwitch",
      "component": "Switch",
      "props": {
        "value": {
          "path": "/isOnlyOnSale"
        },
        "checkedChildren": "开",
        "unCheckedChildren": "关"
      }
    },
    {
      "id": "toolbarResetBtn",
      "component": "Button",
      "props": {
        "value": "重置",
        "color": "default",
        "size": "small"
      }
    },
    {
      "id": "tableSection",
      "component": "div",
      "props": {
        "className": "bg-surface-container-highest rounded-container shadow-card flex flex-col flex-1 overflow-hidden"
      },
      "children": [
        "tableSummaryBar",
        "mainProductTable"
      ]
    },
    {
      "id": "tableSummaryBar",
      "component": "div",
      "props": {
        "className": "flex items-center justify-between px-4 py-3 border-b border-divider"
      },
      "children": [
        "tableSummaryText",
        "tableSummaryBadge"
      ]
    },
    {
      "id": "tableSummaryText",
      "component": "span",
      "props": {
        "value": {
          "path": "/tableMeta/summaryText"
        },
        "className": "text-xs text-on-surface-variant"
      }
    },
    {
      "id": "tableSummaryBadge",
      "component": "Tag",
      "props": {
        "value": "第 1 / 1246 页",
        "color": "processing",
        "size": "small"
      }
    },
    {
      "id": "mainProductTable",
      "component": "Table",
      "props": {
        "rowKey": "id",
        "dataSource": {
          "path": "/tableItems"
        },
        "columns": [{
            "title": "产品信息",
            "dataIndex": "productName",
            "sort": true,
            "minWidth": 280
          },
          {
            "title": "分类",
            "dataIndex": "category",
            "sort": true,
            "width": 100
          },
          {
            "title": "单价 (CNY)",
            "dataIndex": "unitPrice",
            "sort": true,
            "align": "right",
            "width": 120
          },
          {
            "title": "利润率",
            "dataIndex": "profitMargin",
            "sort": true,
            "align": "right",
            "width": 100
          },
          {
            "title": "库存状态",
            "dataIndex": "stockInfo",
            "sort": true,
            "minWidth": 180
          },
          {
            "title": "上架状态",
            "dataIndex": "status",
            "sort": true,
            "width": 120
          },
          {
            "title": "操作",
            "dataIndex": "actions",
            "width": 80
          }
        ],
        "pagination": true,
        "className": "mb-4"
      },
      "children": {
        "path": "/tableItems",
        "componentId": "tableRowTemplate"
      }
    },
    {
      "id": "tableRowTemplate",
      "component": "TableRow",
      "children": [
        "cellProductInfo",
        "cellCategory",
        "cellPrice",
        "cellProfit",
        "cellStock",
        "cellStatus",
        "cellAction"
      ]
    },
    {
      "id": "cellProductInfo",
      "component": "div",
      "props": {
        "className": "flex items-center gap-3"
      },
      "children": [
        "cellProductImg",
        "cellProductTextWrap"
      ]
    },
    {
      "id": "cellProductImg",
      "component": "img",
      "props": {
        "src": {
          "path": "productImage"
        },
        "alt": "产品图片",
        "className": "w-10 h-10 rounded-md object-cover shrink-0"
      }
    },
    {
      "id": "cellProductTextWrap",
      "component": "div",
      "props": {
        "className": "flex flex-col min-w-0"
      },
      "children": [
        "cellProductName",
        "cellProductId"
      ]
    },
    {
      "id": "cellProductName",
      "component": "span",
      "props": {
        "value": {
          "path": "productName"
        },
        "className": "text-sm font-medium text-on-surface truncate"
      }
    },
    {
      "id": "cellProductId",
      "component": "span",
      "props": {
        "value": {
          "path": "id"
        },
        "className": "text-xs text-on-surface-variant"
      }
    },
    {
      "id": "cellCategory",
      "component": "span",
      "props": {
        "value": {
          "path": "category"
        },
        "className": "text-sm text-on-surface"
      }
    },
    {
      "id": "cellPrice",
      "component": "span",
      "props": {
        "value": {
          "path": "unitPriceDisplay"
        },
        "className": "text-sm font-medium text-on-surface"
      }
    },
    {
      "id": "cellProfit",
      "component": "span",
      "props": {
        "value": {
          "path": "profitMargin"
        },
        "className": "text-sm text-on-surface"
      }
    },
    {
      "id": "cellStock",
      "component": "div",
      "props": {
        "className": "flex flex-col gap-1 min-w-[120px]"
      },
      "children": [
        "cellStockProgress",
        "cellStockText"
      ]
    },
    {
      "id": "cellStockProgress",
      "component": "Progress",
      "props": {
        "percent": {
          "path": "progressPercentage"
        },
        "size": "small",
        "showInfo": false
      }
    },
    {
      "id": "cellStockText",
      "component": "span",
      "props": {
        "value": {
          "path": "stockDisplay"
        },
        "className": "text-xs text-on-surface-variant"
      }
    },
    {
      "id": "cellStatus",
      "component": "Tag",
      "props": {
        "value": {
          "path": "statusLabel"
        },
        "color": {
          "path": "statusTagColor"
        },
        "size": "small"
      }
    },
    {
      "id": "cellAction",
      "component": "Button",
      "props": {
        "value": "详情",
        "size": "small",
        "color": "primary"
      }
    }
  ]
}