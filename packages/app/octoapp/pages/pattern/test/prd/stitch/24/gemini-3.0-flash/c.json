            "props": {
                "className": "flex justify-between mb-2"
            },
            "children": [
                "perfProgressText",
                "perfProgressValue"
            ]
        },
        {
            "id": "perfProgressText",
            "component": "span",
            "props": {
                "value": "综合得分",
                "className": "text-sm"
            }
        },
        {
            "id": "perfProgressValue",
            "component": "span",
            "props": {
                "value": {
                    "path": "/overallPerformance/currentScore"
                },
                "className": "text-sm font-bold"
            }
        },
        {
            "id": "perfProgress",
            "component": "Progress",
            "props": {
                "percent": {
                    "path": "/overallPerformance/progressValue"
                },
                "showInfo": false,
                "strokeColor": "#0067D1"
            }
        },
        {
            "id": "perfTrend",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2 mt-2"
            },
            "children": [
                "perfTrendIcon",
                "perfTrendRate",
                "perfTrendText"
            ]
        },
        {
            "id": "perfTrendIcon",
            "component": "Icon",
            "props": {
