                "className": "w-4 h-4 text-success"
            }
        },
        {
            "id": "perfTrendRate",
            "component": "span",
            "props": {
                "value": {
                    "path": "/overallPerformance/improvementRate"
                },
                "className": "text-sm font-bold text-success"
            }
        },
        {
            "id": "perfTrendText",
            "component": "span",
            "props": {
                "value": {
                    "path": "/overallPerformance/comparisonText"
                },
                "className": "text-xs text-on-surface-variant"
            }
        }
    ]
}