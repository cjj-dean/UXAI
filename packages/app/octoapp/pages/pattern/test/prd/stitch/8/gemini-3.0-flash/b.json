                "timelineLabel",
                "timelineComp"
            ]
        },
        {
            "id": "timelineLabel",
            "component": "span",
            "props": {
                "className": "text-xs font-bold text-primary tracking-wider uppercase",
                "value": "Timeline"
            }
        },
        {
            "id": "timelineComp",
            "component": "Timeline",
            "props": {
                "orientation": "vertical"
            },
            "children": {
                "path": "/drawer/timelineData",
                "componentId": "timelineItem"
            }
        },
        {
            "id": "timelineItem",
            "component": "TimelineItem",
            "props": {
                "title": {
                    "path": "time"
                },
                "content": {
                    "componentId": "timelineContent"
                },
                "icon": {
                    "path": "icon"
                }
            }
        },
        {
            "id": "timelineContent",
            "component": "span",
            "props": {
                "className": "text-sm text-on-surface",
                "value": {
                    "path": "content"
                }
            }
        },
        {
            "id": "drawerFooter",
            "component": "div",
            "props": {
                "className": "p-gutter border-t border-divider"
            },
            "children": [
                "copyBtn"
            ]
        },
        {
            "id": "copyBtn",
            "component": "Button",
            "props": {
                "value": "Copy Event URL",
                "color": "primary",
                "icon": "copy",
                "iconPlacement": "start",
                "className": "w-full"
            }
        }
    ]
