    "rootId": "securityGateApp",
    "elements": [
        {
            "id": "securityGateApp",
            "component": "div",
            "props": {
                "className": "flex h-screen bg-surface-container-lowest overflow-hidden"
            },
            "children": [
                "sideNav",
                "mainWrapper"
            ]
        },
        {
            "id": "sideNav",
            "component": "div",
            "props": {
                "className": "w-20 flex flex-col items-center py-6 bg-surface-container-highest shadow-sm border-r border-divider"
            },
            "children": [
                "navLogo",
                "navMenu",
                "navUserSection"
            ]
        },
        {
            "id": "navLogo",
            "component": "div",
            "props": {
                "className": "mb-10"
            },
            "children": [
                "logoIcon"
            ]
        },
        {
            "id": "logoIcon",
            "component": "Icon",
            "props": {
                "name": "shield-half",
                "color": "primary",
                "shape": "square",
                "className": "w-10 h-10"
            }
        },
        {
            "id": "navMenu",
            "component": "div",
            "props": {
                "className": "flex-1 flex flex-col gap-6"
            },
            "children": {
                "path": "/navItems",
                "componentId": "navMenuItem"
            }
        },
        {
            "id": "navMenuItem",
            "component": "div",
            "props": {
                "className": "flex flex-col items-center gap-1 cursor-pointer group"
            },
            "children": [
                "navMenuIcon"
            ]
        },
        {
            "id": "navMenuIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "icon"
                },
                "color": {
                    "path": "active"
                },
                "className": "w-6 h-6 group-hover:text-primary transition-colors"
            }
        },
        {
            "id": "navUserSection",
            "component": "div",
            "props": {
                "className": "mt-auto flex flex-col items-center gap-4"
            },
            "children": [
                "userAvatar",
                "userName"
            ]
        },
        {
            "id": "userAvatar",
            "component": "div",
            "props": {
                "className": "w-10 h-10 rounded-full overflow-hidden border-2 border-primary"
            },
            "children": [
                "userImg"
            ]
        },
        {
            "id": "userImg",
            "component": "img",
            "props": {
                "src": {
                    "path": "/currentUser/avatarImage"
                },
                "className": "w-full h-full object-cover"
            }
        },
        {
            "id": "userName",
            "component": "span",
            "props": {
                "className": "text-[10px] text-on-surface-variant font-medium text-center",
                "value": {
                    "path": "/currentUser/nickName"
                }
            }
        },
        {
            "id": "mainWrapper",
            "component": "div",
            "props": {
                "className": "flex-1 flex flex-col overflow-hidden"
            },
            "children": [
                "globalHeader",
                "contentArea"
            ]
        },
        {
            "id": "globalHeader",
            "component": "div",
            "props": {
                "className": "h-16 px-8 flex items-center justify-between bg-surface-container-highest border-b border-divider"
            },
            "children": [
                "headerSearch",
                "headerActions"
            ]
        },
        {
            "id": "headerSearch",
            "component": "Input",
            "props": {
                "value": "",
                "placeholder": {
                    "path": "/searchPlaceholder"
                },
                "prefix": "search",
                "className": "w-96"
            }
        },
        {
            "id": "headerActions",
            "component": "div",
            "props": {
                "className": "flex items-center gap-4"
            },
            "children": [
                "notifyBtn",
                "helpBtn"
            ]
        },
        {
            "id": "notifyBtn",
            "component": "Button",
            "props": {
                "icon": "bell",
                "shape": "circle",
                "className": "relative"
            }
        },
        {
            "id": "helpBtn",
            "component": "Button",
            "props": {
                "icon": "help-circle",
                "shape": "circle"
            }
        },
        {
            "id": "contentArea",
            "component": "div",
            "props": {
                "className": "flex-1 flex overflow-hidden"
            },
            "children": [
                "roleSidebar",
                "permissionDetail"
            ]
        },
        {
            "id": "roleSidebar",
            "component": "div",
            "props": {
                "className": "w-72 bg-surface-container-high border-r border-divider flex flex-col"
            },
            "children": [
                "roleSidebarHeader",
                "roleList"
            ]
        },
        {
            "id": "roleSidebarHeader",
            "component": "div",
            "props": {
                "className": "p-4 flex flex-col gap-3"
            },
            "children": [
                "roleSidebarTitleRow",
                "roleSearchInput"
            ]
        },
        {
            "id": "roleSidebarTitleRow",
            "component": "div",
            "props": {
                "className": "flex items-center justify-between"
            },
            "children": [
                "roleTitle",
                "addRoleBtn"
            ]
        },
        {
            "id": "roleTitle",
            "component": "span",
            "props": {
                "className": "text-md font-bold text-on-surface",
                "value": "Roles"
            }
        },
        {
            "id": "addRoleBtn",
            "component": "Button",
            "props": {
                "icon": "plus",
                "size": "small",
                "color": "primary",
                "shape": "circle"
            }
        },
        {
            "id": "roleSearchInput",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/roleSearch"
                },
                "placeholder": "Filter roles...",
                "prefix": "filter",
                "size": "small"
            }
        },
        {
            "id": "roleList",
            "component": "div",
            "props": {
                "className": "flex-1 overflow-y-auto p-2 flex flex-col gap-1"
            },
            "children": {
                "path": "/roles",
                "componentId": "roleItem"
            }
        },
        {
            "id": "roleItem",
            "component": "div",
            "props": {
                "className": "flex items-center gap-3 p-3 rounded-lg cursor-pointer transition-all"
            },
            "children": [
                "roleItemIcon",
                "roleItemInfo"
            ]
        },
        {
            "id": "roleItemIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "typeIcon"
                },
                "className": "w-5 h-5",
                "color": "primary"
            }
        },
        {
            "id": "roleItemInfo",
            "component": "div",
            "props": {
                "className": "flex-1"
            },
            "children": [
                "roleItemName",
                "roleItemCount"
            ]
        },
        {
            "id": "roleItemName",
            "component": "span",
            "props": {
                "className": "block text-sm font-medium text-on-surface",
                "value": {
                    "path": "roleName"
                }
            }
        },
        {
            "id": "roleItemCount",
            "component": "span",
            "props": {
                "className": "text-xs text-on-surface-variant",
                "value": {
                    "path": "userCount"
                }
            }
        },
        {
            "id": "permissionDetail",
            "component": "div",
            "props": {
                "className": "flex-1 flex flex-col bg-surface-container-lowest"
            },
            "children": [
                "permissionHeader",
                "permissionContent",
                "permissionFooter"
            ]
        },
        {
            "id": "permissionHeader",
            "component": "div",
            "props": {
                "className": "p-8 pb-0"
            },
            "children": [
                "roleDetailTitle",
                "roleDetailDesc",
                "permissionTabs"
            ]
        },
        {
            "id": "roleDetailTitle",
            "component": "h2",
            "props": {
                "className": "text-2xl font-bold text-on-surface mb-2",
                "value": "Super Admin"
            }
        },
        {
            "id": "roleDetailDesc",
            "component": "p",
            "props": {
                "className": "text-sm text-on-surface-variant max-w-2xl mb-6",
                "value": "Full access to all system resources, including security policies, user management, and global system configurations."
            }
        },
        {
            "id": "permissionTabs",
            "component": "Tabs",
            "props": {
                "activeKey": {
                    "path": "/activeTab"
                },
                "size": "large"
            },
            "children": [
                "tabMenu",
                "tabApi",
                "tabData"
            ]
        },
        {
            "id": "tabMenu",
            "component": "TabItem",
            "props": {
                "key": "menu_access",
                "label": "Menu Access",
                "icon": "layout"
            }
        },
        {
            "id": "tabApi",
            "component": "TabItem",
            "props": {
                "key": "api_permissions",
                "label": "API Permissions",
                "icon": "code-2"
            }
        },
        {
            "id": "tabData",
            "component": "TabItem",
            "props": {
                "key": "data_scope",
                "label": "Data Scope",
                "icon": "database"
            }
        },
        {
            "id": "permissionContent",
            "component": "div",
            "props": {
                "className": "flex-1 overflow-y-auto p-8 pt-4"
            },
            "children": [
                "permissionTreeCollapse"
            ]
        },
        {
            "id": "permissionTreeCollapse",
            "component": "Collapse",
            "props": {
                "activeKey": "m1",
                "expandIcon": "chevron-right",
                "className": "bg-transparent border-none"
            },
            "children": {
                "path": "/permissionTree",
                "componentId": "treeNode"
            }
        },
        {
            "id": "treeNode",
            "component": "CollapseItem",
            "props": {
                "key": {
                    "path": "id"
                },
                "label": {
                    "path": "label"
                },
                "extra": {
                    "componentId": "treeNodeSwitch"
                },
                "content": {
                    "componentId": "treeNodeChildren"
                }
            }
        },
        {
            "id": "treeNodeSwitch",
            "component": "Switch",
            "props": {
                "value": {
                    "path": "isEnabled"
                },
                "size": "small"
            }
        },
        {
            "id": "treeNodeChildren",
            "component": "div",
            "props": {
                "className": "pl-4 py-2 flex flex-col gap-4"
            },
            "children": {
                "path": "children",
                "componentId": "subItemRow"
            }
        },
        {
            "id": "subItemRow",
            "component": "div",
            "props": {
                "className": "flex items-center justify-between p-3 bg-surface-variant rounded-lg"
            },
            "children": [
                "subItemInfo",
                "subItemCheck"
            ]
        },
        {
            "id": "subItemInfo",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "subItemLabel",
                "subItemDesc"
            ]
        },
        {
            "id": "subItemLabel",
            "component": "span",
            "props": {
                "className": "text-sm font-medium",
                "value": {
                    "path": "label"
                }
            }
        },
        {
            "id": "subItemDesc",
            "component": "span",
            "props": {
                "className": "text-xs text-on-surface-variant",
                "value": {
                    "path": "description"
                }
            }
        },
        {
            "id": "subItemCheck",
            "component": "CheckboxGroup",
            "props": {
                "value": {
                    "path": "isChecked"
                },
                "options": [
                    {
                        "label": "Enabled",
                        "value": "view"
                    }
                ]
            }
        },
        {
            "id": "permissionFooter",
            "component": "div",
            "props": {
                "className": "p-6 bg-surface-container-highest border-t border-divider flex items-center justify-between"
            },
            "children": [
                "inheritanceAlert",
                "footerActions"
            ]
        },
        {
            "id": "inheritanceAlert",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2 text-warning"
            },
            "children": [
                "alertIcon",
                "alertText"
            ]
        },
        {
            "id": "alertIcon",
            "component": "Icon",
            "props": {
                "name": "info",
                "className": "w-4 h-4"
            }
        },
        {
            "id": "alertText",
            "component": "span",
            "props": {
                "className": "text-xs font-medium",
                "value": {
                    "path": "/inheritanceNotice"
                }
            }
        },
        {
            "id": "footerActions",
            "component": "div",
            "props": {
                "className": "flex items-center gap-3"
            },
            "children": [
                "resetBtn",
                "saveBtn"
            ]
        },
        {
            "id": "resetBtn",
            "component": "Button",
            "props": {
                "value": "Reset Changes",
                "className": "px-6"
            }
        },
        {
            "id": "saveBtn",
            "component": "Button",
            "props": {
                "value": "Save Permissions",
                "color": "primary",
                "className": "px-8"
            }
        }
    ]
}