            }
        },
        {
            "id": "categoryFilter",
            "component": "Select",
            "props": {
                "value": {
                    "path": "/filterState/category"
                },
                "options": {
                    "path": "/categories"
                },
                "className": "w-40"
            }
        },
        {
            "id": "activeSwitch",
            "component": "div",
            "props": {
