            ]
        },
        {
            "id": "switchLabel",
            "component": "span",
            "props": {
                "value": "仅显示活跃",
                "className": "text-sm text-on-surface-variant"
            }
        },
        {
            "id": "switchComp",
            "component": "Switch",
