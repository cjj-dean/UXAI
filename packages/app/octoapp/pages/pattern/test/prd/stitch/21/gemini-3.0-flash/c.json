            },
            "children": [
                "catalogTable"
            ]
        },
        {
            "id": "catalogTable",
            "component": "Table",
            "props": {
                "rowKey": "id",
                "dataSource": {
                    "path": "/productList"
                },
                "columns": [
                    {
                        "title": "产品信息/SKU",
                        "dataIndex": "productName"
                    },
                    {
                        "title": "分类",
                        "dataIndex": "category",
                        "width": 100
                    },
                    {
                        "title": "单价/利润率",
                        "dataIndex": "price",
                        "width": 150
                    },
                    {
                        "title": "库存水位",
                        "dataIndex": "stockLevel",
                        "width": 180
                    },
                    {
                        "title": "状态",
                        "dataIndex": "status",
                        "width": 100
                    },
                    {
                        "title": "操作",
                        "dataIndex": "action",
                        "width": 80,
                        "fixed": "end"
                    }
                ]
            },
            "children": {
                "path": "/productList",
                "componentId": "catalogRow"
            }
        },
        {
            "id": "catalogRow",
            "component": "TableRow",
            "children": [
                "productCell",
                "categoryCell",
                "financialCell",
                "stockCell",
                "statusCell",
                "actionCell"
            ]
        },
        {
            "id": "productCell",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "prodName",
                "prodSku"
            ]
        },
        {
            "id": "prodName",
            "component": "span",
            "props": {
                "value": {
                    "path": "productName"
                },
                "className": "font-medium text-on-surface"
            }
        },
        {
            "id": "prodSku",
            "component": "span",
            "props": {
                "value": {
                    "path": "id"
                },
                "className": "text-xs text-on-surface-variant"
            }
        },
        {
            "id": "categoryCell",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "category"
                },
                "variant": "outlined"
            }
        },
        {
            "id": "financialCell",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "prodPrice",
                "prodMargin"
            ]
        },
        {
            "id": "prodPrice",
            "component": "span",
            "props": {
                "value": {
                    "path": "price"
                },
                "className": "font-semibold"
            }
        },
        {
            "id": "prodMargin",
            "component": "span",
            "props": {
                "value": {
                    "path": "margin"
                },
                "className": "text-xs text-success font-medium"
            }
        },
        {
            "id": "stockCell",
            "component": "div",
            "props": {
                "className": "flex flex-col gap-1 pr-4"
            },
            "children": [
                "stockProgress",
                "stockLabel"
            ]
        },
        {
            "id": "stockProgress",
            "component": "Progress",
            "props": {
                "percent": {
                    "path": "stockLevel"
                },
                "size": "small",
                "showInfo": false,
                "status": {
                    "path": "stockStatus"
                }
            }
        },
        {
            "id": "stockLabel",
            "component": "span",
            "props": {
                "value": {
                    "path": "stockLevel"
                },
                "className": "text-[10px] text-on-surface-variant text-right"
            }
        },
        {
            "id": "statusCell",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "status"
                },
                "color": {
                    "path": "statusType"
                }
            }
        },
        {
            "id": "actionCell",
            "component": "Button",
            "props": {
                "icon": "more-horizontal",
                "size": "small"
            }
        }
    ]
}