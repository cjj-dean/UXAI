        {
            "id": "stockTable",
            "component": "Table",
            "props": {
                "rowKey": "id",
                "dataSource": {
                    "path": "/stockItems"
                },
                "columns": [
                    {
                        "title": "物料信息",
                        "dataIndex": "material"
                    },
                    {
                        "title": "SKU编号",
                        "dataIndex": "skuCode"
                    },
                    {
                        "title": "仓库位置",
                        "dataIndex": "location"
                    },
                    {
                        "title": "当前库存水位",
