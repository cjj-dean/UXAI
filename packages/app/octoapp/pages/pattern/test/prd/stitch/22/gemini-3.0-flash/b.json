                    },
                    {
                        "title": "批次有效期",
                        "dataIndex": "expiry"
                    },
                    {
                        "title": "24h变动",
                        "dataIndex": "change"
                    },
                    {
                        "title": "状态",
                        "dataIndex": "status",
                        "width": 100
                    },
                    {
                        "title": "操作",
                        "dataIndex": "action",
                        "width": 200,
                        "fixed": "end"
                    }
