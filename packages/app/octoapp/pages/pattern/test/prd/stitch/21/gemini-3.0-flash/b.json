                "placeholder": "搜索产品名称或SKU编码...",
                "prefix": "search",
                "className": "w-64"
            }
        },
        {
            "id": "filterCategory",
            "component": "Select",
            "props": {
                "value": {
                    "path": "/filterValues/category"
                },
                "options": {
                    "path": "/categories"
                },
                "className": "w-40"
            }
        },
        {
            "id": "filterPriceRange",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": [
