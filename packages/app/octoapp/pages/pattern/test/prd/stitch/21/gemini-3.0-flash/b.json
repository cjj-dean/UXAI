            }
        },
        {
            "id": "priceDivider",
            "component": "span",
            "props": {
                "value": "-",
                "className": "text-on-surface-variant"
            }
        },
        {
            "id": "priceMax",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/filterValues/maxPrice"
                },
                "placeholder": "Max",
                "className": "w-20"
            }
        },
        {
            "id": "filterSwitch",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": [
                "switchLabel",
                "saleSwitch"
            ]
        },
        {
            "id": "switchLabel",
            "component": "span",
            "props": {
                "value": "仅看上架",
                "className": "text-sm text-on-surface"
            }
        },
        {
            "id": "saleSwitch",
            "component": "Switch",
            "props": {
                "value": {
                    "path": "/filterValues/onlyOnSale"
                },
                "size": "small"
            }
        },
        {
            "id": "tableContainer",
            "component": "div",
            "props": {
                "className": "bg-surface-container-highest rounded-container shadow-card overflow-hidden"
            },
            "children": [
                "productTable"
            ]
        },
        {
            "id": "productTable",
            "component": "Table",
            "props": {
                "rowKey": "id",
                "dataSource": {
                    "path": "/products"
                },
                "columns": [
                    {
                        "title": "产品信息",
                        "dataIndex": "productName"
                    },
                    {
                        "title": "单价",
                        "dataIndex": "unitPrice",
                        "width": 100
                    },
                    {
                        "title": "利润率",
                        "dataIndex": "margin",
                        "width": 80
                    },
                    {
                        "title": "库存水位",
                        "dataIndex": "stockValue",
                        "width": 150
                    },
                    {
                        "title": "状态",
                        "dataIndex": "statusText",
                        "width": 100
                    },
                    {
                        "title": "更新时间",
                        "dataIndex": "updateTime",
                        "width": 160
                    },
                    {
                        "title": "操作",
                        "dataIndex": "actions",
                        "width": 100
                    }
                ]
            },
            "children": {
                "path": "/products",
                "componentId": "productTableRow"
            }
        },
        {
            "id": "productTableRow",
            "component": "TableRow",
            "children": [
                "cellProductInfo",
                "cellUnitPrice",
                "cellMargin",
                "cellStock",
                "cellStatus",
                "cellUpdateTime",
                "cellActions"
            ]
        },
        {
            "id": "cellProductInfo",
            "component": "div",
            "props": {
                "className": "flex items-center gap-3"
            },
