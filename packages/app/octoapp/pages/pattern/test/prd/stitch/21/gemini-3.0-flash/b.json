                "className": "w-4 h-4",
                "color": {
                    "path": "statusType"
                }
            }
        },
        {
            "id": "filterPanel",
            "component": "div",
            "props": {
                "className": "bg-surface-container-highest p-gutter rounded-container shadow-card mb-gutter flex flex-wrap items-center gap-gutter"
            },
            "children": [
                "filterSearch",
                "filterCategory",
                "filterPriceRange",
                "filterSwitch"
            ]
        },
        {
            "id": "filterSearch",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/filterValues/search"
