                "cellProductText"
            ]
        },
        {
            "id": "cellProductImg",
            "component": "img",
            "props": {
                "src": {
                    "path": "productImage"
                },
                "className": "w-10 h-10 rounded-md object-cover border border-divider"
            }
        },
        {
            "id": "cellProductText",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "cellProductName",
                "cellProductSku"
            ]
        },
        {
            "id": "cellProductName",
            "component": "span",
            "props": {
                "className": "text-sm font-medium text-on-surface",
                "value": {
                    "path": "productName"
                }
            }
        },
        {
            "id": "cellProductSku",
            "component": "span",
            "props": {
                "className": "text-xs text-on-surface-variant",
                "value": {
                    "path": "id"
                }
            }
        },
        {
            "id": "cellUnitPrice",
            "component": "span",
            "props": {
                "className": "text-sm font-semibold",
                "value": {
                    "path": "unitPrice"
                }
            }
        },
        {
            "id": "cellMargin",
            "component": "span",
            "props": {
                "className": "text-sm text-success font-medium",
                "value": {
                    "path": "margin"
                }
            }
        },
        {
            "id": "cellStock",
            "component": "Progress",
            "props": {
                "percent": {
                    "path": "stockValue"
                },
                "status": {
                    "path": "stockStatus"
                },
                "size": "small",
                "showInfo": false
            }
        },
        {
            "id": "cellStatus",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": [
