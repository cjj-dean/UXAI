                "cellStatusText"
            ]
        },
        {
            "id": "cellStatusDot",
            "component": "div",
            "props": {
                "className": {
                    "path": "statusColor",
                    "map": {
                        "success": "bg-success",
                        "error": "bg-error",
                        "warning": "bg-warning",
                        "default": "bg-on-surface-variant"
                    }
                }
            }
        },
        {
            "id": "cellStatusText",
            "component": "span",
            "props": {
                "className": "text-sm",
                "value": {
                    "path": "statusText"
                }
            }
        },
        {
            "id": "cellUpdateTime",
            "component": "span",
            "props": {
                "className": "text-xs text-on-surface-variant",
                "value": {
                    "path": "updateTime"
                }
            }
        },
        {
            "id": "cellActions",
            "component": "Button",
            "props": {
                "value": "编辑",
                "size": "small",
                "className": "text-primary"
