                "kpiTag"
            ]
        },
        {
            "id": "kpiTitle",
            "component": "span",
            "props": {
                "className": "text-sm text-on-surface-variant",
                "value": {
                    "path": "title"
                }
            }
        },
        {
            "id": "kpiTag",
            "component": "Tag",
            "props": {
