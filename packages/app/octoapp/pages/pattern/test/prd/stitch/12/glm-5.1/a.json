            "component": "div",
            "props": {
                "className": "bg-surface-container-highest rounded-xl shadow-card overflow-hidden"
            },
            "children": [
                "contractTabs"
            ]
        },
        {
            "id": "contractTabs",
            "component": "Tabs",
            "props": {
                "activeKey": {
                    "path": "/activeTab"
                }
            },
            "children": {
                "path": "/tabOptions",
                "componentId": "contractTabItem"
            }
        },
        {
            "id": "contractTabItem",
            "component": "TabItem",
            "props": {
                "key": {
                    "path": "key"
                },
                "label": {
                    "path": "tabLabel"
                },
                "content": {
                    "componentId": "contractTableContent"
                }
            }
        },
        {
            "id": "contractTableContent",
            "component": "div",
            "props": {
                "className": "p-5 pt-0"
            },
            "children": [
                "contractTable"
            ]
        },
        {
            "id": "contractTable",
            "component": "Table",
            "props": {
                "rowKey": "contractId",
                "dataSource": {
                    "path": "/contractList"
                },
                "columns": [
                    {
                        "title": "合同名称",
                        "dataIndex": "contractName",
                        "minWidth": 240
                    },
                    {
                        "title": "客户",
                        "dataIndex": "clientName",
                        "minWidth": 160
                    },
                    {
                        "title": "金额",
                        "dataIndex": "amount",
                        "align": "right",
                        "width": 140
                    },
                    {
                        "title": "状态",
                        "dataIndex": "statusTag",
                        "width": 100
                    },
                    {
                        "title": "日期",
                        "dataIndex": "updatedAt",
                        "width": 120
                    },
                    {
                        "title": "操作",
                        "dataIndex": "actions",
                        "width": 80,
                        "align": "center"
                    }
                ],
                "className": "mb-4"
            },
            "children": {
                "path": "/contractList",
                "componentId": "contractRow"
            }
        },
        {
            "id": "contractRow",
            "component": "TableRow",
            "children": [
                "contractNameCell",
                "tableClientCell",
                "tableAmountCell",
                "tableStatusCell",
                "tableDateCell",
                "tableActionCell"
            ]
        },
        {
            "id": "contractNameCell",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "contractNameText",
                "contractIdText"
            ]
        },
        {
            "id": "contractNameText",
            "component": "span",
            "props": {
                "value": {
                    "path": "contractName"
                },
                "className": "text-sm font-medium text-on-surface"
            }
        },
        {
            "id": "contractIdText",
            "component": "span",
            "props": {
                "value": {
                    "path": "contractId"
                },
                "className": "text-xs text-on-surface-variant mt-0.5"
            }
        },
        {
            "id": "tableClientCell",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": [
                "tableClientAvatar",
                "tableClientName"
            ]
        },
        {
            "id": "tableClientAvatar",
            "component": "img",
            "props": {
                "src": {
                    "path": "clientAvatarImage"
                },
                "className": "w-8 h-8 rounded-full object-cover"
            }
        },
        {
            "id": "tableClientName",
            "component": "span",
            "props": {
                "value": {
                    "path": "clientName"
                },
                "className": "text-sm text-on-surface"
            }
        },
        {
            "id": "tableAmountCell",
            "component": "span",
            "props": {
                "value": {
                    "path": "amount"
                },
                "className": "text-sm font-medium text-on-surface"
            }
        },
        {
            "id": "tableStatusCell",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "statusTag"
                },
                "color": {
                    "path": "statusType"
                }
            }
        },
        {
            "id": "tableDateCell",
            "component": "span",
            "props": {
                "value": {
                    "path": "updatedAt"
                },
                "className": "text-sm text-on-surface-variant"
            }
        },
        {
            "id": "tableActionCell",
            "component": "Dropdown",
            "props": {
                "menu": {
                    "path": "actionMenuItems"
                },
                "trigger": [
                    "click"
                ],
                "placement": "bottomRight"
            },
            "children": [
                "tableActionTrigger"
            ]
        },
        {
            "id": "tableActionTrigger",
            "component": "Button",
            "props": {
                "icon": "more-horizontal",
                "size": "small"
            }
        },
        {
            "id": "fabButton",
            "component": "Button",
            "props": {
                "icon": {
                    "path": "/fabAction/actionIcon"
                },
                "shape": "circle",
                "color": "primary",
                "size": "large",
                "className": "fixed bottom-6 right-6 z-50 shadow-lg"
            }
        }
    ]
}