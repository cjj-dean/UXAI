        {
            "id": "stockTable",
            "component": "Table",
            "props": {
                "rowKey": "skuCode",
                "dataSource": {
                    "path": "/stockData"
                },
                "columns": [
                    {
                        "title": "物料编码",
                        "dataIndex": "skuCode",
                        "width": 100
                    },
                    {
                        "title": "物料名称",
                        "dataIndex": "skuName",
                        "minWidth": 150
                    },
                    {
                        "title": "规格型号",
                        "dataIndex": "spec"
                    },
                    {
                        "title": "当前库存",
                        "dataIndex": "current",
