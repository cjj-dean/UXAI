        {
            "id": "editIconBtn",
            "component": "Button",
            "props": {
                "icon": "edit-3",
                "size": "small",
                "shape": "circle"
            }
        },
        {
            "id": "copyIconBtn",
            "component": "Button",
            "props": {
                "icon": "copy",
                "size": "small",
                "shape": "circle"
            }
        },
        {
            "id": "roleDescriptionText",
            "component": "p",
            "props": {
                "value": {
                    "path": "/selectedRole/description"
                },
                "className": "text-sm text-on-surface-variant max-w-2xl"
            }
        },
        {
            "id": "roleDetailTabs",
            "component": "div",
            "props": {
                "className": "px-inset flex-1"
            },
            "children": [
                "permissionTabs"
            ]
        },
        {
            "id": "permissionTabs",
            "component": "Tabs",
            "props": {
                "activeKey": {
                    "path": "/selectedRole/activeTab"
                }
            },
            "children": [
                "tabMenuAccess",
                "tabActions",
                "tabDataScope"
            ]
        },
        {
            "id": "tabMenuAccess",
            "component": "TabItem",
            "props": {
                "key": "menu-access",
                "label": "Menu Access",
                "icon": "layout",
                "content": {
                    "componentId": "permissionTreeContainer"
                }
            }
        },
        {
            "id": "tabActions",
            "component": "TabItem",
            "props": {
                "key": "actions",
                "label": "Actions & Buttons",
                "icon": "mouse-pointer-2",
                "content": "Action permissions configuration panel."
            }
        },
        {
            "id": "tabDataScope",
            "component": "TabItem",
            "props": {
                "key": "data-scope",
                "label": "Data Scope",
                "icon": "database",
                "content": "Data scope and row-level security settings."
            }
        },
        {
            "id": "permissionTreeContainer",
            "component": "div",
            "props": {
                "className": "py-4 flex flex-col gap-2"
            },
            "children": {
                "path": "/selectedRole/permissionTree",
                "componentId": "treeNodeItem"
            }
        },
        {
            "id": "treeNodeItem",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "treeNodeHeader",
                "treeNodeChildren"
            ]
        },
        {
            "id": "treeNodeHeader",
            "component": "div",
            "props": {
                "className": "flex items-center gap-3 p-2 hover:bg-surface-variant rounded-md"
            },
            "children": [
                "treeExpandIcon",
                "treeNodeTitle",
                "treeNodeSwitch"
            ]
        },
        {
            "id": "treeExpandIcon",
            "component": "Icon",
            "props": {
                "name": "chevron-down",
                "className": "w-4 h-4 text-on-surface-variant"
            }
        },
        {
            "id": "treeNodeTitle",
            "component": "span",
            "props": {
                "value": {
                    "path": "title"
                },
                "className": "text-sm font-medium flex-1"
            }
        },
        {
            "id": "treeNodeSwitch",
            "component": "Switch",
            "props": {
                "value": {
                    "path": "isEnabled"
                },
                "size": "small"
            }
        },
        {
            "id": "treeNodeChildren",
            "component": "div",
            "props": {
                "className": "ml-8 flex flex-col gap-1 border-l border-divider pl-4 mt-1"
            },
            "children": {
                "path": "children",
                "componentId": "treeLeafItem"
            }
        },
        {
            "id": "treeLeafItem",
            "component": "div",
            "props": {
                "className": "flex items-center justify-between p-2"
            },
            "children": [
                "treeLeafLabel",
                "treeLeafCheck"
            ]
        },
        {
            "id": "treeLeafLabel",
            "component": "span",
            "props": {
                "value": {
                    "path": "title"
                },
                "className": "text-sm text-on-surface-variant"
            }
        },
        {
            "id": "treeLeafCheck",
            "component": "CheckboxGroup",
            "props": {
                "value": [
                    "checked"
                ],
                "options": [
                    {
                        "label": "",
                        "value": "checked"
                    }
                ]
            }
        },
        {
            "id": "roleDetailFooter",
            "component": "div",
            "props": {
                "className": "p-inset border-t border-divider bg-surface-container-low"
            },
            "children": [
                "inheritanceAlert",
                "footerActionRow"
            ]
        },
        {
            "id": "inheritanceAlert",
            "component": "div",
            "props": {
                "className": "bg-info-container p-4 rounded-container flex gap-3 mb-6"
            },
            "children": [
                "infoIcon",
                "infoContent"
            ]
        },
        {
            "id": "infoIcon",
            "component": "Icon",
            "props": {
                "name": "info",
                "color": "info",
                "shape": "circle",
                "className": "w-5 h-5"
            }
        },
        {
            "id": "infoContent",
            "component": "div",
            "props": {
                "className": "flex flex-col"
            },
            "children": [
                "infoTitle",
                "infoDesc"
            ]
        },
        {
            "id": "infoTitle",
            "component": "span",
            "props": {
                "value": {
                    "path": "/inheritanceNote/title"
                },
                "className": "text-sm font-bold text-on-info-container"
            }
        },
        {
            "id": "infoDesc",
            "component": "span",
            "props": {
                "value": {
                    "path": "/inheritanceNote/description"
                },
                "className": "text-xs text-on-info-container"
            }
        },
        {
            "id": "footerActionRow",
            "component": "div",
            "props": {
                "className": "flex justify-end gap-3"
            },
            "children": [
                "resetBtn",
                "saveBtn"
            ]
        },
        {
            "id": "resetBtn",
            "component": "Button",
            "props": {
                "value": "Reset to Defaults",
                "className": "text-on-surface-variant"
            }
        },
        {
            "id": "saveBtn",
            "component": "Button",
            "props": {
                "value": "Save Changes",
                "color": "primary"
            }
        }
    ]
}