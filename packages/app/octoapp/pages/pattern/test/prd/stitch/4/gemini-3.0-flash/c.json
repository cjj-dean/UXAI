            "children": [
                "roleCardName",
                "roleCardDesc"
            ]
        },
        {
            "id": "roleCardName",
            "component": "span",
            "props": {
                "value": {
                    "path": "roleName"
                },
                "className": "text-sm font-bold text-on-surface block"
            }
        },
        {
            "id": "roleCardDesc",
            "component": "span",
            "props": {
                "value": {
                    "path": "description"
