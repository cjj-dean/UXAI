        {
            "id": "userName",
            "component": "span",
            "props": {
                "value": {
                    "path": "/currentUser/userName"
                },
                "className": "text-sm font-semibold truncate"
            }
        },
        {
            "id": "userEmail",
            "component": "span",
            "props": {
                "value": {
                    "path": "/currentUser/userEmail"
                },
                "className": "text-xs text-on-surface-variant truncate"
            }
        },
