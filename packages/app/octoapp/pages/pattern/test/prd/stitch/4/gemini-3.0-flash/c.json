        {
            "id": "sidebarNav",
            "component": "div",
            "props": {
                "className": "w-64 bg-surface-container-highest flex flex-col border-r border-divider"
            },
            "children": [
                "sidebarBrand",
                "sidebarMenu",
                "sidebarUser"
            ]
        },
        {
            "id": "sidebarBrand",
            "component": "div",
            "props": {
                "className": "p-inset flex items-center gap-2"
            },
            "children": [
                "brandIcon",
                "brandText"
            ]
        },
        {
            "id": "brandIcon",
            "component": "Icon",
            "props": {
                "name": "shield",
                "color": "primary",
                "shape": "square",
                "className": "w-8 h-8"
            }
        },
        {
            "id": "brandText",
            "component": "span",
            "props": {
                "value": {
                    "path": "/brandTitle"
                },
                "className": "text-sm font-bold text-on-surface leading-tight"
            }
        },
        {
            "id": "sidebarMenu",
            "component": "div",
            "props": {
                "className": "flex-1 px-4 py-2 flex flex-col gap-1"
            },
            "children": {
                "path": "/navItems",
                "componentId": "navItemRow"
            }
        },
        {
            "id": "navItemRow",
            "component": "div",
            "props": {
                "className": "flex items-center gap-3 p-3 rounded-action cursor-pointer transition-colors hover:bg-surface-variant"
            },
            "children": [
                "navItemIcon",
                "navItemLabel"
            ]
        },
        {
            "id": "navItemIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "icon"
                },
                "className": "w-5 h-5",
                "color": "default"
            }
        },
        {
            "id": "navItemLabel",
            "component": "span",
            "props": {
                "value": {
                    "path": "label"
                },
                "className": "text-md text-on-surface-variant"
            }
        },
        {
            "id": "sidebarUser",
            "component": "div",
            "props": {
                "className": "p-4 border-t border-divider"
            },
            "children": [
                "userProfileCard"
            ]
        },
        {
            "id": "userProfileCard",
            "component": "div",
            "props": {
                "className": "flex items-center gap-3"
            },
            "children": [
                "userAvatar",
                "userInfoText"
            ]
        },
        {
            "id": "userAvatar",
            "component": "img",
            "props": {
                "src": {
                    "path": "/currentUser/avatarImage"
                },
                "className": "w-10 h-10 rounded-full border border-divider"
            }
        },
        {
            "id": "userInfoText",
            "component": "div",
            "props": {
                "className": "flex flex-col min-w-0"
            },
            "children": [
                "userName",
                "userEmail"
            ]
