                "className": "text-2xl font-bold text-on-surface"
            }
        },
        {
            "id": "roleDetailTag",
            "component": "Tag",
            "props": {
                "value": {
                    "path": "/selectedRole/tag"
                },
                "color": "primary",
                "variant": "filled"
            }
        },
        {
            "id": "roleEditActions",
            "component": "div",
