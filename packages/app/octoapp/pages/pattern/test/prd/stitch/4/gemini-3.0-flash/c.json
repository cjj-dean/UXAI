        {
            "id": "headerRightActions",
            "component": "div",
            "props": {
                "className": "flex items-center gap-4"
            },
            "children": [
                "headerSearch",
                "headerIconBtns"
            ]
        },
        {
            "id": "headerSearch",
            "component": "Input",
            "props": {
                "value": "",
                "placeholder": {
                    "path": "/searchPlaceholder"
                },
                "prefix": "search",
                "className": "w-64"
            }
        },
        {
            "id": "headerIconBtns",
            "component": "div",
            "props": {
                "className": "flex items-center gap-2"
            },
            "children": {
                "path": "/headerActions",
                "componentId": "headerActionBtn"
            }
        },
        {
            "id": "headerActionBtn",
            "component": "Button",
            "props": {
                "icon": {
                    "path": "icon"
                },
                "className": "hover:bg-surface-variant",
                "shape": "circle"
            }
        },
        {
            "id": "mainWorkspace",
            "component": "div",
            "props": {
                "className": "flex-1 flex overflow-hidden"
            },
            "children": [
                "roleListColumn",
                "roleDetailColumn"
            ]
        },
        {
            "id": "roleListColumn",
            "component": "div",
            "props": {
                "className": "w-80 bg-surface-container-low border-r border-divider flex flex-col"
