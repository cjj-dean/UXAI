            "children": [
                "roleListHeader",
                "roleListScroll"
            ]
        },
        {
            "id": "roleListHeader",
            "component": "div",
            "props": {
                "className": "p-4 flex flex-col gap-3"
            },
            "children": [
                "addRoleBtn",
                "roleSearchInput"
            ]
        },
        {
            "id": "addRoleBtn",
            "component": "Button",
            "props": {
                "value": {
                    "path": "/addBtnText"
                },
                "color": "primary",
                "className": "w-full"
            }
        },
        {
            "id": "roleSearchInput",
            "component": "Input",
            "props": {
                "value": "",
                "placeholder": {
                    "path": "/roleSearchPlaceholder"
                },
                "prefix": "filter",
                "size": "small"
            }
        },
        {
            "id": "roleListScroll",
            "component": "div",
            "props": {
                "className": "flex-1 overflow-y-auto p-4 flex flex-col gap-3"
