            "children": {
                "path": "/roles",
                "componentId": "roleCard"
            }
        },
        {
            "id": "roleCard",
            "component": "div",
            "props": {
                "className": "p-3 rounded-container bg-surface-container-highest shadow-sm border border-divider hover:border-primary cursor-pointer transition-all"
