                "librarySearch"
            ]
        },
        {
            "id": "libraryTitle",
            "component": "span",
            "props": {
                "value": "组件库",
                "className": "font-bold text-on-surface"
            }
        },
        {
            "id": "librarySearch",
            "component": "Icon",
            "props": {
                "name": "search",
                "className": "w-4 h-4 text-on-surface-variant"
            }
        },
        {
            "id": "libraryCollapse",
            "component": "Collapse",
            "props": {
                "activeKey": "cat_triggers",
                "className": "flex-1 overflow-y-auto"
            },
            "children": {
                "path": "/compCategories",
                "componentId": "libraryCatItem"
            }
        },
        {
            "id": "libraryCatItem",
            "component": "CollapseItem",
            "props": {
                "key": {
                    "path": "id"
                },
                "label": {
                    "path": "name"
                },
                "content": {
                    "componentId": "libraryGrid"
                }
            }
        },
        {
            "id": "libraryGrid",
            "component": "div",
            "props": {
                "className": "grid grid-cols-1 gap-2 p-2 bg-surface-variant"
            },
            "children": {
                "path": "items",
                "componentId": "libraryCard"
            }
        },
        {
            "id": "libraryCard",
            "component": "div",
            "props": {
                "className": "p-3 bg-surface-container-highest rounded-lg shadow-sm border border-transparent hover:border-primary cursor-move flex items-center gap-3"
            },
            "children": [
                "libCardIcon",
                "libCardText"
            ]
        },
        {
            "id": "libCardIcon",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "icon"
                },
                "shape": "outline",
                "className": "w-5 h-5 text-primary"
            }
        },
        {
            "id": "libCardText",
            "component": "div",
            "props": {
