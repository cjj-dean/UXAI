            "children": {
                "path": "/navItems",
                "componentId": "sidebarMenuItem"
            }
        },
        {
            "id": "sidebarMenuItem",
            "component": "Icon",
            "props": {
                "name": {
                    "path": "icon"
                },
                "color": "default",
                "className": "w-6 h-6 cursor-pointer hover:text-primary transition-colors"
            }
        },
        {
            "id": "sidebarAvatar",
            "component": "img",
            "props": {
                "src": "https://randomuser.me/api/portraits/men/32.jpg",
                "className": "w-8 h-8 rounded-full border border-divider"
            }
        },
        {
            "id": "editorArea",
            "component": "div",
            "props": {
                "className": "flex-1 flex overflow-hidden relative"
            },
            "children": [
                "compLibrary",
                "canvasWorkplace"
            ]
        },
        {
            "id": "compLibrary",
            "component": "div",
            "props": {
