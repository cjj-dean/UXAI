            "id": "libCardName",
            "component": "span",
            "props": {
                "value": {
                    "path": "name"
                },
                "className": "text-sm font-medium"
            }
        },
        {
            "id": "libCardDesc",
            "component": "span",
            "props": {
                "value": {
                    "path": "desc"
                },
                "className": "text-xs text-on-surface-variant truncate w-32"
            }
        },
        {
            "id": "canvasWorkplace",
            "component": "div",
