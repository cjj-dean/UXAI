    "rootId": "mainLayout",
    "elements": [
        {
            "id": "mainLayout",
            "component": "div",
            "props": {
                "className": "flex h-screen w-full bg-surface-container-lowest overflow-hidden"
            },
            "children": [
                "sidebarNav",
                "editorArea",
                "configDrawer"
            ]
        },
        {
            "id": "sidebarNav",
            "component": "div",
            "props": {
                "className": "w-16 flex flex-col items-center py-6 bg-surface-container-highest shadow-sm z-20"
            },
            "children": [
                "sidebarLogo",
