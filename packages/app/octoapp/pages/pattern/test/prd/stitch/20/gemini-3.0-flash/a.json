            "children": [
                "labelTitle",
                "inputTitle"
            ]
        },
        {
            "id": "labelTitle",
            "component": "span",
            "props": {
                "value": "通知标题",
                "className": "text-sm font-medium text-on-surface-variant"
            }
        },
        {
            "id": "inputTitle",
            "component": "Input",
            "props": {
                "value": {
                    "path": "/configForm/title"
                },
                "suffix": "braces",
                "placeholder": "请输入标题，支持 {{变量}}"
            }
        },
        {
            "id": "fieldTemplate",
            "component": "div",
            "props": {
                "className": "flex flex-col gap-2"
            },
            "children": [
                "labelTemplate",
                "selectTemplate"
            ]
        },
        {
            "id": "labelTemplate",
            "component": "span",
            "props": {
                "value": "选择通知模板",
                "className": "text-sm font-medium text-on-surface-variant"
            }
        },
        {
            "id": "selectTemplate",
            "component": "Select",
            "props": {
                "value": {
                    "path": "/configForm/template"
                },
                "options": [
                    {
                        "label": "紧急线索提醒模板",
                        "value": "tpl_001"
                    },
                    {
                        "label": "常规周报模板",
                        "value": "tpl_002"
                    }
                ]
            }
        },
        {
            "id": "fieldReceivers",
            "component": "div",
            "props": {
                "className": "flex flex-col gap-2"
            },
            "children": [
                "labelReceivers",
                "selectReceivers"
            ]
        },
        {
            "id": "labelReceivers",
            "component": "span",
            "props": {
                "value": "添加接收者",
                "className": "text-sm font-medium text-on-surface-variant"
            }
        },
        {
            "id": "selectReceivers",
            "component": "Select",
            "props": {
                "value": {
                    "path": "/configForm/receivers"
                },
                "mode": "multiple",
                "options": [
                    {
                        "label": "张经理 (销售部)",
                        "value": "user_1"
                    },
                    {
                        "label": "李总监 (市场部)",
                        "value": "user_2"
                    },
                    {
                        "label": "王组长 (电销组)",
                        "value": "user_3"
                    }
                ]
            }
        },
        {
            "id": "drawerFooter",
            "component": "div",
            "props": {
                "className": "p-4 border-t border-divider flex gap-3"
            },
            "children": [
