                "sidebarAvatar"
            ]
        },
        {
            "id": "sidebarLogo",
            "component": "Icon",
            "props": {
                "name": "workflow",
                "color": "primary",
                "shape": "square",
                "className": "w-8 h-8 mb-8"
            }
        },
        {
            "id": "sidebarMenu",
            "component": "div",
            "props": {
                "className": "flex-1 flex flex-col gap-6"
