                "btnApply"
            ]
        },
        {
            "id": "btnReset",
            "component": "Button",
            "props": {
                "value": "重置",
                "icon": "rotate-ccw",
                "className": "flex-1"
            }
        },
        {
            "id": "btnApply",
            "component": "Button",
            "props": {
                "value": "应用配置",
                "color": "primary",
                "icon": "check",
                "className": "flex-1"
            }
        }
